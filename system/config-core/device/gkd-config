#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
SCHEMA=${GKD_CONFIG_SCHEMA:-/usr/share/gkd-mini/gdkmini.schema}
MERGER=${GKD_CONFIG_MERGER:-/usr/libexec/gkd-mini/gkd-config-merge.awk}
OVERRIDE_CONFIG=${GKD_CONFIG_OVERRIDE:-/usr/local/etc/gkd-mini/gdkmini.override.conf}
RUN_DIR=${GKD_CONFIG_RUN_DIR:-/run/gkd-config}
STATE_DIR=${GKD_CONFIG_STATE_DIR:-/usr/local/var/lib/gkd-config}
GEN_ROOT=$RUN_DIR/generations
STATE_GEN_ROOT=$STATE_DIR/generations
CURRENT=$RUN_DIR/current
STATE_CURRENT=$STATE_DIR/current
ERROR_FILE=$STATE_DIR/last-error
RESULT_FILE=$STATE_DIR/last-result

say_error()
{
	printf '%s\n' "$*" >&2
}

atomic_text()
{
	content=$1 destination=$2
	directory=${destination%/*}
	mkdir -p "$directory" || return 1
	temporary=$directory/.gkd-config.$$
	printf '%s\n' "$content" >"$temporary" || return 1
	mv -f "$temporary" "$destination"
}

record_result()
{
	result=$1 generation=${2:-none} detail=${3:-none}
	atomic_text "result=$result
generation=$generation
detail=$detail" "$RESULT_FILE"
}

is_uint()
{
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	return 0
}

validate_uint()
{
	is_uint "$1" || return 1
	[ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

validate_enum()
{
	case ",$2," in *",$1,"*) return 0 ;; esac
	return 1
}

validate_uint_list()
{
	printf '%s\n' "$1" | awk -v low="$2" -v high="$3" -v spec="$4" '
	BEGIN { split(spec, bounds, ":") }
	{
		count = split($0, values, ",")
		if (count < bounds[1] || count > bounds[2]) exit 1
		previous = -1
		for (i = 1; i <= count; ++i) {
			if (values[i] !~ /^[0-9]+$/ || values[i] < low || values[i] > high)
				exit 1
			if (i > 1 && values[i] <= previous) exit 1
			previous = values[i]
		}
	}'
}

validate_ipv4()
{
	printf '%s\n' "$1" | awk '
	{
		if (split($0, octets, ".") != 4) exit 1
		for (i = 1; i <= 4; ++i)
			if (octets[i] !~ /^[0-9]+$/ || octets[i] < 0 || octets[i] > 255)
				exit 1
	}'
}

validate_color()
{
	[ "${#1}" -eq 7 ] || return 1
	case "$1" in
		\#*[!0-9A-Fa-f]*) return 1 ;;
		\#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) return 0 ;;
		*) return 1 ;;
	esac
}

validate_value()
{
	value=$1 type=$2 low=$3 high=$4 argument=$5
	case "$type" in
		uint) validate_uint "$value" "$low" "$high" ;;
		enum) validate_enum "$value" "$argument" ;;
		uint_list) validate_uint_list "$value" "$low" "$high" "$argument" ;;
		ipv4) validate_ipv4 "$value" ;;
		color) validate_color "$value" ;;
		keycode) validate_enum "$value" 'KEY_UP,KEY_DOWN,KEY_LEFT,KEY_RIGHT,KEY_LEFTCTRL,KEY_LEFTALT,KEY_SPACE,KEY_LEFTSHIFT,KEY_ENTER,KEY_ESC,KEY_TAB,KEY_BACKSPACE,KEY_PAGEUP,KEY_PAGEDOWN,KEY_KPPLUS,KEY_KPMINUS,KEY_END,KEY_HOME' ;;
		power_keycode) validate_enum "$value" 'KEY_UP,KEY_DOWN,KEY_LEFTCTRL,KEY_LEFTALT,KEY_ENTER,KEY_ESC' ;;
		debug_keycode) validate_enum "$value" 'KEY_LEFTALT,KEY_LEFTCTRL,KEY_UP,KEY_DOWN,KEY_KPPLUS,KEY_KPMINUS' ;;
		hotkey) case "$value" in MENU+L1|L1+R1|L1+L2|L1+R2|R1+L2|R1+R2|L2+R2|NONE) return 0 ;; *) return 1 ;; esac ;;
		path) [ "${value#/}" != "$value" ] && [ -n "$value" ] ;;
		token)
			case "$value" in ''|*[!A-Za-z0-9_.-]*) return 1 ;; esac
			[ "$argument" != interface ] || [ "${#value}" -le 15 ]
			;;
		ui_text)
			# Byte-oriented UTF-8: A ships ASCII and the listed three-byte CJK glyphs.
			printf '%s\n' "$value" | LC_ALL=C awk -v maximum="$high" -v glyphs="$argument" '
			{
			 if (!length($0)) exit 1
			 count=0
			 for (i=1;i<=length($0);) {
			  c=substr($0,i,1)
			  if (c ~ /^[ -~]$/) i++
			  else {
			   c=substr($0,i,3)
			   if (length(c)!=3 || glyphs=="ASCII" || !index(glyphs,c)) exit 1
			   i+=3
			  }
			  if (++count>maximum) exit 1
			 }
			}' ;;
		text) [ -n "$value" ] ;;
		*) return 1 ;;
	esac
}

value_from()
{
	sed -n "s/^$2=//p" "$1"
}

validate_cross_fields()
{
	file=$1
	low=$(value_from "$file" battery_low_percent)
	critical=$(value_from "$file" battery_critical_percent)
	hysteresis=$(value_from "$file" battery_warning_hysteresis_percent)
	[ "$critical" -le "$low" ] || return 1
	[ $((low + hysteresis)) -le 100 ] || return 1
	debug_return=$(value_from "$file" debug_return_key)
	debug_confirm=$(value_from "$file" debug_confirm_key)
	[ "$debug_return" != "$debug_confirm" ] || return 1
	debug_timeout=$(value_from "$file" debug_status_timeout_ms)
	debug_refresh=$(value_from "$file" debug_status_refresh_ms)
	[ "$debug_refresh" -lt "$debug_timeout" ] || return 1
	text_x=$(value_from "$file" ui_status_text_x)
	text_y=$(value_from "$file" ui_status_text_y)
	icon_x=$(value_from "$file" ui_status_icon_x)
	icon_y=$(value_from "$file" ui_status_icon_y)
	icon_w=$(value_from "$file" ui_status_icon_width)
	icon_h=$(value_from "$file" ui_status_icon_height)
	[ "$text_x" -lt 320 ] && [ "$text_y" -lt 240 ] || return 1
	[ $((icon_x + icon_w)) -le 102 ] || return 1
	[ $((icon_y + icon_h)) -le 228 ] || return 1
}

schema_count()
{
	awk -F '|' '$0 !~ /^#/ && $0 != "" { count++ } END { print count + 0 }' "$SCHEMA"
}

validate_candidate()
{
	candidate=$1
	[ "$(wc -l <"$candidate" | tr -d ' ')" = "$(schema_count)" ] || {
		say_error 'GKD_CONFIG_REJECTED reason=key_count'
		return 1
	}
	exec 3<"$SCHEMA"
	while IFS= read -r config_line || [ -n "$config_line" ]; do
		while :; do
			IFS='|' read -r key type default low high argument owner apply <&3 || return 1
			case "$key" in ''|'#'*) continue ;; esac
			break
		done
		config_key=${config_line%%=*}
		value=${config_line#*=}
		[ "$config_line" != "$config_key" ] && [ "$config_key" = "$key" ] || return 1
		validate_value "$value" "$type" "$low" "$high" "$argument" || {
			say_error "GKD_CONFIG_REJECTED reason=invalid_value key=$key"
			return 1
		}
	done <"$candidate"
	validate_cross_fields "$candidate" || {
		say_error 'GKD_CONFIG_REJECTED reason=cross_field'
		return 1
	}
}

write_change_set()
{
	old_file=$1 new_file=$2 output=$3
	awk -F '|' -v old_file="$old_file" -v new_file="$new_file" '
	BEGIN {
		while ((getline line < old_file) > 0) {
			at = index(line, "=")
			if (at) old[substr(line, 1, at - 1)] = substr(line, at + 1)
		}
		while ((getline line < new_file) > 0) {
			at = index(line, "=")
			if (at) current[substr(line, 1, at - 1)] = substr(line, at + 1)
		}
	}
	$0 !~ /^#/ && $0 != "" {
		if (!($1 in old) || old[$1] != current[$1]) print $1 "\t" $7 "\t" $8
	}' "$SCHEMA" >"$output"
}

stage_generation()
{
	candidate=$1 root=$2 hash=$3 old_file=$4
	final=$root/$hash
	if [ -d "$final" ]; then
		[ "$(sha256sum "$final/effective.conf" | awk '{print $1}')" = "$hash" ]
		return
	fi
	temporary=$root/.generation.$$
	[ ! -e "$temporary" ] || return 1
	mkdir -p "$temporary" || return 1
	cp "$candidate" "$temporary/effective.conf" || return 1
	printf '%s\n' "$hash" >"$temporary/generation" || return 1
	write_change_set "$old_file" "$candidate" "$temporary/changes.tsv" || return 1
	changed=$(wc -l <"$temporary/changes.tsv" | tr -d ' ')
	printf 'format=1\ngeneration=%s\nschema_sha256=%s\nchanged_keys=%s\n' \
		"$hash" "$(sha256sum "$SCHEMA" | awk '{print $1}')" "$changed" \
		>"$temporary/manifest" || return 1
	chmod 0444 "$temporary/effective.conf" "$temporary/generation" \
		"$temporary/changes.tsv" "$temporary/manifest" || return 1
	chmod 0555 "$temporary" || return 1
	mv "$temporary" "$final"
}

switch_current()
{
	link=$1 hash=$2
	temporary=${link%/*}/.current.$$
	rm -f "$temporary"
	ln -s "generations/$hash" "$temporary" || return 1
	[ "${GKD_CONFIG_FAILPOINT:-}" != before_switch ] || return 75
	if [ -n "${GKD_CONFIG_RENAME:-}" ]; then
		"$GKD_CONFIG_RENAME" "$temporary" "$link"
	else
		mv -fT "$temporary" "$link"
	fi
}

restore_last_valid()
{
	[ -L "$STATE_CURRENT" ] || return 1
	state_target=$(readlink "$STATE_CURRENT") || return 1
	hash=${state_target##*/}
	state_effective=$STATE_GEN_ROOT/$hash/effective.conf
	[ -s "$state_effective" ] || return 1
	[ "$(sha256sum "$state_effective" | awk '{print $1}')" = "$hash" ] || return 1
	validate_candidate "$state_effective" || return 1
	mkdir -p "$GEN_ROOT" || return 1
	stage_generation "$state_effective" "$GEN_ROOT" "$hash" /dev/null || return 1
	switch_current "$CURRENT" "$hash"
}

commit_generation()
{
	hash=$1
	case "$hash" in ''|*[!0-9a-f]*)
		say_error 'GKD_CONFIG_REJECTED reason=bad_generation'
		return 2
		;; esac
	[ "${#hash}" -eq 64 ] || return 2
	for root in "$GEN_ROOT" "$STATE_GEN_ROOT"; do
		file=$root/$hash/effective.conf
		[ -s "$file" ] || return 2
		[ "$(sha256sum "$file" | awk '{print $1}')" = "$hash" ] || return 2
		validate_candidate "$file" || return 2
	done
	old_hash=
	[ ! -L "$CURRENT" ] || old_hash=$(cat "$CURRENT/generation")
	switch_current "$CURRENT" "$hash" || return $?
	if [ "${GKD_CONFIG_FAILPOINT:-}" = after_run_switch ] || \
		! switch_current "$STATE_CURRENT" "$hash"; then
		if [ -z "$old_hash" ]; then
			rm -f "$CURRENT"
		else
			switch_current "$CURRENT" "$old_hash" || true
		fi
		return 75
	fi
	: >"$ERROR_FILE"
	record_result applied "$hash" none || true
	printf 'GKD_CONFIG_COMMITTED generation=%s changed=%s\n' \
		"$hash" "$(wc -l <"$CURRENT/changes.tsv" | tr -d ' ')"
}

compile_config()
{
	publish=$1
	umask 077
	mkdir -p "$GEN_ROOT" "$STATE_GEN_ROOT" || return 1
	lock=$RUN_DIR/.compile-lock
	if ! mkdir "$lock" 2>/dev/null; then
		say_error 'GKD_CONFIG_BUSY'
		return 3
	fi
	compile_candidate=$RUN_DIR/.candidate.$$
	merge_error=$RUN_DIR/.merge-error.$$
	trap 'rm -f "$compile_candidate" "$merge_error" "$RUN_DIR/.current.$$" "$STATE_DIR/.current.$$"; rmdir "$lock" 2>/dev/null' EXIT INT TERM
	: >"$merge_error"
	awk -v schema_file="$SCHEMA" -v override_file="$OVERRIDE_CONFIG" \
		-f "$MERGER" "$SCHEMA" "$OVERRIDE_CONFIG" >"$compile_candidate" 2>"$merge_error" || {
		[ -L "$CURRENT" ] || restore_last_valid || true
		cp "$merge_error" "$ERROR_FILE" 2>/dev/null || true
		cat "$merge_error" >&2
		record_result failed current merge-or-schema || true
		return 2
	}
	validate_candidate "$compile_candidate" 2>"$merge_error" || {
		[ -L "$CURRENT" ] || restore_last_valid || true
		cp "$merge_error" "$ERROR_FILE" 2>/dev/null || true
		cat "$merge_error" >&2
		record_result failed current validation || true
		return 2
	}
	hash=$(sha256sum "$compile_candidate" | awk '{print $1}') || return 1
	if [ "$publish" = no ]; then
		printf 'GKD_CONFIG_VALID sha256=%s\n' "$hash"
		return 0
	fi
	if [ -L "$CURRENT" ] && [ "$(readlink "$CURRENT")" = "generations/$hash" ]; then
		record_result unchanged "$hash" none || true
		printf 'GKD_CONFIG_UNCHANGED generation=%s\n' "$hash"
		return 0
	fi
	old_file=/dev/null
	if [ -L "$CURRENT" ]; then
		old_file=$CURRENT/effective.conf
	fi
	stage_generation "$compile_candidate" "$STATE_GEN_ROOT" "$hash" "$old_file" || return 1
	stage_generation "$compile_candidate" "$GEN_ROOT" "$hash" "$old_file" || return 1
	if [ "$publish" = prepare ]; then
		printf 'GKD_CONFIG_PREPARED generation=%s changed=%s\n' \
			"$hash" "$(wc -l <"$GEN_ROOT/$hash/changes.tsv" | tr -d ' ')"
		return 0
	fi
	commit_generation "$hash"
}

edit_override()
{
	action=$1 key=$2 value=${3-}
	grep -q "^${key}|" "$SCHEMA" || {
		say_error "GKD_CONFIG_REJECTED reason=unknown_key key=$key"
		return 2
	}
	umask 077
	mkdir -p "${OVERRIDE_CONFIG%/*}" "$RUN_DIR" || return 1
	candidate=$RUN_DIR/.override.$$
	if [ -r "$OVERRIDE_CONFIG" ]; then
		grep -v "^${key}=" "$OVERRIDE_CONFIG" >"$candidate" || true
	else
		: >"$candidate"
	fi
	if [ "$action" = set ]; then
		printf '%s=%s\n' "$key" "$value" >>"$candidate" || return 1
	fi
	GKD_CONFIG_OVERRIDE="$candidate" "$0" validate >/dev/null || {
		rm -f "$candidate"
		return 2
	}
	mv "$candidate" "$OVERRIDE_CONFIG" || return 1
	printf 'GKD_CONFIG_QUEUED key=%s action=%s\n' "$key" "$action"
}

case "${1:-status}" in
	apply) compile_config yes ;;
	prepare) compile_config prepare ;;
	commit) [ "$#" -eq 2 ] || exit 2; commit_generation "$2" ;;
	validate) compile_config no ;;
	restore) restore_last_valid ;;
	defaults) awk -F '|' '$0 !~ /^#/ && $0 != "" { print $1 "=" $3 }' "$SCHEMA" ;;
	set) [ "$#" -eq 3 ] || exit 2; edit_override set "$2" "$3" ;;
	unset) [ "$#" -eq 2 ] || exit 2; edit_override unset "$2" ;;
	get)
		[ "$#" -eq 2 ] && [ -s "$CURRENT/effective.conf" ] || exit 2
		grep -m1 "^$2=" "$CURRENT/effective.conf" | sed "s/^$2=//"
		;;
	dump) [ -s "$CURRENT/effective.conf" ] && cat "$CURRENT/effective.conf" ;;
	status)
		if [ -L "$CURRENT" ] && [ -s "$CURRENT/generation" ]; then
			printf 'status=ready\ngeneration=%s\neffective=%s\n' \
				"$(cat "$CURRENT/generation")" "$CURRENT/effective.conf"
		else
			printf 'status=uninitialized\n'
			[ ! -L "$STATE_CURRENT" ] || printf 'last_valid=%s\n' "$(readlink "$STATE_CURRENT")"
			exit 1
		fi
		[ ! -s "$RESULT_FILE" ] || cat "$RESULT_FILE"
		[ ! -s "$ERROR_FILE" ] || { printf 'last_error='; tr '\n' ' ' <"$ERROR_FILE"; printf '\n'; }
		;;
	*) say_error 'usage: gkd-config {prepare|commit HASH|apply|validate|restore|defaults|set KEY VALUE|unset KEY|get KEY|dump|status}'; exit 2 ;;
esac
