#!/bin/sh

pidfile=/run/gkd-configd.pid

alive()
{
	[ -s "$pidfile" ] || return 1
	pid=$(sed -n '1p' "$pidfile")
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	kill -0 "$pid" 2>/dev/null
}

case "${1:-start}" in
	start)
		alive && exit 0
		rm -f "$pidfile"
		/usr/sbin/gkd-configd daemon >/var/log/gkd-configd.log 2>&1 &
		printf '%s\n' "$!" >"$pidfile"
		;;
	stop)
		alive && kill "$(cat "$pidfile")" 2>/dev/null || true
		rm -f "$pidfile"
		;;
	restart) "$0" stop; "$0" start ;;
	status) alive ;;
	*) exit 2 ;;
esac
