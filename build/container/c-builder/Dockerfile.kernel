FROM local/c-builder:2026.07.15

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bc \
       bison \
       device-tree-compiler \
       flex \
       libelf-dev \
       libssl-dev \
       rsync \
       u-boot-tools \
    && rm -rf /var/lib/apt/lists/*

RUN command -v make \
    && command -v bc \
    && command -v bison \
    && command -v flex \
    && command -v dtc \
    && command -v mkimage \
    && test -f /usr/include/openssl/bio.h \
    && test -f /usr/include/libelf.h \
    && command -v rsync
