+static u16 x1830_argb8888_over_rgb565(u16 base, u32 top)
+{
+	u32 alpha = top >> 24;
+	u32 inverse = 255U - alpha;
+	u32 base_r = ((base >> 11) & 0x1fU) * 255U / 31U;
+	u32 base_g = ((base >> 5) & 0x3fU) * 255U / 63U;
+	u32 base_b = (base & 0x1fU) * 255U / 31U;
+	u32 top_r = (top >> 16) & 0xffU;
+	u32 top_g = (top >> 8) & 0xffU;
+	u32 top_b = top & 0xffU;
+	u32 red, green, blue;
+
+	if (alpha == 255U) {
+		red = top_r;
+		green = top_g;
+		blue = top_b;
+	} else {
+		red = (top_r * alpha + base_r * inverse + 127U) / 255U;
+		green = (top_g * alpha + base_g * inverse + 127U) / 255U;
+		blue = (top_b * alpha + base_b * inverse + 127U) / 255U;
+	}
+	return (u16)(((red >> 3) << 11) | ((green >> 2) << 5) |
+		      (blue >> 3));
+}
+
+static void x1830_blend_rect(u16 *target, const u32 *overlay,
+			     unsigned int x, unsigned int y,
+			     unsigned int width, unsigned int height)
+{
+	unsigned int row, column, pixel;
+
+	for (row = 0; row < height; ++row)
+		for (column = 0; column < width; ++column) {
+			pixel = (y + row) * X1830_FB_XRES + x + column;
+			if (overlay[pixel] >> 24)
+				target[pixel] = x1830_argb8888_over_rgb565(
+					target[pixel], overlay[pixel]);
+		}
+}
+
+/*
+ * Keep userspace's two RGB565 pages untouched.  Copy the selected page into
+ * an isolated coherent scanout, blend the System UI there, and let hardware
+ * scan only that one RGB565 layer.  This is deterministic on the GKD X1830
+ * where the second DPU layer is fetched but is not present at the TFT output.
+ */
+static u32 x1830_software_composite_locked(struct x1830_fb *fb,
+					    u32 source_addr)
+{
+	u32 fb_addr = lower_32_bits(fb->fb_dma);
+	u32 offset;
+	u16 *source;
+	u16 *target;
+	u32 *overlay = fb->menu_osd_virt;
+	u8 next = fb->composite_front ^ 1U;
+
+	if (fb->usb_debug_frozen_valid) {
+		source = fb->usb_debug_frozen_virt;
+	} else {
+		if (WARN_ON_ONCE(source_addr < fb_addr ||
+				 source_addr - fb_addr >
+				 X1830_FB_SIZE - X1830_FB_FRAME_SIZE))
+			return source_addr;
+		offset = source_addr - fb_addr;
+		source = (u16 *)((u8 *)fb->fb_virt + offset);
+	}
+	target = (u16 *)((u8 *)fb->composite_virt +
+			 next * X1830_FB_FRAME_SIZE);
+	memcpy(target, source, X1830_FB_FRAME_SIZE);
+	if (time_before(jiffies, fb->volume_osd_expires))
+		x1830_blend_rect(target, overlay, X1830_VOLUME_OSD_X,
+				 X1830_VOLUME_OSD_Y, X1830_VOLUME_OSD_WIDTH,
+				 X1830_VOLUME_OSD_HEIGHT);
+	if (time_before(jiffies, fb->menu_expires)) {
+		if (fb->menu_view == X1830_MENU_EJECT_CONFIRM)
+			x1830_blend_rect(target, overlay, 92, 101, 136, 38);
+		else if (fb->menu_view == X1830_MENU_CHARGE ||
+		    fb->menu_view == X1830_MENU_STORAGE_DISABLED)
+			x1830_blend_rect(target, overlay, 8, 206, 94, 22);
+		else if (fb->menu_view == X1830_MENU_STORAGE ||
+		    fb->menu_view == X1830_MENU_DEBUG)
+			/* Exit-only B keycap spans x=98..108, matching menu A's right inset. */
+			x1830_blend_rect(target, overlay, 8, 206, 109, 22);
+		else if (fb->menu_view != X1830_MENU_HIDDEN)
+			x1830_blend_rect(target, overlay, 66, 62, 188, 116);
+	}
+	if (time_before(jiffies, fb->power_osd_expires))
+		x1830_blend_rect(target, overlay, 218, 206, 94, 22);
+	dma_wmb();
+	fb->composite_front = next;
+	return lower_32_bits(fb->composite_dma +
+			      next * X1830_FB_FRAME_SIZE);
+}
+
+static bool x1830_overlay_active_locked(struct x1830_fb *fb)
+{
+	return time_before(jiffies, fb->volume_osd_expires) ||
+		time_before(jiffies, fb->power_osd_expires) ||
+		(fb->menu_view != X1830_MENU_HIDDEN &&
+		 time_before(jiffies, fb->menu_expires));
+}
+
+/*
+ * SDL fbcon emulators flip by FBIOPAN_DISPLAY.  Recompose the selected page
+ * and point the single hardware layer at the isolated scanout.  The composer
+ * is only started if it stopped; the TFT and clocks stay running.
+ */
+static void x1830_hardware_osd_reassert_locked(struct x1830_fb *fb,
+						u32 scanout_addr)
+{
+	struct x1830_frame_desc *frame = &fb->descs->frame;
+	struct x1830_layer_desc *layer = &fb->descs->layer[0];
+	struct x1830_layer_desc *osd = &fb->descs->layer[1];
+
+	u32 frame_dma = lower_32_bits(fb->descs_dma +
+		offsetof(struct x1830_desc_block, frame));
+	u32 layer0_dma = lower_32_bits(fb->descs_dma +
+		offsetof(struct x1830_desc_block, layer[0]));
+	bool overlay_active = x1830_overlay_active_locked(fb);
+	u32 output_addr = scanout_addr;
+
+	fb->composite_source_addr = scanout_addr;
+	if (overlay_active)
+		output_addr = x1830_software_composite_locked(fb, scanout_addr);
+	fb->composite_active = overlay_active;
+
+	WRITE_ONCE(layer->size, X1830_FRAME_SIZE);
+	WRITE_ONCE(layer->config, X1830_LAYER_CFG_RGB565);
+	WRITE_ONCE(layer->buffer_addr, output_addr);
+	WRITE_ONCE(layer->scale, 0);
+	WRITE_ONCE(layer->rotation, 0);
+	WRITE_ONCE(layer->scratch, 0);
+	WRITE_ONCE(layer->position, 0);
+	WRITE_ONCE(layer->resize_coef_x, 0);
+	WRITE_ONCE(layer->resize_coef_y, 0);
+	WRITE_ONCE(layer->stride, X1830_FB_XRES);
+	WRITE_ONCE(layer->buffer_addr_uv, 0);
+	WRITE_ONCE(layer->stride_uv, 0);
+
+	memset(osd, 0, sizeof(*osd));
+	dma_wmb();
+
+	WRITE_ONCE(frame->next, frame_dma);
+	WRITE_ONCE(frame->size, X1830_FRAME_SIZE);
+	WRITE_ONCE(frame->control, X1830_FRAME_CONTROL);
+	WRITE_ONCE(frame->writeback_addr, 0);
+	WRITE_ONCE(frame->writeback_stride, 0);
+	WRITE_ONCE(frame->layer_cfg_addr[0], layer0_dma);
+	WRITE_ONCE(frame->layer_cfg_addr[1], 0);
+	WRITE_ONCE(frame->layer_cfg_addr[2], 0);
+	WRITE_ONCE(frame->layer_cfg_addr[3], 0);
+	WRITE_ONCE(frame->layer_cfg_enable, X1830_FRAME_LAYER_ENABLE);
+	WRITE_ONCE(frame->interrupt_control, X1830_FRAME_IRQ_CONTROL);
+	WRITE_ONCE(frame->reserved, 0);
+	dma_wmb();
+
+	writel(lower_32_bits(fb->descs_dma),
+	       fb->regs + X1830_DPU_FRM_CFG_ADDR);
+	if (!(readl(fb->regs + X1830_DPU_STATUS) &
+	      X1830_DPU_COMPOSER_START))
+		writel(X1830_DPU_COMPOSER_START,
+		       fb->regs + X1830_DPU_FRM_CFG_CTRL);
+	readl(fb->regs + X1830_DPU_FRM_CFG_ADDR);
+	if (overlay_active)
+		mod_delayed_work(system_highpri_wq, &fb->composite_work,
+				 msecs_to_jiffies(X1830_COMPOSITE_REFRESH_MS));
+}
+
+/*
+ * The accepted framebuffer ABI is a direct write-combine mmap, so userspace
+ * writes cannot be observed reliably through fbdev callbacks.  The X1830
+ * exposes direct mmap writes without fbdev damage notifications.  Refresh the
+ * inactive composite buffer periodically in process context while System UI
+ * is visible, then publish it for the following display frame.
+ */
+static void x1830_composite_refresh_work(struct work_struct *work)
+{
+	struct x1830_fb *fb = container_of(to_delayed_work(work),
+					  struct x1830_fb, composite_work);
+	u32 output_addr;
+
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing)
+		goto out_unlock;
+	if (!x1830_overlay_active_locked(fb)) {
+		fb->composite_active = false;
+		WRITE_ONCE(fb->descs->layer[0].buffer_addr,
+			   fb->composite_source_addr);
+		dma_wmb();
+		goto out_unlock;
+	}
+	output_addr = x1830_software_composite_locked(fb,
+						      fb->composite_source_addr);
+	WRITE_ONCE(fb->descs->layer[0].buffer_addr, output_addr);
+	fb->composite_active = true;
+	dma_wmb();
+	queue_delayed_work(system_highpri_wq, &fb->composite_work,
+			   msecs_to_jiffies(X1830_COMPOSITE_REFRESH_MS));
+out_unlock:
+	mutex_unlock(&fb->volume_osd_lock);
+}
+
+static void x1830_menu_render_locked(struct x1830_fb *fb);
+static unsigned long x1830_menu_next_deadline_locked(struct x1830_fb *fb);
+static unsigned long x1830_menu_delay(unsigned long deadline)
+{
+	return time_after(deadline, jiffies) ? deadline - jiffies : 1UL;
+}
+static void x1830_menu_unfreeze_locked(struct x1830_fb *fb)
+{
+	if (!fb->usb_debug_freeze)
+		return;
+	fb->usb_debug_freeze = false;
+}
+
+static int x1830_debug_frozen_capture_locked(struct x1830_fb *fb)
+{
+	u32 fb_addr = lower_32_bits(fb->fb_dma);
+	u32 source_addr = fb->latest_scanout_addr;
+	u32 offset;
+
+	if (fb->usb_debug_frozen_valid)
+		return 0;
+	if (source_addr < fb_addr ||
+	    source_addr - fb_addr > X1830_FB_SIZE - X1830_FB_FRAME_SIZE)
+		return -EIO;
+	offset = source_addr - fb_addr;
+	memcpy(fb->usb_debug_frozen_virt,
+	       (u8 *)fb->fb_virt + offset, X1830_FB_FRAME_SIZE);
+	fb->usb_debug_frozen_valid = true;
+	return 0;
+}
+
+static void x1830_debug_frozen_release_locked(struct x1830_fb *fb)
+{
+	fb->usb_debug_loading_active = false;
+	fb->usb_debug_loading_held = false;
+	fb->usb_debug_loading_hard_expires = 0;
+	fb->usb_debug_loading_target = X1830_MENU_HIDDEN;
+	if (!fb->usb_debug_frozen_valid)
+		return;
+	fb->usb_debug_frozen_valid = false;
+	memzero_explicit(fb->usb_debug_frozen_virt, X1830_FB_FRAME_SIZE);
+}
+
+/* A DEBUG root replacement may outlive the userspace animation lease.  Hold
+ * the already-presented final Loading frame until its one declared target is
+ * ready.  The independent hard deadline remains the bounded fail-open path. */
+static bool x1830_debug_loading_hold_locked(struct x1830_fb *fb)
+{
+	if (fb->menu_view != X1830_MENU_LOADING ||
+	    !fb->usb_debug_frozen_valid ||
+	    !fb->usb_debug_loading_active)
+		return false;
+	if (!time_before(jiffies, fb->usb_debug_loading_hard_expires)) {
+		if (fb->usb_debug_loading_held)
+			dev_warn(fb->dev, "GKD DEBUG Loading hold timed out\n");
+		return false;
+	}
+	fb->usb_debug_loading_held = true;
+	fb->menu_expires = fb->usb_debug_loading_hard_expires;
+	return true;
+}
+
+static void x1830_volume_osd_clear_locked(struct x1830_fb *fb)
+{
+	memset(fb->volume_osd_virt, 0, X1830_VOLUME_OSD_SIZE);
+	dma_wmb();
+}
+
+static void x1830_volume_osd_clear_work(struct work_struct *work)
+{
+	struct x1830_fb *fb = container_of(to_delayed_work(work), struct x1830_fb, volume_osd_clear_work);
+	unsigned long deadline;
+
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) goto out_unlock;
+	/* Expire each surface before selecting the next deadline.  Never return
+	 * early merely because the other surface still has a future lease. */
+	if (!time_before(jiffies, fb->volume_osd_expires)) {
+		fb->volume_osd_expires = 0;
+		x1830_volume_osd_clear_locked(fb);
+	}
+	if (!time_before(jiffies, fb->menu_expires)) {
+		if (!x1830_debug_loading_hold_locked(fb)) {
+			fb->menu_expires = 0;
+			if (fb->menu_view == X1830_MENU_CHOOSER ||
+			    fb->menu_view == X1830_MENU_DEBUG)
+				x1830_menu_unfreeze_locked(fb);
+			fb->menu_view = X1830_MENU_HIDDEN;
+			x1830_debug_frozen_release_locked(fb);
+		}
+	}
+	if (!time_before(jiffies, fb->power_osd_expires)) {
+		fb->power_osd_expires = 0;
+		fb->power_osd_state = X1830_POWER_HIDDEN;
+	}
+	if (fb->menu_view == X1830_MENU_LOADING &&
+	    !fb->usb_debug_loading_held &&
+	    time_before(jiffies, fb->menu_expires))
+		fb->menu_selection = (fb->menu_selection + 1U) & 7U;
+	x1830_menu_render_locked(fb);
+	dma_wmb();
+	x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+	deadline = x1830_menu_next_deadline_locked(fb);
+	if (deadline) mod_delayed_work(system_wq, &fb->volume_osd_clear_work, x1830_menu_delay(deadline));
+out_unlock:
+	mutex_unlock(&fb->volume_osd_lock);
+}
+
+static ssize_t gkd_volume_osd_store(struct device *dev,
+				    struct device_attribute *attribute,
+				    const char *buffer, size_t count)
+{
+	struct fb_info *info = dev_get_drvdata(dev);
+	struct x1830_fb *fb;
+	unsigned int percent;
+	unsigned int timeout_ms;
+	char trailing;
+
+	(void)attribute;
+	if (!info)
+		return -ENODEV;
+	if (sscanf(buffer, "%u %u %c", &percent, &timeout_ms, &trailing) != 2 ||
+	    percent > 100 || timeout_ms < X1830_VOLUME_OSD_TIMEOUT_MIN_MS ||
+	    timeout_ms > X1830_VOLUME_OSD_TIMEOUT_MAX_MS)
+		return -EINVAL;
+
+	fb = info->par;
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) {
+		mutex_unlock(&fb->volume_osd_lock);
+		return -ENODEV;
+	}
+	x1830_volume_osd_render(fb->volume_osd_virt, percent);
+	fb->volume_osd_expires = jiffies + msecs_to_jiffies(timeout_ms);
+	x1830_menu_render_locked(fb);
+	dma_wmb();
+	/* Coalesce repeated key presses into the already scheduled compositor
+	 * refresh instead of publishing two scanout buffers in one frame. */
+	if (fb->composite_active)
+		mod_delayed_work(system_highpri_wq, &fb->composite_work, 0);
+	else
+		x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+	mod_delayed_work(system_wq, &fb->volume_osd_clear_work,
+		x1830_menu_delay(x1830_menu_next_deadline_locked(fb)));
+	mutex_unlock(&fb->volume_osd_lock);
+	return count;
+}
+
+static DEVICE_ATTR_WO(gkd_volume_osd);
