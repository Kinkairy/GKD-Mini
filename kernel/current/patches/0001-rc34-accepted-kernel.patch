+static int x1830_fb_check_var(struct fb_var_screeninfo *var, struct fb_info *info)
+{
+	(void)info;
+
+	if (var->xres != X1830_FB_XRES || var->yres != X1830_FB_YRES ||
+	    var->bits_per_pixel != 16 || var->xoffset ||
+	    (var->yoffset != 0 && var->yoffset != X1830_FB_YRES))
+		return -EINVAL;
+
+	var->xres_virtual = X1830_FB_XRES;
+	var->yres_virtual = X1830_FB_YRES * X1830_FB_FRAME_COUNT;
+	var->red.offset = 11;
+	var->red.length = 5;
+	var->green.offset = 5;
+	var->green.length = 6;
+	var->blue.offset = 0;
+	var->blue.length = 5;
+	var->transp.offset = 0;
+	var->transp.length = 0;
+	return 0;
+}
+
+static int x1830_fb_set_par(struct fb_info *info)
+{
+	return 0;
+}
+
+static u32 x1830_fb_chan_to_field(unsigned int chan,
+				   const struct fb_bitfield *field)
+{
+	if (!field->length)
+		return 0;
+	chan &= 0xffff;
+	chan >>= 16 - field->length;
+	return chan << field->offset;
+}
+
+static int x1830_fb_setcolreg(unsigned int regno, unsigned int red,
+			      unsigned int green, unsigned int blue,
+			      unsigned int transp, struct fb_info *info)
+{
+	u32 *palette = info->pseudo_palette;
+
+	if (regno >= ARRAY_SIZE(((struct x1830_fb *)info->par)->pseudo_palette))
+		return -EINVAL;
+
+	palette[regno] = x1830_fb_chan_to_field(red, &info->var.red) |
+			 x1830_fb_chan_to_field(green, &info->var.green) |
+			 x1830_fb_chan_to_field(blue, &info->var.blue) |
+			 x1830_fb_chan_to_field(transp, &info->var.transp);
+	return 0;
+}
+
+static int x1830_fb_pan_display(struct fb_var_screeninfo *var,
+				struct fb_info *info)
+{
+	struct x1830_fb *fb = info->par;
+	dma_addr_t scanout;
+
+	if (var->xoffset ||
+	    (var->yoffset != 0 && var->yoffset != X1830_FB_YRES))
+		return -EINVAL;
+
+	scanout = fb->fb_dma + var->yoffset * X1830_FB_LINE_LENGTH;
+	if (upper_32_bits(scanout))
+		return -EOVERFLOW;
+
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) {
+		mutex_unlock(&fb->volume_osd_lock);
+		return -ENODEV;
+	}
+	if (fb->usb_debug_freeze) {
+		fb->latest_scanout_addr = lower_32_bits(scanout);
+		mutex_unlock(&fb->volume_osd_lock);
+		return 0;
+	}
+	fb->latest_scanout_addr = lower_32_bits(scanout);
+	x1830_hardware_osd_reassert_locked(fb, lower_32_bits(scanout));
+	mutex_unlock(&fb->volume_osd_lock);
+	return 0;
+}
+
+static int x1830_fb_blank(int blank_mode, struct fb_info *info)
+{
+	struct x1830_fb *fb = info->par;
+
+	if (blank_mode == FB_BLANK_UNBLANK)
+		fb->backlight->props.state &= ~BL_CORE_FBBLANK;
+	else
+		fb->backlight->props.state |= BL_CORE_FBBLANK;
+	return backlight_update_status(fb->backlight);
+}
+
+static int x1830_fb_mmap(struct fb_info *info, struct vm_area_struct *vma)
+{
+	struct x1830_fb *fb = info->par;
+	unsigned long pfn = PHYS_PFN(dma_to_phys(fb->dev,
+						  fb->fb_dma));
+	unsigned long size = vma->vm_end - vma->vm_start;
+
+	/*
+	 * SDL fbcon maps both RGB565 pages in one VMA.  dma_mmap_coherent()
+	 * performs the same page rounding, so reject only a VMA larger than the
+	 * page-aligned two-frame allocation.
+	 */
+	if (vma->vm_pgoff || size > PAGE_ALIGN(X1830_FB_SIZE))
+		return -EINVAL;
+
+	/* Match the accepted vendor jzfb userspace write-acceleration ABI. */
+	vma->vm_pgoff = pfn;
+	vma->vm_flags |= VM_IO | VM_DONTEXPAND | VM_DONTDUMP;
+	vma->vm_page_prot = pgprot_writecombine(vma->vm_page_prot);
+	return io_remap_pfn_range(vma, vma->vm_start, pfn, size,
+				  vma->vm_page_prot);
+}
