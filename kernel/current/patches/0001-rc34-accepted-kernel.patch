+
+static int es8323_component_probe(struct snd_soc_component *component)
+{
+	struct es8323_priv *es8323 = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	ret = es8323_write_sequence(es8323);
+	if (ret)
+		return ret;
+
+	/* Vendor routing follows headphone detect; codec mute is independent. */
+	es8323->muted = true;
+	regmap_write(es8323->regmap, ES8323_DACCONTROL3, 0x06);
+	es8323_update_speaker(es8323);
+
+	return 0;
+}
+
+static int es8323_component_suspend(struct snd_soc_component *component)
+{
+	struct es8323_priv *es8323 = snd_soc_component_get_drvdata(component);
+
+	mutex_lock(&es8323->lock);
+	es8323->muted = true;
+	if (es8323->speaker_enable)
+		gpiod_set_value_cansleep(es8323->speaker_enable, 0);
+	regmap_write(es8323->regmap, ES8323_DACCONTROL3, 0x06);
+	regmap_write(es8323->regmap, ES8323_LOUT2VOL, 0x00);
+	regmap_write(es8323->regmap, ES8323_ROUT2VOL, 0x00);
+	regmap_write(es8323->regmap, ES8323_ADCPOWER, 0xff);
+	regmap_write(es8323->regmap, ES8323_DACPOWER, 0xc0);
+	regmap_write(es8323->regmap, ES8323_CHIPPOWER, 0xf3);
+	regcache_cache_only(es8323->regmap, true);
+	regcache_mark_dirty(es8323->regmap);
+	mutex_unlock(&es8323->lock);
+
+	return 0;
+}
+
+static int es8323_component_resume(struct snd_soc_component *component)
+{
+	struct es8323_priv *es8323 = snd_soc_component_get_drvdata(component);
+	int ret;
+
+	mutex_lock(&es8323->lock);
+	regcache_cache_only(es8323->regmap, false);
+	ret = es8323_write_sequence(es8323);
+	es8323->muted = true;
+	if (!ret)
+		ret = regmap_write(es8323->regmap, ES8323_DACCONTROL3, 0x06);
+	es8323_update_speaker(es8323);
+	mutex_unlock(&es8323->lock);
+
+	return ret;
+}
+
