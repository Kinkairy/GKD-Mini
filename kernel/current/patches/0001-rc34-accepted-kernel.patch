+	bool panel_powered;
+};
+
+static struct x1830_fb *x1830_fb_syscore;
+
+static int x1830_fb_apply_backlight(struct x1830_fb *fb,
+				     unsigned int brightness, bool on)
+{
+	struct pwm_state state;
+	unsigned int duty;
+	int ret;
+
+	brightness = min(brightness, X1830_PANEL_MAX_BRIGHTNESS);
+	duty = X1830_PANEL_PWM_DUTY_NS * brightness;
+	duty /= X1830_PANEL_MAX_BRIGHTNESS;
+	mutex_lock(&fb->backlight_lock);
+	pwm_get_state(fb->pwm, &state);
+	state.period = X1830_PANEL_PWM_PERIOD_NS;
+	state.duty_cycle = duty;
+	state.polarity = PWM_POLARITY_NORMAL;
+	state.enabled = on && brightness;
+	ret = pwm_apply_state(fb->pwm, &state);
+	if (!ret)
+		fb->backlight_on = state.enabled;
+	mutex_unlock(&fb->backlight_lock);
+
+	return ret;
+}
+
+static int x1830_backlight_update_status(struct backlight_device *backlight)
+{
+	struct x1830_fb *fb = bl_get_data(backlight);
+	unsigned int brightness = backlight_get_brightness(backlight);
+	bool on;
+
+	on = fb->panel_powered &&
+		backlight->props.power == FB_BLANK_UNBLANK &&
+		!(backlight->props.state & (BL_CORE_FBBLANK | BL_CORE_SUSPENDED));
+	return x1830_fb_apply_backlight(fb, brightness, on);
+}
+
+static int x1830_backlight_get_brightness(struct backlight_device *backlight)
+{
+	return backlight->props.brightness;
+}
+
+static const struct backlight_ops x1830_backlight_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = x1830_backlight_update_status,
+	.get_brightness = x1830_backlight_get_brightness,
+};
