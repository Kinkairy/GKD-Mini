+					   unsigned int y)
+{
+	u32 light = X1830_ARGB8888(255, 220, 225, 232);
+	u32 muted = X1830_ARGB8888(255, 133, 143, 156);
+
+	x1830_volume_osd_fill(pixels, x, y + 4, 3, 5, light);
+	x1830_volume_osd_fill(pixels, x + 3, y + 2, 2, 9, light);
+	x1830_volume_osd_fill(pixels, x + 5, y + 3, 1, 7, light);
+	x1830_volume_osd_fill(pixels, x + 8, y + 4, 1, 5, muted);
+	x1830_volume_osd_fill(pixels, x + 10, y + 5, 1, 3, muted);
+}
