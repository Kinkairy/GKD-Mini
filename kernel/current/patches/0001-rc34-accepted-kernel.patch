+			0, 1, 13, 10, color);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height,
+			2, 3, 9, 4, panel);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height,
+			9, 8, 2, 1, panel);
+	} else {
+		x1830_menu_status_scaled_rect(fb, x, y, width, height, 3, 0, 1, 2, color);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height, 9, 0, 1, 2, color);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height, 4, 2, 5, 3, color);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height, 3, 5, 7, 6, color);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height, 0, 5, 3, 1, color);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height, 10, 5, 3, 1, color);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height, 0, 8, 3, 1, color);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height, 10, 8, 3, 1, color);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height, 0, 10, 3, 1, color);
+		x1830_menu_status_scaled_rect(fb, x, y, width, height, 10, 10, 3, 1, color);
