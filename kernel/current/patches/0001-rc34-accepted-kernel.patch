diff --git a/arch/mips/ingenic/board-ingenic.c b/arch/mips/ingenic/board-ingenic.c
index e47666449b772b08f3b509cec92f2f23f6892df1..9fd65dfa05bc70d11fdea27f84c3e5497fde5596 100644
--- a/arch/mips/ingenic/board-ingenic.c
