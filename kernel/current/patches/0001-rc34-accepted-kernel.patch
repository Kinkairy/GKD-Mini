@@ -0,0 +1,603 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Everest Semi ES8323 codec support.
+ *
+ * The register programming sequence and clock coefficients in this driver
+ * match the ES8323 used by the GKD Mini.  The speaker-enable and
+ * headphone-detect GPIOs are optional so the codec can also be used on
+ * boards which route those signals elsewhere.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/regmap.h>
+
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+
+#define ES8323_CONTROL1			0x00
+#define ES8323_CONTROL2			0x01
+#define ES8323_CHIPPOWER			0x02
+#define ES8323_ADCPOWER			0x03
+#define ES8323_DACPOWER			0x04
+#define ES8323_CHIPLOPOW1		0x05
+#define ES8323_CHIPLOPOW2		0x06
+#define ES8323_ANAVOLMANAG		0x07
+#define ES8323_IFACE			0x08
+#define ES8323_ADC_IFACE			0x0c
+#define ES8323_ADCCONTROL5		0x0d
+#define ES8323_DAC_IFACE			0x17
+#define ES8323_DACCONTROL2		0x18
+#define ES8323_DACCONTROL3		0x19
+#define ES8323_LDACVOL			0x1a
+#define ES8323_RDACVOL			0x1b
+#define ES8323_LOUT1VOL			0x2e
+#define ES8323_ROUT1VOL			0x2f
+#define ES8323_LOUT2VOL			0x30
+#define ES8323_ROUT2VOL			0x31
+#define ES8323_MAX_REGISTER		0x37
+
+#define ES8323_IFACE_MASTER		BIT(7)
+#define ES8323_IFACE_MCLKDIV2		BIT(6)
+#define ES8323_IFACE_BCLK_INV		BIT(5)
+#define ES8323_ADC_FMT_MASK		GENMASK(1, 0)
+#define ES8323_ADC_WORDLEN_MASK		GENMASK(4, 2)
+#define ES8323_DAC_FMT_MASK		GENMASK(2, 1)
+#define ES8323_DAC_WORDLEN_MASK		GENMASK(5, 3)
+#define ES8323_DAC_LRCLK_INV		BIT(6)
+#define ES8323_DAC_MUTE			BIT(2)
+
+struct es8323_coeff {
+	unsigned int mclk;
+	unsigned int rate;
+	unsigned int fs;
+	u8 sr;
+	u8 usb;
+};
+
+/*
+ * The 24 MHz GKD Mini MCLK is divided by two in the codec, selecting the
+ * 12 MHz USB-mode entries below.  The other rows retain normal ES8323 use.
+ */
+static const struct es8323_coeff es8323_coeffs[] = {
+	{ 12288000,  8000, 1536, 0x0a, 0 },
+	{ 11289600,  8000, 1408, 0x09, 0 },
+	{ 18432000,  8000, 2304, 0x0c, 0 },
+	{ 16934400,  8000, 2112, 0x0b, 0 },
+	{ 12000000,  8000, 1500, 0x0b, 1 },
+	{ 11289600, 11025, 1024, 0x07, 0 },
+	{ 16934400, 11025, 1536, 0x0a, 0 },
+	{ 12000000, 11025, 1088, 0x09, 1 },
+	{ 12288000, 12000, 1024, 0x07, 0 },
+	{ 18432000, 12000, 1536, 0x0a, 0 },
+	{ 12000000, 12000, 1000, 0x08, 1 },
+	{ 12288000, 16000,  768, 0x06, 0 },
+	{ 18432000, 16000, 1152, 0x08, 0 },
+	{ 12000000, 16000,  750, 0x07, 1 },
