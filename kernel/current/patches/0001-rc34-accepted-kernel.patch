+/*
+ * Export the exact RGB565 frame selected for TFT scanout.  Offset zero takes
+ * one stable copy; later sysfs chunks read that copy, so the System UI cannot
+ * disappear or tear while userspace encodes the PNG.
+ */
+static ssize_t gkd_snapshot_rgb565_read(struct file *file,
+					struct kobject *kobj,
+					struct bin_attribute *attribute,
+					char *buffer, loff_t offset,
+					size_t count)
+{
+	struct device *dev = kobj_to_dev(kobj);
+	struct fb_info *info = dev_get_drvdata(dev);
+	struct x1830_fb *fb;
+	u32 address, base;
+	void *source = NULL;
+
+	if (!info || offset < 0 || offset >= X1830_FB_FRAME_SIZE)
+		return 0;
+	fb = info->par;
+	if (count > X1830_FB_FRAME_SIZE - offset)
+		count = X1830_FB_FRAME_SIZE - offset;
+	if (!offset) {
+		mutex_lock(&fb->volume_osd_lock);
+		if (fb->volume_osd_removing) {
+			mutex_unlock(&fb->volume_osd_lock);
+			return -ENODEV;
+		}
+		address = READ_ONCE(fb->descs->layer[0].buffer_addr);
+		base = lower_32_bits(fb->composite_dma);
+		if (address >= base && address - base <=
+		    X1830_COMPOSITE_SIZE - X1830_FB_FRAME_SIZE)
+			source = (u8 *)fb->composite_virt + address - base;
+		else {
+			base = lower_32_bits(fb->fb_dma);
+			if (address >= base && address - base <=
+			    X1830_FB_SIZE - X1830_FB_FRAME_SIZE)
+				source = (u8 *)fb->fb_virt + address - base;
+		}
+		if (source)
+			memcpy(fb->snapshot_virt, source, X1830_FB_FRAME_SIZE);
+		mutex_unlock(&fb->volume_osd_lock);
+		if (!source)
+			return -EIO;
+	}
+	memcpy(buffer, (u8 *)fb->snapshot_virt + offset, count);
+	return count;
+}
+
+static BIN_ATTR_RO(gkd_snapshot_rgb565, X1830_FB_FRAME_SIZE);
