diff --git a/arch/mips/boot/dts/ingenic/gkd350.dts b/arch/mips/boot/dts/ingenic/gkd350.dts
new file mode 100644
index 0000000000000000000000000000000000000000..d50f2918f0401f78ad1d0690fb64a7e92a796582
--- /dev/null
+++ b/arch/mips/boot/dts/ingenic/gkd350.dts
@@ -0,0 +1,436 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+
+#include "x1830.dtsi"
+#include <dt-bindings/clock/ingenic,sysost.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	compatible = "gamekiddy,gkd350", "ingenic,x1830";
+	model = "GameKiddy GKD Mini (GKD350)";
+
+	aliases {
+		serial1 = &uart1;
+		mmc0 = &msc0;
+		mmc1 = &msc1;
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	vcc_msc1: regulator-msc1 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-msc1";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpc 25 GPIO_ACTIVE_LOW>;
+	};
+
+	battery-leds {
+		compatible = "gpio-leds";
+
+		battery-led-1 {
+			label = "gkd350:battery:1";
+			gpios = <&gpc 9 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		battery-led-2 {
+			label = "gkd350:battery:2";
+			gpios = <&gpc 22 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		battery-led-3 {
+			label = "gkd350:battery:3";
+			gpios = <&gpc 20 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		battery-led-4 {
+			label = "gkd350:battery:4";
+			gpios = <&gpc 21 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+	};
+
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "GCW0";
+		simple-audio-card,format = "i2s";
+
+		/* The external oscillator supplies 24 MHz; ES8323 supplies BCLK/LRCLK. */
+		simple-audio-card,bitclock-master = <&audio_codec>;
+		simple-audio-card,frame-master = <&audio_codec>;
+
+		simple-audio-card,widgets =
+			"Speaker", "Speaker",
+			"Headphone", "Headphones";
+		simple-audio-card,routing =
+			"Speaker", "LOUT2",
+			"Speaker", "ROUT2",
+			"Headphones", "LOUT1",
+			"Headphones", "ROUT1";
+
+		audio_cpu: simple-audio-card,cpu {
+			sound-dai = <&aic>;
+			system-clock-frequency = <24000000>;
+		};
+
+		audio_codec: simple-audio-card,codec {
+			sound-dai = <&es8323>;
+			system-clock-frequency = <24000000>;
+			system-clock-direction-out;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		dpad-up {
+			label = "D-pad up";
+			linux,code = <KEY_UP>;
+			gpios = <&gpb 13 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		dpad-down {
+			label = "D-pad down";
+			linux,code = <KEY_DOWN>;
+			gpios = <&gpb 7 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		dpad-left {
+			label = "D-pad left";
+			linux,code = <KEY_LEFT>;
+			gpios = <&gpb 8 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		dpad-right {
+			label = "D-pad right";
+			linux,code = <KEY_RIGHT>;
+			gpios = <&gpb 14 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		button-a {
+			label = "Button A and side dot";
+			linux,code = <KEY_LEFTCTRL>;
+			gpios = <&gpb 9 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		button-b {
+			label = "Button B and side double-dot";
+			linux,code = <KEY_LEFTALT>;
+			gpios = <&gpb 16 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		button-y {
+			label = "Button Y";
+			linux,code = <KEY_SPACE>;
+			gpios = <&gpb 15 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		button-x {
+			label = "Button X";
+			linux,code = <KEY_LEFTSHIFT>;
+			gpios = <&gpb 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		button-start {
+			label = "Start";
+			linux,code = <KEY_ENTER>;
+			gpios = <&gpc 1 GPIO_ACTIVE_HIGH>;
+			debounce-interval = <10>;
+		};
+
+		button-select {
+			label = "Select";
+			linux,code = <KEY_ESC>;
+			gpios = <&gpc 0 GPIO_ACTIVE_HIGH>;
+			debounce-interval = <10>;
+		};
+
+		button-l1 {
+			label = "Left shoulder";
+			linux,code = <KEY_TAB>;
+			gpios = <&gpc 11 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		button-r1 {
+			label = "Right shoulder";
+			linux,code = <KEY_BACKSPACE>;
+			gpios = <&gpb 30 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		button-l2 {
+			label = "Left trigger";
+			linux,code = <KEY_PAGEUP>;
+			gpios = <&gpb 31 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		button-r2 {
+			label = "Right trigger";
+			linux,code = <KEY_PAGEDOWN>;
+			gpios = <&gpb 27 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		button-home {
+			label = "Home";
+			linux,code = <KEY_HOME>;
+			gpios = <&gpb 20 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		button-end {
+			label = "End";
+			linux,code = <KEY_END>;
+			gpios = <&gpb 19 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		volume-up {
+			label = "Volume up";
+			linux,code = <KEY_KPPLUS>;
+			gpios = <&gpb 11 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+		volume-down {
+			label = "Volume down";
+			linux,code = <KEY_KPMINUS>;
+			gpios = <&gpb 10 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+
+	};
+
+	dpu: framebuffer@13050000 {
+		compatible = "gamekiddy,gkd350-x1830-dpu-fb";
+		reg = <0x13050000 0xa020>;
+
+		interrupt-parent = <&intc>;
+		interrupts = <13>;
+
+		clocks = <&cgu X1830_CLK_LCD>,
+			 <&cgu X1830_CLK_AHB1>;
+		clock-names = "lcd", "ahb";
+
+		power-gpios = <&gpc 14 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpc 13 GPIO_ACTIVE_LOW>;
+		panel-data-gpios = <&gpc 12 GPIO_ACTIVE_HIGH>;
+		panel-clock-gpios = <&gpc 15 GPIO_ACTIVE_HIGH>;
+		panel-enable-gpios = <&gpc 16 GPIO_ACTIVE_HIGH>;
+		pwms = <&pwm 0 30000 0>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_lcd>, <&pins_pwm0>;
+
+		status = "okay";
+	};
+
+	/*
+	 * The physical board has 128 MiB.  The final MiB is deliberately hidden
+	 * from Linux so the one-shot boot chain can preserve its 64 KiB trace at
+	 * physical 0x07f00000 across a warm reset.
+	 */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x07f00000>;
+	};
+};
+
+&i2c1 {
+	axp173_pek: power-key@34 {
+		compatible = "gamekiddy,gkd350-axp173-pek";
+		reg = <0x34>;
+
+		interrupt-parent = <&gpc>;
+		interrupts = <26 IRQ_TYPE_LEVEL_LOW>;
+		wakeup-source;
+	};
+};
+
+&exclk {
+	clock-frequency = <24000000>;
+};
+
+&cgu {
+	assigned-clocks = <&cgu X1830_CLK_RTC>,
+			  <&cgu X1830_CLK_I2S>;
+	assigned-clock-parents = <&cgu X1830_CLK_RTCLK>,
+				 <&cgu X1830_CLK_MPLL>;
+	assigned-clock-rates = <0>, <24000000>;
+};
+
+&ost {
+	assigned-clocks = <&ost OST_CLK_EVENT_TIMER>,
+			  <&ost OST_CLK_GLOBAL_TIMER>;
+	assigned-clock-rates = <1500000>, <1500000>;
+};
+
+&tcu {
+	/*
+	 * The panel backlight is physically wired to PWM0.  The Ingenic TCU
+	 * timer driver otherwise consumes channels 0 and 1 for its clock event
+	 * and clocksource, while pwm-jz4740 rejects PWM0 unless the channel is
+	 * explicitly reserved for PWM use.  Keep PWM0 for the panel and leave
+	 * channels 1 and 2 free for the two system-timer roles.
+	 */
+	ingenic,pwm-channels-mask = <0xf9>;
+};
+
+&uart1 {
+	status = "okay";
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_uart1>;
+};
+
+&dtrng {
+	status = "okay";
+};
+
+&msc0 {
+	status = "okay";
+
+	bus-width = <4>;
+	max-frequency = <50000000>;
+	non-removable;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_msc0>;
+};
+
+&msc1 {
+	status = "okay";
+
+	bus-width = <4>;
+	max-frequency = <24000000>;
+	cd-gpios = <&gpb 22 GPIO_ACTIVE_LOW>;
+	vmmc-supply = <&vcc_msc1>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_msc1>, <&pins_msc1_clk>,
+		    <&pins_msc1_cmd_data>;
+};
+
+&i2c1 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_i2c1>;
+};
+
+&i2c2 {
+	status = "okay";
+	clock-frequency = <100000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_i2c2>;
+
+	es8323: audio-codec@10 {
+		compatible = "everest,es8323";
+		reg = <0x10>;
+		#sound-dai-cells = <0>;
+
+		clocks = <&exclk>;
+		clock-names = "mclk";
+
+		/* Vendor board wiring: GPIO81/PC17 and GPIO60/PB28. */
+		speaker-enable-gpios = <&gpc 17 GPIO_ACTIVE_HIGH>;
+		headphone-detect-gpios = <&gpb 28 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&aic {
+	status = "okay";
+	pinctrl-names = "default";
+	/* Playback only: PC19, PC24, PC18 and PC23. */
+	pinctrl-0 = <&pins_i2s_playback>;
+};
+
+&otg_phy {
+	status = "okay";
+};
+
+&otg {
+	status = "okay";
+	dr_mode = "peripheral";
+};
+
+&pinctrl {
+	pins_i2c1: i2c1 {
+		function = "i2c1";
+		groups = "i2c1-data";
+		bias-pull-up;
+	};
+
+	pins_i2c2: i2c2 {
+		function = "i2c2";
+		groups = "i2c2-data";
+		bias-pull-up;
+	};
+
+	pins_i2s_playback: i2s-playback {
+		function = "i2s";
+		/* Never add data-rx or clk-rx: PC20-PC22 are battery LEDs. */
+		groups = "i2s-data-tx", "i2s-clk-txrx", "i2s-sysclk";
+		bias-disable;
+	};
+
+	pins_uart1: uart1 {
+		function = "uart1";
+		groups = "uart1-data";
+		bias-pull-up;
+	};
+
+	pins_msc0: msc0 {
+		function = "mmc0";
+		groups = "mmc0-1bit", "mmc0-4bit";
+		bias-disable;
+	};
+
+	pins_msc1: msc1 {
+		function = "mmc1";
+		groups = "mmc1-1bit", "mmc1-4bit";
+	};
+
+	pins_msc1_clk: msc1-clk {
+		pins = "PC2";
+		bias-disable;
+	};
+
+	pins_msc1_cmd_data: msc1-cmd-data {
+		pins = "PC3", "PC4", "PC5", "PC6", "PC7";
+		bias-pull-up;
+	};
+
+	pins_lcd: lcd {
+		function = "lcd";
+		groups = "lcd-tft-8bit", "lcd-tft-24bit";
+		bias-disable;
+	};
+
+	pins_pwm0: pwm0 {
+		function = "pwm0";
+		groups = "pwm0-b";
+		bias-disable;
+	};
+};
