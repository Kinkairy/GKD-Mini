+static void ingenic_intc_suspend(struct irq_chip_generic *gc)
+{
+	struct ingenic_intc_pm_state *pm = gc->private;
+	void __iomem *gpioc;
+	u32 wake = gc->wake_active & gc->wake_enabled;
+
+	/*
+	 * Match the shipping kernel by making the hardware mask authoritative
+	 * on every cycle instead of relying on the previous resume state.
+	 */
+	irq_gc_lock(gc);
+	pm->runtime_enabled = gc->mask_cache;
+	irq_reg_writel(gc, ~wake, JZ_REG_INTC_SET_MASK);
+	irq_reg_writel(gc, wake, JZ_REG_INTC_CLEAR_MASK);
+	gc->mask_cache = wake;
+	pm->wake = wake;
+	pm->mask_sleep = irq_reg_readl(gc, JZ_REG_INTC_MASK);
+	pm->status_sleep = irq_reg_readl(gc, JZ_REG_INTC_STATUS);
+	pm->pending_sleep = irq_reg_readl(gc, JZ_REG_INTC_PENDING);
+	if (ingenic_intc->x1830 && !gc->irq_base) {
+		gpioc = (void __iomem *)CKSEG1ADDR(X1830_GPIOC_PHYS);
+		pm->gpioc_pin_sleep = readl(gpioc + X1830_GPIO_PIN);
+		pm->gpioc_int_sleep = readl(gpioc + X1830_GPIO_INT);
+		pm->gpioc_mask_sleep = readl(gpioc + X1830_GPIO_MASK);
+		pm->gpioc_pat1_sleep = readl(gpioc + X1830_GPIO_PAT1);
+		pm->gpioc_pat0_sleep = readl(gpioc + X1830_GPIO_PAT0);
+		pm->gpioc_flag_sleep = readl(gpioc + X1830_GPIO_FLAG);
+	}
+	irq_gc_unlock(gc);
+}
+
+static void ingenic_intc_resume(struct irq_chip_generic *gc)
+{
+	struct ingenic_intc_pm_state *pm = gc->private;
+	void __iomem *gpioc;
+
+	irq_gc_lock(gc);
+	pm->status_resume = irq_reg_readl(gc, JZ_REG_INTC_STATUS);
+	pm->pending_resume = irq_reg_readl(gc, JZ_REG_INTC_PENDING);
+	if (ingenic_intc->x1830 && !gc->irq_base) {
+		gpioc = (void __iomem *)CKSEG1ADDR(X1830_GPIOC_PHYS);
+		pm->gpioc_pin_resume = readl(gpioc + X1830_GPIO_PIN);
+		pm->gpioc_flag_resume = readl(gpioc + X1830_GPIO_FLAG);
+	}
+	irq_reg_writel(gc, pm->runtime_enabled, JZ_REG_INTC_CLEAR_MASK);
+	gc->mask_cache |= pm->runtime_enabled;
+	irq_gc_unlock(gc);
+
+	pr_info("ingenic-intc-pm: bank=%u wake=%08x runtime=%08x mask_sleep=%08x status_sleep=%08x pending_sleep=%08x status_resume=%08x pending_resume=%08x\n",
+		gc->irq_base / 32, pm->wake, pm->runtime_enabled,
+		pm->mask_sleep, pm->status_sleep, pm->pending_sleep,
+		pm->status_resume, pm->pending_resume);
+	if (ingenic_intc->x1830 && !gc->irq_base)
+		pr_info("ingenic-intc-pm: gpioc pin_sleep=%08x int_sleep=%08x mask_sleep=%08x pat1_sleep=%08x pat0_sleep=%08x flag_sleep=%08x pin_resume=%08x flag_resume=%08x gpc26_pin=%u gpc26_flag_sleep=%u gpc26_flag_resume=%u\n",
+			pm->gpioc_pin_sleep, pm->gpioc_int_sleep,
+			pm->gpioc_mask_sleep, pm->gpioc_pat1_sleep,
+			pm->gpioc_pat0_sleep, pm->gpioc_flag_sleep,
+			pm->gpioc_pin_resume, pm->gpioc_flag_resume,
+			!!(pm->gpioc_pin_sleep & X1830_PMIC_GPIO),
+			!!(pm->gpioc_flag_sleep & X1830_PMIC_GPIO),
+			!!(pm->gpioc_flag_resume & X1830_PMIC_GPIO));
+}
