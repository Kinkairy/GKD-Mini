+static void x1830_menu_loading_locked(struct x1830_fb *fb)
+{
+	static const s8 offsets[8][2] = {
+		{ 0, -13 }, { 9, -9 }, { 13, 0 }, { 9, 9 },
+		{ 0, 13 }, { -9, 9 }, { -13, 0 }, { -9, -9 },
+	};
+	unsigned int index;
+	u32 panel = X1830_ARGB8888(255, 18, 22, 28);
+	u32 idle = X1830_ARGB8888(255, 72, 80, 90);
+	u32 active = X1830_ARGB8888(255, 210, 218, 226);
+
+	/* Pure graphics in the existing Layer1 allocation: no new glyphs. */
+	x1830_menu_rounded_rect(fb, 141, 101, 38, 38, panel);
+	for (index = 0; index < ARRAY_SIZE(offsets); ++index) {
+		unsigned int x = 158 + offsets[index][0];
+		unsigned int y = 118 + offsets[index][1];
+		u32 color = index == fb->menu_selection ? active : idle;
+
+		if (index & 1U)
+			x1830_menu_rect(fb, x, y, 4, 4, color);
+		else if (index == 0 || index == 4)
+			x1830_menu_rect(fb, x, y, 4, 6, color);
+		else
+			x1830_menu_rect(fb, x, y, 6, 4, color);
+	}
+}
