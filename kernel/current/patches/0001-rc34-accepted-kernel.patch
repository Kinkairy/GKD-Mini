--- /dev/null
+++ b/drivers/input/keyboard/gkd-axp173-pek.c
@@ -0,0 +1,462 @@
+// SPDX-License-Identifier: GPL-2.0
+/* GKD Mini AXP173 power-key and wake handling. */
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/pm.h>
+#include <linux/pm_wakeup.h>
+#include <linux/property.h>
+#include <linux/string.h>
+
+#define AXP173_IRQ_ENABLE	0x40
+#define AXP173_IRQ_STATUS	0x44
+#define AXP173_IRQ_BYTES	4
+#define AXP173_PEK_LONG		BIT(0)
+#define AXP173_PEK_SHORT		BIT(1)
+
+struct gkd_axp173 {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct mutex lock;
+	u8 saved_enable[AXP173_IRQ_BYTES];
+	u8 original_enable[AXP173_IRQ_BYTES];
+	bool saved_valid;
+	bool original_valid;
+	bool wake_armed;
+};
+
+static int gkd_axp173_read(struct gkd_axp173 *axp, u8 reg, u8 values[4])
+{
+	int ret;
+
+	ret = i2c_smbus_read_i2c_block_data(axp->client, reg,
+					    AXP173_IRQ_BYTES, values);
+	if (ret < 0)
+		return ret;
+	return ret == AXP173_IRQ_BYTES ? 0 : -EIO;
+}
+
+static int gkd_axp173_write(struct gkd_axp173 *axp, u8 reg,
+			    const u8 values[4])
+{
+	int index;
+	int ret;
+
+	for (index = 0; index < AXP173_IRQ_BYTES; index++) {
+		ret = i2c_smbus_write_byte_data(axp->client, reg + index,
+						values[index]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static bool gkd_axp173_pek_pending(const u8 values[4])
+{
+	return !!(values[2] & (AXP173_PEK_SHORT | AXP173_PEK_LONG));
+}
+
+static bool gkd_axp173_status_clear(const u8 values[4])
+{
+	return !(values[0] | values[1] | values[2] | values[3]);
+}
+
+static void gkd_axp173_report_power(struct gkd_axp173 *axp)
+{
+	input_report_key(axp->input, KEY_POWER, 1);
+	input_sync(axp->input);
+	input_report_key(axp->input, KEY_POWER, 0);
+	input_sync(axp->input);
+}
+
+static int gkd_axp173_clear_status(struct gkd_axp173 *axp,
+				   const u8 status[4])
+{
+	if (gkd_axp173_status_clear(status))
+		return 0;
+	return gkd_axp173_write(axp, AXP173_IRQ_STATUS, status);
+}
+
+static int gkd_axp173_clear_all_status(struct gkd_axp173 *axp)
+{
+	u8 status[AXP173_IRQ_BYTES];
+	int attempt;
+	int ret;
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		ret = gkd_axp173_read(axp, AXP173_IRQ_STATUS, status);
+		if (ret)
+			return ret;
+		if (gkd_axp173_status_clear(status))
+			return 0;
+		ret = gkd_axp173_clear_status(axp, status);
+		if (ret)
+			return ret;
+	}
+	ret = gkd_axp173_read(axp, AXP173_IRQ_STATUS, status);
+	if (ret)
+		return ret;
+	return gkd_axp173_status_clear(status) ? 0 : -EBUSY;
+}
+
+static irqreturn_t gkd_axp173_irq_thread(int irq, void *data)
+{
+	struct gkd_axp173 *axp = data;
+	u8 status[AXP173_IRQ_BYTES];
+	u8 readback[AXP173_IRQ_BYTES];
+	int ret;
+
+	mutex_lock(&axp->lock);
+	ret = gkd_axp173_read(axp, AXP173_IRQ_STATUS, status);
+	if (!ret && !gkd_axp173_status_clear(status)) {
+		dev_info(&axp->client->dev,
+			 "IRQ status=%02x/%02x/%02x/%02x\n",
+			 status[0], status[1], status[2], status[3]);
+		ret = gkd_axp173_clear_status(axp, status);
+		if (!ret) {
+			ret = gkd_axp173_read(axp, AXP173_IRQ_STATUS, readback);
+			if (!ret && !gkd_axp173_status_clear(readback))
+				ret = -EBUSY;
+		}
+		if (!ret && gkd_axp173_pek_pending(status))
+			gkd_axp173_report_power(axp);
+	}
+	mutex_unlock(&axp->lock);
+
+	if (ret) {
+		dev_err_ratelimited(&axp->client->dev,
+				    "failed to service AXP173 IRQ: %d\n", ret);
+		disable_irq_nosync(irq);
+	}
+	return IRQ_HANDLED;
+}
+
+static int gkd_axp173_restore_mask(struct gkd_axp173 *axp,
+				    const u8 mask[AXP173_IRQ_BYTES],
+				    bool *restored)
+{
+	static const u8 disabled[AXP173_IRQ_BYTES] = { 0, 0, 0, 0 };
+	u8 readback[AXP173_IRQ_BYTES];
+	int first_error = 0;
+	int ret;
+
+	*restored = false;
+	ret = gkd_axp173_write(axp, AXP173_IRQ_ENABLE, disabled);
+	if (ret)
+		first_error = ret;
+	ret = gkd_axp173_clear_all_status(axp);
+	if (ret && !first_error)
+		first_error = ret;
+	ret = gkd_axp173_write(axp, AXP173_IRQ_ENABLE, mask);
+	if (ret) {
+		if (!first_error)
+			first_error = ret;
+		return first_error;
+	}
+	ret = gkd_axp173_read(axp, AXP173_IRQ_ENABLE, readback);
+	if (!ret && memcmp(readback, mask, sizeof(readback)))
+		ret = -EIO;
+	if (ret) {
+		if (!first_error)
+			first_error = ret;
+		return first_error;
+	}
+	*restored = true;
+	return first_error;
+}
+
+static int gkd_axp173_restore_enable(struct gkd_axp173 *axp)
+{
+	bool restored;
+	int ret;
+
+	if (!axp->saved_valid)
+		return 0;
+	ret = gkd_axp173_restore_mask(axp, axp->saved_enable, &restored);
+	if (restored)
+		axp->saved_valid = false;
+	return ret;
+}
+
+static int gkd_axp173_suspend(struct device *dev)
+{
+	static const u8 disabled[AXP173_IRQ_BYTES] = { 0, 0, 0, 0 };
+	static const u8 short_only[AXP173_IRQ_BYTES] = {
+		0, 0, AXP173_PEK_SHORT, 0,
+	};
+	struct gkd_axp173 *axp = dev_get_drvdata(dev);
+	u8 readback[AXP173_IRQ_BYTES] = { 0, 0, 0, 0 };
+	const char *stage = "read-enable";
+	int ret;
+	int restore_ret;
+	bool irq_safe = true;
+
+	disable_irq(axp->client->irq);
+	mutex_lock(&axp->lock);
+
+	ret = gkd_axp173_read(axp, AXP173_IRQ_ENABLE, axp->saved_enable);
+	if (ret)
+		goto out;
+	axp->saved_valid = true;
+	irq_safe = false;
+	stage = "mask-enable";
+	ret = gkd_axp173_write(axp, AXP173_IRQ_ENABLE, disabled);
+	if (ret)
+		goto restore;
+	stage = "clear-status";
+	ret = gkd_axp173_clear_all_status(axp);
+	if (ret)
+		goto restore;
+	stage = "arm-short";
+	ret = gkd_axp173_write(axp, AXP173_IRQ_ENABLE, short_only);
+	if (ret)
+		goto restore;
+	stage = "verify-short";
+	ret = gkd_axp173_read(axp, AXP173_IRQ_ENABLE, readback);
+	if (ret)
+		goto restore;
+	if (!(readback[2] & AXP173_PEK_SHORT)) {
+		ret = -EIO;
+		goto restore;
+	}
+	stage = "verify-status-clear";
+	ret = gkd_axp173_read(axp, AXP173_IRQ_STATUS, readback);
+	if (ret)
+		goto restore;
+	if (!gkd_axp173_status_clear(readback)) {
+		ret = -EBUSY;
+		goto restore;
+	}
+	stage = "enable-irq-wake";
+	ret = enable_irq_wake(axp->client->irq);
+	if (ret)
+		goto restore;
+	axp->wake_armed = true;
+	irq_safe = true;
+	goto out;
+
+restore:
+	restore_ret = gkd_axp173_restore_enable(axp);
+	if (!axp->saved_valid)
+		irq_safe = true;
+	if (restore_ret)
+		dev_err(dev, "suspend error %d; mask restore failed: %d\n",
+			ret, restore_ret);
+	dev_err(dev, "suspend setup failed at %s: %d, readback=%02x/%02x/%02x/%02x\n",
+		stage, ret, readback[0], readback[1], readback[2], readback[3]);
+out:
+	mutex_unlock(&axp->lock);
+	if (irq_safe)
+		enable_irq(axp->client->irq);
+	else
+		dev_err(dev, "AXP173 IRQ left disabled after unsafe suspend rollback\n");
+	return ret;
+}
+
+static int gkd_axp173_resume(struct device *dev)
+{
+	struct gkd_axp173 *axp = dev_get_drvdata(dev);
+	u8 status[AXP173_IRQ_BYTES];
+	int ret = 0;
+	int restore_ret;
+	int wake_ret = 0;
+	bool irq_safe;
+
+	disable_irq(axp->client->irq);
+	if (axp->wake_armed) {
+		wake_ret = disable_irq_wake(axp->client->irq);
+		if (!wake_ret)
+			axp->wake_armed = false;
+		else
+			dev_err(dev, "failed to disarm resume wake IRQ: %d\n",
+				wake_ret);
+	}
+
+	mutex_lock(&axp->lock);
+	ret = gkd_axp173_read(axp, AXP173_IRQ_STATUS, status);
+	if (!ret) {
+		dev_info(dev, "resume IRQ status=%02x/%02x/%02x/%02x\n",
+			 status[0], status[1], status[2], status[3]);
+		if (gkd_axp173_pek_pending(status))
+			gkd_axp173_report_power(axp);
+	} else {
+		dev_err(dev, "failed to read resume IRQ status: %d\n", ret);
+	}
+	restore_ret = gkd_axp173_restore_enable(axp);
+	irq_safe = !axp->saved_valid;
+	mutex_unlock(&axp->lock);
+	if (irq_safe)
+		enable_irq(axp->client->irq);
+	else
+		dev_err(dev, "AXP173 IRQ left disabled after unsafe resume restore\n");
+
+	if (restore_ret)
+		dev_err(dev, "failed to restore AXP173 IRQ state: %d\n",
+			restore_ret);
+	if (ret)
+		return ret;
+	if (restore_ret)
+		return restore_ret;
+	return wake_ret;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(gkd_axp173_pm_ops,
+				gkd_axp173_suspend, gkd_axp173_resume);
+
+static int gkd_axp173_restore_original_enable(struct gkd_axp173 *axp)
+{
+	bool restored;
+	int ret;
+
+	if (!axp->original_valid)
+		return 0;
+	ret = gkd_axp173_restore_mask(axp, axp->original_enable, &restored);
+	if (restored)
+		axp->original_valid = false;
+	return ret;
+}
+
+static void gkd_axp173_quiesce(struct i2c_client *client)
+{
+	struct gkd_axp173 *axp = i2c_get_clientdata(client);
+	int ret = 0;
+	int wake_ret = 0;
+
+	if (!axp)
+		return;
+	disable_irq(client->irq);
+	if (axp->wake_armed) {
+		wake_ret = disable_irq_wake(client->irq);
+		if (!wake_ret)
+			axp->wake_armed = false;
+	}
+	if (axp->original_valid) {
+		mutex_lock(&axp->lock);
+		ret = gkd_axp173_restore_original_enable(axp);
+		mutex_unlock(&axp->lock);
+	}
+	if (wake_ret)
+		dev_err(&client->dev, "failed to disarm AXP173 wake IRQ: %d\n",
+			wake_ret);
+	if (ret)
+		dev_err(&client->dev,
+			"failed to restore original AXP173 IRQ enable mask: %d\n",
+			ret);
+}
+
+static int gkd_axp173_probe(struct i2c_client *client)
+{
+	static const u8 disabled[AXP173_IRQ_BYTES] = { 0, 0, 0, 0 };
+	static const u8 runtime_enable[AXP173_IRQ_BYTES] = {
+		0, 0, AXP173_PEK_SHORT, 0,
+	};
+	struct device *dev = &client->dev;
+	struct gkd_axp173 *axp;
+	u8 readback[AXP173_IRQ_BYTES];
+	int ret;
+	int restore_ret;
+
+	if (client->irq <= 0)
+		return -EINVAL;
+
+	if (!i2c_check_functionality(client->adapter,
+				     I2C_FUNC_SMBUS_READ_I2C_BLOCK |
+				     I2C_FUNC_SMBUS_WRITE_BYTE_DATA))
+		return dev_err_probe(dev, -EOPNOTSUPP,
+				     "adapter lacks required SMBus transactions\n");
+
+	axp = devm_kzalloc(dev, sizeof(*axp), GFP_KERNEL);
+	if (!axp)
+		return -ENOMEM;
+	axp->client = client;
+	mutex_init(&axp->lock);
+	i2c_set_clientdata(client, axp);
+
+	axp->input = devm_input_allocate_device(dev);
+	if (!axp->input)
+		return -ENOMEM;
+	axp->input->name = "GKD Mini AXP173 power key";
+	axp->input->phys = "axp173-pek/input0";
+	axp->input->id.bustype = BUS_I2C;
+	input_set_capability(axp->input, EV_KEY, KEY_POWER);
+	ret = input_register_device(axp->input);
+	if (ret)
+		return ret;
+
+	ret = gkd_axp173_read(axp, AXP173_IRQ_ENABLE, axp->original_enable);
+	if (ret)
+		return ret;
+	axp->original_valid = true;
+	ret = gkd_axp173_write(axp, AXP173_IRQ_ENABLE, disabled);
+	if (ret)
+		goto restore_original;
+	ret = gkd_axp173_clear_all_status(axp);
+	if (ret)
+		goto restore_original;
+	ret = gkd_axp173_write(axp, AXP173_IRQ_ENABLE, runtime_enable);
+	if (ret)
+		goto restore_original;
+	ret = gkd_axp173_read(axp, AXP173_IRQ_ENABLE, readback);
+	if (ret)
+		goto restore_original;
+	if (readback[0] || readback[1] || readback[3] ||
+	    !(readback[2] & AXP173_PEK_SHORT) ||
+	    (readback[2] & ~(AXP173_PEK_SHORT | AXP173_PEK_LONG))) {
+		ret = -EIO;
+		goto restore_original;
+	}
+
+	dev_info(dev, "requesting AXP173 IRQ %d trigger 0x%x\n",
+		 client->irq, irq_get_trigger_type(client->irq));
+	ret = devm_request_threaded_irq(dev, client->irq, NULL,
+					gkd_axp173_irq_thread,
+					IRQF_ONESHOT | IRQF_TRIGGER_LOW,
+					dev_name(dev), axp);
+	if (ret) {
+		dev_err_probe(dev, ret,
+			      "failed to request AXP173 IRQ %d trigger 0x%x\n",
+			      client->irq, irq_get_trigger_type(client->irq));
+		goto restore_original;
+	}
+
+	device_init_wakeup(dev,
+			   device_property_read_bool(dev, "wakeup-source"));
+	dev_info(dev, "AXP173 PEK-only mask on level-low IRQ %d\n",
+		 client->irq);
+	return 0;
+
+restore_original:
+	restore_ret = gkd_axp173_restore_original_enable(axp);
+	if (restore_ret)
+		dev_err(dev, "AXP173 PEK probe error %d; mask restore failed: %d\n",
+			ret, restore_ret);
+	return dev_err_probe(dev, ret, "AXP173 PEK probe setup failed\n");
+}
+
+static const struct of_device_id gkd_axp173_of_match[] = {
+	{ .compatible = "gamekiddy,gkd350-axp173-pek" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gkd_axp173_of_match);
+
+static struct i2c_driver gkd_axp173_driver = {
+	.driver = {
+		.name = "gkd-axp173-pek",
+		.of_match_table = gkd_axp173_of_match,
+		.pm = pm_sleep_ptr(&gkd_axp173_pm_ops),
+	},
+	.probe_new = gkd_axp173_probe,
+	.remove = gkd_axp173_quiesce,
+	.shutdown = gkd_axp173_quiesce,
+};
+module_i2c_driver(gkd_axp173_driver);
+
+MODULE_AUTHOR("GKD Mini RC2.9 suspend lane");
+MODULE_DESCRIPTION("GKD Mini AXP173 power-key wake driver");
+MODULE_LICENSE("GPL");
