+#ifdef CONFIG_MACH_X1830
+extern void ingenic_pm_init_x1830(void);
+extern void ingenic_pm_sleep_x1830(void);
+#endif
+
 static void ingenic_wait_instr(void)
 {
 	__asm__(".set push;\n"
@@ -172,10 +177,16 @@ static int __maybe_unused ingenic_pm_enter(suspend_state_t state)
 {
 
 	#ifdef CONFIG_PM_SLEEP
