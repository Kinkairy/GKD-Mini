+static const u8 *x1830_menu_cjk_glyph(u16 codepoint)
+{
+	unsigned int left = 0, right = ARRAY_SIZE(x1830_menu_cjk_codepoints);
+
+	while (left < right) {
+		unsigned int middle = left + (right - left) / 2;
+		if (x1830_menu_cjk_codepoints[middle] < codepoint)
+			left = middle + 1;
+		else
+			right = middle;
+	}
+	if (left >= ARRAY_SIZE(x1830_menu_cjk_codepoints) ||
+	    x1830_menu_cjk_codepoints[left] != codepoint)
+		return NULL;
+	return x1830_menu_cjk_bitmaps[left];
+}
+
+static void x1830_menu_cjk_text(struct x1830_fb *fb, unsigned int x,
+				unsigned int y, const u16 *text, u32 color)
+{
+	for (; *text; ++text, x += 10) {
+		const u8 *glyph = x1830_menu_cjk_glyph(*text);
+		unsigned int bit;
+		if (!glyph)
+			continue;
+		for (bit = 0; bit < 100; ++bit)
+			if (glyph[bit >> 3] & (0x80U >> (bit & 7)))
+				fb->menu_osd_virt[(y + bit / 10) *
+					X1830_MENU_WIDTH + x + bit % 10] = color;
+	}
+}
