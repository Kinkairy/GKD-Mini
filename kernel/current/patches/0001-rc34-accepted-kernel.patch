+static unsigned int x1830_volume_osd_glyph_rows(char character)
+{
+	switch (character) {
+	case '0': return 0x7b6f;
+	case '1': return 0x2c97;
+	case '2': return 0x73e7;
+	case '3': return 0x73cf;
+	case '4': return 0x5bc9;
+	case '5': return 0x79cf;
+	case '6': return 0x79ef;
+	case '7': return 0x7292;
+	case '8': return 0x7bef;
+	case '9': return 0x7bcf;
+	case 'A': return 0x2d6f;
+	case 'B': return 0x6bae;
+	case 'D': return 0x6b6e;
+	case 'E': return 0x79e7;
+	case 'F': return 0x79e4;
+	case 'H': return 0x5bed;
+	case 'I': return 0x7492;
+	case 'R': return 0x6bad;
+	case 'S': return 0x79cf;
+	case 'T': return 0x7492;
+	case 'V': return 0x5b6a;
+	case 'O': return 0x7b6f;
+	case 'L': return 0x4927;
+	case '%': return 0x52a5;
+	case ' ': return 0;
+	default: return 0;
+	}
+}
+
+static void x1830_volume_osd_draw_glyph(u32 *pixels, unsigned int x,
+					 unsigned int y, char character,
+					 u32 color)
+{
+	unsigned int bits = x1830_volume_osd_glyph_rows(character);
+	unsigned int row;
+	unsigned int column;
+
+	for (row = 0; row < 5; ++row)
+		for (column = 0; column < 3; ++column)
+			if (bits & (1U << (14 - row * 3 - column)))
+				x1830_volume_osd_fill(pixels, x + column,
+						      y + row, 1, 1, color);
+}
+
+static void x1830_volume_osd_draw_text(u32 *pixels, unsigned int x,
+					const char *text, u32 color)
+{
+	for (; *text != '\0'; ++text, x += 5)
+		x1830_volume_osd_draw_glyph(pixels, x, 8, *text, color);
+}
