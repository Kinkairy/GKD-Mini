+static void x1830_menu_render_locked(struct x1830_fb *fb)
+{
+	static const char *const mode_labels[] = {
+		"CHARGE MODE", "STORAGE MODE", "DEBUG MODE"
+	};
+	unsigned int index, y, mode;
+	u32 text = X1830_ARGB8888(255, 244, 240, 232);
+	u32 panel = X1830_ARGB8888(255, 18, 22, 28);
+
+	memset(fb->menu_osd_virt, 0, X1830_MENU_SIZE);
+	if (time_before(jiffies, fb->volume_osd_expires))
+		for (y = 0; y < X1830_VOLUME_OSD_HEIGHT; ++y)
+			memcpy(&fb->menu_osd_virt[(X1830_VOLUME_OSD_Y + y) * X1830_MENU_WIDTH +
+				X1830_VOLUME_OSD_X], &fb->volume_osd_virt[y * X1830_VOLUME_OSD_WIDTH],
+				X1830_VOLUME_OSD_WIDTH * sizeof(u32));
+	x1830_power_osd_render_locked(fb);
+	if (!time_before(jiffies, fb->menu_expires)) {
+		if (!x1830_debug_loading_hold_locked(fb)) {
+			fb->menu_view = X1830_MENU_HIDDEN;
+			x1830_debug_frozen_release_locked(fb);
+			return;
+		}
+	}
+	if (fb->menu_view == X1830_MENU_EJECT_CONFIRM) {
+		u32 warning = X1830_ARGB8888(255, 255, 184, 64);
+		x1830_menu_rounded_rect(fb, 92, 101, 136, 38, panel);
+		/* A dedicated amber exclamation mark avoids confusing this
+		 * confirmation with the normal DEBUG bug icon. */
+		x1830_menu_rounded_rect(fb, 104, 113, 13, 13, warning);
+		x1830_menu_rect(fb, 109, 116, 2, 5, panel);
+		x1830_menu_rect(fb, 109, 123, 2, 2, panel);
+		if (fb->menu_chinese)
+			x1830_menu_cjk_text(fb, 126, 113,
+				x1830_menu_zh_eject_confirm, text);
+		else
+			x1830_menu_text(fb, 126, 117, "EJECT CARD?", text);
+		return;
+	}
+	if (fb->menu_view == X1830_MENU_LOADING) {
+		x1830_menu_loading_locked(fb);
+		return;
+	}
+	/* The charge/network panel and transient notifications share the exact
+	 * bottom-left slot.  A transient always wins; the persistent panel returns
+	 * automatically when the notification lease expires. */
+	if (fb->menu_view == X1830_MENU_CHARGE &&
+	    time_before(jiffies, fb->volume_osd_expires))
+		return;
+	if (fb->menu_view == X1830_MENU_CHARGE ||
+	    fb->menu_view == X1830_MENU_STORAGE ||
+	    fb->menu_view == X1830_MENU_DEBUG) {
+		/* Active modes use the same icon, palette and compact panel as chooser. */
+		mode = fb->menu_view == X1830_MENU_CHARGE ? 0 :
+			fb->menu_view == X1830_MENU_STORAGE ? 1 : 2;
+		x1830_menu_rounded_rect(fb, 8, 206,
+			fb->menu_view == X1830_MENU_CHARGE ? 94 : 109, 22, panel);
+		if (fb->menu_view == X1830_MENU_CHARGE &&
+		    fb->usb_network_online) {
+			x1830_menu_status_network_icon(fb,
+				fb->status_icon_x, fb->status_icon_y,
+				fb->status_icon_width, fb->status_icon_height,
+				x1830_menu_network_color());
+			if (fb->usb_network_label[0])
+				x1830_menu_scaled_text(fb, fb->status_text_x,
+					fb->status_text_y + 2U,
+					fb->usb_network_label, text,
+					3U, 5U, 5U, 2U);
+			else if (fb->menu_chinese)
+				x1830_menu_cjk_text(fb, fb->status_text_x,
+					fb->status_text_y,
+					x1830_menu_zh_network, text);
+			else
+				x1830_menu_text(fb, fb->status_text_x,
+					fb->status_text_y + 4U,
+					"NETWORK READY", text);
+		} else {
+			x1830_menu_status_choice_icon(fb,
+				fb->status_icon_x, fb->status_icon_y,
+				fb->status_icon_width, fb->status_icon_height,
+				mode, x1830_menu_mode_color(mode));
+			x1830_menu_mode_label(fb, fb->status_text_x,
+				fb->status_text_y, mode,
+				mode_labels[mode], text);
+		}
+		if (fb->menu_view != X1830_MENU_CHARGE)
+			x1830_menu_keycap(fb, 98, 211, 'B',
+				X1830_ARGB8888(255, 232, 74, 74));
+		return;
+	}
+	if (fb->menu_view == X1830_MENU_POWER) {
+		x1830_menu_rounded_rect(fb, 86, 85, 148, 70, panel);
+		for (index = 0; index < 3; ++index)
+			x1830_power_menu_row_locked(fb, index);
+		x1830_menu_keycap(fb, 215, 96 + fb->menu_selection * 21, 'A',
+			X1830_ARGB8888(255, 105, 231, 137));
+	} else if (fb->menu_view == X1830_MENU_POWER_DISABLED) {
+		x1830_menu_rounded_rect(fb, 92, 101, 136, 38, panel);
+		x1830_power_menu_label(fb, 0, 104, 109, text);
+		x1830_menu_text(fb, 104, 126, "UNAVAILABLE",
+			X1830_ARGB8888(255, 255, 184, 64));
+	} else if (fb->menu_view == X1830_MENU_CHOOSER) {
+		/* Title-free compact chooser: the 148x70 surface is centered at
+		 * (160,120); its fixed icon/text/A columns remain balanced on that axis. */
+		x1830_menu_rounded_rect(fb, 86, 85, 148, 70, panel);
+		for (index = 0; index < 3; ++index) {
+			x1830_menu_choice_row_locked(fb, index);
+		}
+		x1830_menu_keycap(fb, 215, 96 + fb->menu_selection * 21, 'A',
+			X1830_ARGB8888(255, 105, 231, 137));
+	} else if (fb->menu_view == X1830_MENU_STORAGE_DISABLED) {
+		/* Auto-clearing feedback uses the same bottom-left status slot. */
+		x1830_menu_rounded_rect(fb, 8, 206, 94, 22, panel);
+		x1830_menu_status_choice_icon(fb,
+			fb->status_icon_x, fb->status_icon_y,
+			fb->status_icon_width, fb->status_icon_height,
+			1, x1830_menu_mode_color(1));
+		x1830_menu_mode_label(fb, fb->status_text_x,
+			fb->status_text_y, 1, "STORAGE", text);
+	} else {
+		x1830_menu_rounded_rect(fb, 92, 101, 136, 38, panel);
+		x1830_menu_choice_icon(fb, 104, 114, 2,
+			x1830_menu_mode_color(2));
+		x1830_menu_mode_label(fb, 126, 113, 2, "DEBUG", text);
+	}
+}
+
+static unsigned long x1830_menu_next_deadline_locked(struct x1830_fb *fb)
+{
+	unsigned long deadline = 0;
+	if (time_before(jiffies, fb->volume_osd_expires))
+		deadline = fb->volume_osd_expires;
+	if (time_before(jiffies, fb->menu_expires) &&
+	    (!deadline || time_before(fb->menu_expires, deadline)))
+		deadline = fb->menu_expires;
+	if (time_before(jiffies, fb->power_osd_expires) &&
+	    (!deadline || time_before(fb->power_osd_expires, deadline)))
+		deadline = fb->power_osd_expires;
+	/* Loading animation belongs to the kernel lease, not to the
+	 * requesting process which may disappear during a root pivot. */
+	if (fb->menu_view == X1830_MENU_LOADING &&
+	    !fb->usb_debug_loading_held &&
+	    time_before(jiffies, fb->menu_expires)) {
+		unsigned long frame = jiffies + msecs_to_jiffies(125U);
+		if (!deadline || time_before(frame, deadline))
+			deadline = frame;
+	}
+	return deadline;
+}
+
+static int x1830_menu_parse_uint(const char **input, unsigned int *value)
+{
+	unsigned int v = 0, digit;
+	const char *p = *input;
+	if (*p < '0' || *p > '9')
+		return -EINVAL;
+	do {
+		digit = *p++ - '0';
+		if (v > (UINT_MAX - digit) / 10U)
+			return -ERANGE;
+		v = v * 10U + digit;
+	} while (*p >= '0' && *p <= '9');
+	*input = p;
+	*value = v;
+	return 0;
+}
+
+static int x1830_menu_parse(const char *buffer, size_t count,
+			    enum x1830_usb_menu_view *view, unsigned int *selection,
+			    unsigned int *timeout)
+{
+	char command[65];
+	const char *p;
+	if (count > 64)
+		return -EINVAL;
+	memcpy(command, buffer, count);
+	command[count] = '\0';
+	p = command;
+	if (count == 5 && !memcmp(p, "hide\n", 5)) { *view = X1830_MENU_HIDDEN; *selection = 0; *timeout = 0; return 0; }
+	if (count < 12)
+		return -EINVAL;
+	if (!strncmp(p, "chooser ", 8)) { p += 8; *view = X1830_MENU_CHOOSER; }
+	else if (!strncmp(p, "status charge ", 14)) { p += 14; *view = X1830_MENU_CHARGE; }
+	else if (!strncmp(p, "status storage ", 15)) { p += 15; *view = X1830_MENU_STORAGE; }
+	else if (!strncmp(p, "confirm eject ", 14)) { p += 14; *view = X1830_MENU_EJECT_CONFIRM; }
+	else if (!strncmp(p, "status storage-disabled ", 24)) { p += 24; *view = X1830_MENU_STORAGE_DISABLED; }
+	else if (!strncmp(p, "status debug-disabled ", 22)) { p += 22; *view = X1830_MENU_DEBUG_DISABLED; }
+	else if (!strncmp(p, "status debug ", 13)) { p += 13; *view = X1830_MENU_DEBUG; }
+	else if (!strncmp(p, "power-disabled ", 15)) { p += 15; *view = X1830_MENU_POWER_DISABLED; }
+	else if (!strncmp(p, "power ", 6)) { p += 6; *view = X1830_MENU_POWER; }
+	else if (!strncmp(p, "loading ", 8)) { p += 8; *view = X1830_MENU_LOADING; }
+	else return -EINVAL;
+	if (*view == X1830_MENU_CHOOSER || *view == X1830_MENU_POWER ||
+	    *view == X1830_MENU_LOADING) { if (x1830_menu_parse_uint(&p, selection) || *selection > (*view == X1830_MENU_LOADING ? 7U : 2U) || *p++ != ' ') return -EINVAL; }
+	else *selection = 0;
+	if (x1830_menu_parse_uint(&p, timeout) || *timeout < X1830_MENU_TIMEOUT_MIN_MS ||
+	    *timeout > X1830_MENU_TIMEOUT_MAX_MS || *p++ != '\n' || *p)
+		return -EINVAL;
+	return 0;
+}
+
+static int x1830_status_layout_parse(const char *buffer, size_t count,
+		unsigned int *text_x, unsigned int *text_y,
+		unsigned int *icon_x, unsigned int *icon_y,
+		unsigned int *icon_width, unsigned int *icon_height)
+{
+	char command[65];
+	const char *p;
+	unsigned int *values[] = {
+		text_x, text_y, icon_x, icon_y, icon_width, icon_height
+	};
+	unsigned int index;
+
+	if (count > 64U || count < 19U)
+		return -EINVAL;
+	memcpy(command, buffer, count);
+	command[count] = '\0';
+	p = command;
+	if (strncmp(p, "layout ", 7))
+		return -EINVAL;
+	p += 7;
+	for (index = 0; index < ARRAY_SIZE(values); ++index) {
+		if (x1830_menu_parse_uint(&p, values[index]))
+			return -EINVAL;
+		if (*p++ != (index + 1U == ARRAY_SIZE(values) ? '\n' : ' '))
+			return -EINVAL;
+	}
+	if (*p || *text_x < 8U || *text_x > 50U ||
+	    *text_y < 206U || *text_y > 218U ||
+	    *icon_width < 5U || *icon_width > 24U ||
+	    *icon_height < 5U || *icon_height > 18U ||
+	    *icon_x < 8U || *icon_x + *icon_width > 102U ||
+	    *icon_y < 206U || *icon_y + *icon_height > 228U)
+		return -EINVAL;
+	return 0;
+}
+
+static bool x1830_debug_loading_expire_locked(struct x1830_fb *fb)
+{
+	if (!fb->usb_debug_loading_active ||
+	    time_before(jiffies, fb->usb_debug_loading_hard_expires))
+		return false;
+	fb->menu_expires = 0;
+	fb->menu_view = X1830_MENU_HIDDEN;
+	x1830_debug_frozen_release_locked(fb);
+	x1830_menu_render_locked(fb);
+	dma_wmb();
+	x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+	return true;
+}
+
+static ssize_t gkd_usb_menu_store(struct device *dev, struct device_attribute *attr,
+				  const char *buffer, size_t count)
+{
+	struct fb_info *info = dev_get_drvdata(dev);
+	struct x1830_fb *fb;
+	enum x1830_usb_menu_view view;
+	unsigned int selection, timeout;
+	unsigned int text_x = 0, text_y = 0, icon_x = 0, icon_y = 0;
+	unsigned int icon_width = 0, icon_height = 0;
+	unsigned int index;
+	unsigned long deadline;
+	int language = -1;
+	bool layout = false;
+	bool debug_loading;
+	u8 debug_loading_target;
+	(void)attr;
+	if (!info)
+		return -ENODEV;
+	if (count == 12 && !memcmp(buffer, "language zh\n", 12))
+		language = 1;
+	else if (count == 12 && !memcmp(buffer, "language en\n", 12))
+		language = 0;
+	else if (count >= 7U && !memcmp(buffer, "layout ", 7)) {
+		if (x1830_status_layout_parse(buffer, count,
+		    &text_x, &text_y, &icon_x, &icon_y,
+		    &icon_width, &icon_height))
+			return -EINVAL;
+		layout = true;
+	}
+	else if (x1830_menu_parse(buffer, count, &view, &selection, &timeout))
+		return -EINVAL;
+	fb = info->par;
+	if (language >= 0 || layout) {
+		mutex_lock(&fb->volume_osd_lock);
+		if (fb->volume_osd_removing) {
+			mutex_unlock(&fb->volume_osd_lock);
+			return -ENODEV;
+		}
+		/* Language/layout redraws the current surface, so neither may
+		 * bypass an active DEBUG Loading completion boundary. */
+		if (fb->usb_debug_loading_active) {
+			if (x1830_debug_loading_expire_locked(fb)) {
+				mutex_unlock(&fb->volume_osd_lock);
+				return -ETIMEDOUT;
+			}
+			mutex_unlock(&fb->volume_osd_lock);
+			return -EBUSY;
+		}
+		if (language >= 0)
+			fb->menu_chinese = language;
+		else {
+			fb->status_text_x = text_x;
+			fb->status_text_y = text_y;
+			fb->status_icon_x = icon_x;
+			fb->status_icon_y = icon_y;
+			fb->status_icon_width = icon_width;
+			fb->status_icon_height = icon_height;
+		}
+		x1830_menu_render_locked(fb);
+		dma_wmb();
+		x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+		mutex_unlock(&fb->volume_osd_lock);
+		return count;
+	}
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) { mutex_unlock(&fb->volume_osd_lock); return -ENODEV; }
+	/* A thawed action-freeze writer may already be inside its final syscall
+	 * when the requester removes the lease.  Keep the gate across explicit
+	 * hide; the next visible non-Loading owner is safely after input drain. */
+	if (fb->power_resume_loading_suppressed) {
+		if (view == X1830_MENU_LOADING) {
+			fb->power_resume_loading_renewal_suppressed_count++;
+			mutex_unlock(&fb->volume_osd_lock);
+			return count;
+		}
+		if (view != X1830_MENU_HIDDEN)
+			fb->power_resume_loading_suppressed = false;
+	}
+	/* All Loading surfaces have exactly one animation owner: the kernel timer.
+	 * Userspace renews only the expiry.  Two independent 125 ms frame writers
+	 * caused the visible power/storage Loading flicker. */
+	if (view == X1830_MENU_LOADING &&
+	    fb->menu_view == X1830_MENU_LOADING &&
+	    !fb->usb_debug_loading_active) {
+		fb->menu_expires = jiffies + msecs_to_jiffies(timeout);
+		/* Renewal extends the lease but must not postpone the already-armed
+		 * animation tick.  Otherwise 125 ms renewals can starve every frame. */
+		if (!delayed_work_pending(&fb->volume_osd_clear_work)) {
+			deadline = x1830_menu_next_deadline_locked(fb);
+			if (deadline)
+				mod_delayed_work(system_wq, &fb->volume_osd_clear_work,
+					x1830_menu_delay(deadline));
+		}
+		mutex_unlock(&fb->volume_osd_lock);
+		return count;
+	}
+	/* A DEBUG transition accepts only Loading renewals and its declared target:
+	 * DEBUG when entering the RAM root, chooser when returning to normal root. */
+	if (fb->menu_view == X1830_MENU_LOADING &&
+	    fb->usb_debug_frozen_valid &&
+	    fb->usb_debug_loading_active &&
+	    view != X1830_MENU_LOADING) {
+		/* Every declared completion target first passes the same hard deadline. */
+		if (x1830_debug_loading_expire_locked(fb)) {
+			mutex_unlock(&fb->volume_osd_lock);
+			return -ETIMEDOUT;
+		}
+		if (view != fb->usb_debug_loading_target) {
+			mutex_unlock(&fb->volume_osd_lock);
+			return -EBUSY;
+		}
+	}
+	/* A late DEBUG Loading renewal cannot restart or advance a held frame. */
+	if (view == X1830_MENU_LOADING &&
+	    fb->menu_view == X1830_MENU_LOADING &&
+	    fb->usb_debug_frozen_valid &&
+	    fb->usb_debug_loading_active) {
+		if (x1830_debug_loading_expire_locked(fb)) {
+			mutex_unlock(&fb->volume_osd_lock);
+			return -ETIMEDOUT;
+		}
+		if (!fb->usb_debug_loading_held &&
+		    !time_before(jiffies, fb->menu_expires) &&
+		    !x1830_debug_loading_hold_locked(fb)) {
+			mutex_unlock(&fb->volume_osd_lock);
+			return -ETIMEDOUT;
+		}
+		if (!delayed_work_pending(&fb->volume_osd_clear_work)) {
+			deadline = x1830_menu_next_deadline_locked(fb);
+			if (deadline)
+				mod_delayed_work(system_wq, &fb->volume_osd_clear_work,
+					x1830_menu_delay(deadline));
+		}
+		mutex_unlock(&fb->volume_osd_lock);
+		return count;
+	}
+	/* DEBUG Loading is animated only by the kernel deadline worker.  The
+	 * userspace lease owner may renew the surface but cannot race its frame. */
+	if (view == X1830_MENU_LOADING &&
+	    fb->menu_view == X1830_MENU_LOADING &&
+	    fb->usb_debug_frozen_valid &&
+	    time_before(jiffies, fb->menu_expires)) {
+		fb->menu_expires = jiffies + msecs_to_jiffies(timeout);
+		if (!delayed_work_pending(&fb->volume_osd_clear_work)) {
+			deadline = x1830_menu_next_deadline_locked(fb);
+			if (deadline)
+				mod_delayed_work(system_wq, &fb->volume_osd_clear_work,
+					x1830_menu_delay(deadline));
+		}
+		mutex_unlock(&fb->volume_osd_lock);
+		return count;
+	}
+	/* Every unchanged visible status uses the same renewal path.  Rebuild and
+	 * republish the shared surface so a previous owner release or transient
+	 * overlay cannot leave a live lease attached to an invisible panel. */
+	if (view != X1830_MENU_HIDDEN && fb->menu_view == view &&
+	    fb->menu_selection == selection &&
+	    time_before(jiffies, fb->menu_expires)) {
+		fb->menu_expires = jiffies + msecs_to_jiffies(timeout);
+		x1830_menu_render_locked(fb);
+		dma_wmb();
+		if (fb->composite_active)
+			mod_delayed_work(system_highpri_wq,
+				&fb->composite_work, 0);
+		else
+			x1830_hardware_osd_reassert_locked(fb,
+				fb->latest_scanout_addr);
+		deadline = x1830_menu_next_deadline_locked(fb);
+		if (deadline)
+			mod_delayed_work(system_wq, &fb->volume_osd_clear_work,
+				x1830_menu_delay(deadline));
+		mutex_unlock(&fb->volume_osd_lock);
+		return count;
+	}
+	if (view == X1830_MENU_LOADING && fb->menu_view == X1830_MENU_LOADING &&
+	    fb->menu_selection != selection &&
+	    time_before(jiffies, fb->menu_expires)) {
+		fb->menu_selection = selection;
+		fb->menu_expires = jiffies + msecs_to_jiffies(timeout);
+		x1830_menu_loading_locked(fb);
+		dma_wmb();
+		deadline = x1830_menu_next_deadline_locked(fb);
+		if (deadline)
+			mod_delayed_work(system_wq, &fb->volume_osd_clear_work,
+				x1830_menu_delay(deadline));
+		mutex_unlock(&fb->volume_osd_lock);
+		return count;
+	}
+	if ((view == X1830_MENU_CHOOSER || view == X1830_MENU_POWER) &&
+	    fb->menu_view == view &&
+	    fb->menu_selection != selection &&
+	    time_before(jiffies, fb->menu_expires)) {
+		fb->menu_selection = selection;
+		fb->menu_expires = jiffies + msecs_to_jiffies(timeout);
+		for (index = 0; index < 3; ++index)
+			if (view == X1830_MENU_POWER)
+				x1830_power_menu_row_locked(fb, index);
+			else
+				x1830_menu_choice_row_locked(fb, index);
+		/* Row redraw erases the previous cap; repaint it at selection. */
+		x1830_menu_keycap(fb, 215, 96 + fb->menu_selection * 21, 'A',
+			X1830_ARGB8888(255, 105, 231, 137));
+		dma_wmb();
+		deadline = x1830_menu_next_deadline_locked(fb);
+		if (deadline)
+			mod_delayed_work(system_wq, &fb->volume_osd_clear_work,
+				x1830_menu_delay(deadline));
+		mutex_unlock(&fb->volume_osd_lock);
+		return count;
+	}
+	debug_loading = view == X1830_MENU_LOADING &&
+		(fb->usb_debug_frozen_valid || fb->menu_view == X1830_MENU_DEBUG ||
+		 (fb->menu_view == X1830_MENU_CHOOSER &&
+		  fb->menu_selection == 2U));
+	debug_loading_target = fb->menu_view == X1830_MENU_DEBUG ?
+		X1830_MENU_CHOOSER : X1830_MENU_DEBUG;
+	if (debug_loading && !fb->usb_debug_frozen_valid &&
+	    x1830_debug_frozen_capture_locked(fb) < 0) {
+		mutex_unlock(&fb->volume_osd_lock);
+		return -EIO;
+	}
+	if (debug_loading) {
+		fb->usb_debug_loading_active = true;
+		fb->usb_debug_loading_held = false;
+		fb->usb_debug_loading_hard_expires = jiffies +
+			msecs_to_jiffies(X1830_DEBUG_LOADING_HARD_TIMEOUT_MS);
+		fb->usb_debug_loading_target = debug_loading_target;
+	} else if (fb->menu_view == X1830_MENU_LOADING &&
+		   view == X1830_MENU_DEBUG &&
+		   fb->usb_debug_loading_target == X1830_MENU_DEBUG) {
+		/* Enter completion keeps the frozen background for the DEBUG page. */
+		fb->usb_debug_loading_active = false;
+		fb->usb_debug_loading_held = false;
+		fb->usb_debug_loading_hard_expires = 0;
+		fb->usb_debug_loading_target = X1830_MENU_HIDDEN;
+	}
+	/* The already-grabbed ordinary-root chooser is the sole return success
+	 * boundary.  Outside an active DEBUG Loading transition, a non-DEBUG
+	 * surface is an explicit abort/owner change and also releases the snapshot. */
+	if (view == X1830_MENU_CHOOSER ||
+	    (!fb->usb_debug_loading_active &&
+	     view != X1830_MENU_LOADING && view != X1830_MENU_DEBUG))
+		x1830_debug_frozen_release_locked(fb);
+	fb->menu_view = view;
+	fb->menu_selection = selection;
+	fb->menu_expires = timeout ? jiffies + msecs_to_jiffies(timeout) : 0;
+	/* DEBUG owns the frozen last scanout until the RAM supervisor exits. */
+	if (view == X1830_MENU_CHOOSER || view == X1830_MENU_POWER ||
+	    view == X1830_MENU_DEBUG || view == X1830_MENU_EJECT_CONFIRM ||
+	    view == X1830_MENU_LOADING) {
+		fb->usb_debug_freeze = true;
+	} else {
+		x1830_menu_unfreeze_locked(fb);
+	}
+	x1830_menu_render_locked(fb);
+	dma_wmb();
+	x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+	deadline = x1830_menu_next_deadline_locked(fb);
+	if (deadline) mod_delayed_work(system_wq, &fb->volume_osd_clear_work, x1830_menu_delay(deadline));
+	mutex_unlock(&fb->volume_osd_lock);
+	return count;
+}
+static DEVICE_ATTR_WO(gkd_usb_menu);
+static bool x1830_network_label_valid(const char *label, size_t length)
+{
+	unsigned int octet = 0, digits = 0, dots = 0, index;
+
+	if (length < 7U || length > 15U)
+		return false;
+	for (index = 0; index < length; ++index) {
+		if (label[index] >= '0' && label[index] <= '9') {
+			if (digits >= 3U)
+				return false;
+			octet = octet * 10U + label[index] - '0';
+			if (octet > 255U)
+				return false;
+			digits++;
+		} else if (label[index] == '.') {
+			if (!digits || dots >= 3U)
+				return false;
+			dots++;
+			digits = 0;
+			octet = 0;
+		} else {
+			return false;
+		}
+	}
+	return dots == 3U && digits > 0U;
+}
+
+static ssize_t gkd_network_status_store(struct device *dev,
+					struct device_attribute *attr,
+					const char *buffer, size_t count)
+{
+	struct fb_info *info = dev_get_drvdata(dev);
+	struct x1830_fb *fb;
+	char label[16] = { 0 };
+	size_t label_length;
+	bool changed;
+	bool online;
+
+	(void)attr;
+	if (!info)
+		return -ENODEV;
+	if (count == 7 && !memcmp(buffer, "online\n", 7))
+		online = true;
+	else if (count >= 15U && count <= 23U &&
+		 !memcmp(buffer, "online ", 7) && buffer[count - 1U] == '\n') {
+		label_length = count - 8U;
+		if (!x1830_network_label_valid(buffer + 7, label_length))
+			return -EINVAL;
+		memcpy(label, buffer + 7, label_length);
+		online = true;
+	}
+	else if (count == 8 && !memcmp(buffer, "offline\n", 8))
+		online = false;
+	else
+		return -EINVAL;
+
+	fb = info->par;
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) {
+		mutex_unlock(&fb->volume_osd_lock);
+		return -ENODEV;
+	}
+	changed = fb->usb_network_online != online ||
+		strcmp(fb->usb_network_label, label);
+	if (changed) {
+		fb->usb_network_online = online;
+		strscpy(fb->usb_network_label, label,
+			sizeof(fb->usb_network_label));
+		if (fb->menu_view == X1830_MENU_CHARGE) {
+			x1830_menu_render_locked(fb);
+			dma_wmb();
+			if (fb->composite_active)
+				mod_delayed_work(system_highpri_wq,
+					&fb->composite_work, 0);
+			else
+				x1830_hardware_osd_reassert_locked(fb,
+					fb->latest_scanout_addr);
+		}
+	}
+	mutex_unlock(&fb->volume_osd_lock);
+	return count;
+}
+static DEVICE_ATTR_WO(gkd_network_status);
+static ssize_t gkd_runtime_id_show(struct device *dev,
+					struct device_attribute *attr, char *buffer)
+{
+	(void)dev;
+	(void)attr;
+	return sysfs_emit(buffer,
+		"908aad72c5cf20b1db46e228752a1aab658b18591d61932c6ccf9a00257661b3\n");
+}
+static DEVICE_ATTR_RO(gkd_runtime_id);
+static ssize_t gkd_resume_state_show(struct device *dev,
+				      struct device_attribute *attr, char *buffer)
+{
+	struct fb_info *info = dev_get_drvdata(dev);
+	struct x1830_fb *fb;
+	(void)attr;
+	if (!info)
+		return -ENODEV;
+	fb = info->par;
+	return sysfs_emit(buffer, "hide=%u suppressed=%u gate=%u\n",
+		READ_ONCE(fb->power_resume_loading_hide_count),
+		READ_ONCE(fb->power_resume_loading_renewal_suppressed_count),
+		READ_ONCE(fb->power_resume_loading_suppressed) ? 1U : 0U);
+}
+static DEVICE_ATTR_RO(gkd_resume_state);
+
+static ssize_t gkd_power_osd_store(struct device *dev,
+				   struct device_attribute *attribute,
+				   const char *buffer, size_t count)
+{
+	struct fb_info *info = dev_get_drvdata(dev);
+	struct x1830_fb *fb;
+	char state[12], trailing;
+	unsigned int percent, timeout_ms;
+	unsigned long deadline;
+	u8 view;
+	(void)attribute;
+	if (!info)
+		return -ENODEV;
+	if (sscanf(buffer, "%11s %u %u %c", state, &percent, &timeout_ms,
+		   &trailing) != 3 || percent > 100U ||
+	    timeout_ms < X1830_MENU_TIMEOUT_MIN_MS || timeout_ms > 5000U)
+		return -EINVAL;
+	if (!strcmp(state, "usb-in")) view = X1830_POWER_USB_IN;
+	else if (!strcmp(state, "usb-out")) view = X1830_POWER_USB_OUT;
+	else if (!strcmp(state, "low")) view = X1830_POWER_LOW;
+	else if (!strcmp(state, "critical")) view = X1830_POWER_CRITICAL;
+	else return -EINVAL;
+	fb = info->par;
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) {
+		mutex_unlock(&fb->volume_osd_lock);
+		return -ENODEV;
+	}
+	fb->power_osd_state = view;
+	fb->power_osd_percent = percent;
+	fb->power_osd_expires = jiffies + msecs_to_jiffies(timeout_ms);
+	x1830_menu_render_locked(fb);
+	dma_wmb();
+	x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+	deadline = x1830_menu_next_deadline_locked(fb);
+	if (deadline)
+		mod_delayed_work(system_wq, &fb->volume_osd_clear_work,
+			x1830_menu_delay(deadline));
+	mutex_unlock(&fb->volume_osd_lock);
+	return count;
+}
+static DEVICE_ATTR_WO(gkd_power_osd);
+
+static ssize_t gkd_battery_label_write(struct file *file, struct kobject *kobj,
+				       struct bin_attribute *attribute, char *buffer,
+				       loff_t offset, size_t count)
+{
+	struct fb_info *info = dev_get_drvdata(kobj_to_dev(kobj));
+	struct x1830_battery_label_blob *blob = (void *)buffer;
+	struct x1830_fb *fb;
+	(void)file; (void)attribute;
+	if (!info)
+		return -ENODEV;
+	if (offset || count != sizeof(*blob) ||
+	    memcmp(blob->magic, "GKDBAT1", 7) || blob->magic[7] ||
+	    blob->version != 1 || blob->count != 1 ||
+	    memchr_inv(blob->reserved, 0, sizeof(blob->reserved)) ||
+	    !blob->label.width || blob->label.width > X1830_BATTERY_LABEL_WIDTH ||
+	    memchr_inv(blob->label.reserved, 0, sizeof(blob->label.reserved)))
+		return -EINVAL;
+	fb = info->par;
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) {
+		mutex_unlock(&fb->volume_osd_lock);
+		return -ENODEV;
+	}
+	memcpy(&fb->battery_label, &blob->label, sizeof(fb->battery_label));
+	mutex_unlock(&fb->volume_osd_lock);
+	return count;
+}
+
+static struct bin_attribute bin_attr_gkd_battery_label = {
+	.attr = { .name = "gkd_battery_label", .mode = 0200 },
+	.size = sizeof(struct x1830_battery_label_blob),
+	.write = gkd_battery_label_write,
+};
