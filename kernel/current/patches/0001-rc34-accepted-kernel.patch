+static ssize_t gkd_notification_store(struct device *dev,
+				      struct device_attribute *attribute,
+				      const char *buffer, size_t count)
+{
+	struct fb_info *info = dev_get_drvdata(dev);
+	struct x1830_fb *fb;
+	char state[8];
+	unsigned int timeout_ms;
+	char trailing;
+	bool saved;
+
+	(void)attribute;
+	if (!info)
+		return -ENODEV;
+	if (sscanf(buffer, "%7s %u %c", state, &timeout_ms, &trailing) != 2 ||
+	    timeout_ms < X1830_VOLUME_OSD_TIMEOUT_MIN_MS ||
+	    timeout_ms > X1830_VOLUME_OSD_TIMEOUT_MAX_MS)
+		return -EINVAL;
+	if (!strcmp(state, "saved"))
+		saved = true;
+	else if (!strcmp(state, "failed"))
+		saved = false;
+	else
+		return -EINVAL;
+
+	fb = info->par;
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) {
+		mutex_unlock(&fb->volume_osd_lock);
+		return -ENODEV;
+	}
+	x1830_notification_render(fb->volume_osd_virt, saved);
+	fb->volume_osd_expires = jiffies + msecs_to_jiffies(timeout_ms);
+	x1830_menu_render_locked(fb);
+	dma_wmb();
+	x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+	mod_delayed_work(system_wq, &fb->volume_osd_clear_work,
+		x1830_menu_delay(x1830_menu_next_deadline_locked(fb)));
+	mutex_unlock(&fb->volume_osd_lock);
+	return count;
+}
