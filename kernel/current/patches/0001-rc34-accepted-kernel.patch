+/*
+ * Persistent progress marker.  Positive scalar stages keep the historical
+ * 0x38444bxx/0x3844xxxx encoding.  Negative values are Round 24 raw bitmap
+ * records and are stored without an OR prefix.  Every MMIO wait is bounded.
+ * The helper uses no stack or BSS and never touches the watchdog.
+ *
+ * Save the incoming IE bit and keep interrupts disabled only around each
+ * bounded transaction.  This also ensures no exception path can interfere
+ * with the RTC unlock sequence.  Ordinary caller-saved t registers replace
+ * k0/k1, which exception entry is allowed to destroy.
+ */
+LEAF(gkd_round14_rtc_stage)
+	.set	push
+	.set	noreorder
+	move	v0, zero		# return 0 unless verified
+	bltz	a0, .Lround24_raw_value
+	nop
+	sltiu	t1, a0, 0x100
+	beqz	t1, .Lround24_wide_value
+	li	t5, 0x38444b00
+	b	.Lround24_value_ready
+	nop
+.Lround24_wide_value:
+	li	t5, 0x38440000
+	b	.Lround24_value_ready
+	nop
+.Lround24_raw_value:
+	move	t5, a0
+.Lround24_value_ready:
+	or	t5, t5, a0
+	di	t6
+	andi	t6, t6, 1		# preserve only the incoming IE state
+	irq_disable_hazard
+	li	t3, 0xb0003000		# X1830 RTC base, uncached
+	li	t2, 3			# bounded write/readback attempts
+.Lround14_attempt:
+	li	t0, 10000
+.Lround14_wrdy1:
+	lw	t4, 0x00(t3)
+	andi	t4, t4, 0x80
+	bnez	t4, .Lround14_unlock
+	addiu	t0, t0, -1
+	bnez	t0, .Lround14_wrdy1
+	nop
+	b	.Lround14_retry
+	nop
+
+.Lround14_unlock:
+	li	t4, 0x0000a55a
+	sw	t4, 0x3c(t3)
+	sync
+	li	t0, 10000
+.Lround14_wen:
+	lw	t4, 0x3c(t3)
+	srl	t4, t4, 31
+	bnez	t4, .Lround14_wrdy2_start
+	addiu	t0, t0, -1
+	bnez	t0, .Lround14_wen
+	nop
+	b	.Lround14_retry
+	nop
+
+.Lround14_wrdy2_start:
+	li	t0, 10000
+.Lround14_wrdy2:
+	lw	t4, 0x00(t3)
+	andi	t4, t4, 0x80
+	bnez	t4, .Lround14_store
+	addiu	t0, t0, -1
+	bnez	t0, .Lround14_wrdy2
+	nop
+	b	.Lround14_retry
+	nop
+
+.Lround14_store:
+	sw	t5, 0x34(t3)
+	sync
+	li	t0, 10000
+.Lround14_wrdy3:
+	lw	t4, 0x00(t3)
+	andi	t4, t4, 0x80
+	bnez	t4, .Lround14_verify
+	addiu	t0, t0, -1
+	bnez	t0, .Lround14_wrdy3
+	nop
+	b	.Lround14_retry
+	nop
+
+.Lround14_verify:
+	lw	t4, 0x34(t3)
+	bne	t4, t5, .Lround14_retry
+	nop
+	li	t0, 100000		# allow the RTC write gate to settle
+.Lround14_settle:
+	addiu	t0, t0, -1
+	bnez	t0, .Lround14_settle
+	nop
+	li	v0, 1
+	b	.Lround14_return
+	nop
+
+.Lround14_retry:
+	addiu	t2, t2, -1
+	bnez	t2, .Lround14_attempt
+	nop
+
+.Lround14_return:
+	beqz	t6, .Lround24_irq_restored
+	nop
+	ei
+	irq_enable_hazard
+.Lround24_irq_restored:
+	jr	ra
+	nop
+	.set	pop
+	END(gkd_round14_rtc_stage)
