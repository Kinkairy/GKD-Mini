+static void x1830_volume_osd_render(u32 *pixels, unsigned int percent)
+{
+	char label[16];
+	unsigned int rail_x = 25;
+	unsigned int rail_y = 6;
+	unsigned int rail_width = 82;
+	unsigned int filled_width = rail_width * percent / 100;
+	unsigned int label_width;
+	unsigned int label_x;
+
+	memset(pixels, 0, X1830_VOLUME_OSD_SIZE);
+	x1830_volume_osd_fill_rounded(pixels, 0, 0,
+		X1830_VOLUME_OSD_WIDTH, X1830_VOLUME_OSD_HEIGHT,
+		X1830_ARGB8888(255, 18, 22, 28));
