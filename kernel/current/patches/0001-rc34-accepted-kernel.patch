+	.resume = es8323_component_resume,
+	.controls = es8323_controls,
+	.num_controls = ARRAY_SIZE(es8323_controls),
+	.dapm_widgets = es8323_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(es8323_widgets),
+	.dapm_routes = es8323_routes,
+	.num_dapm_routes = ARRAY_SIZE(es8323_routes),
+	.use_pmdown_time = 1,
+	.endianness = 1,
+};
