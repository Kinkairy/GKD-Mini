+				  unsigned int y, unsigned int width,
+				  unsigned int height, u32 color)
+{
+	unsigned int row;
+	unsigned int column;
+
+	if (x >= X1830_VOLUME_OSD_WIDTH || y >= X1830_VOLUME_OSD_HEIGHT)
+		return;
+	width = min(width, X1830_VOLUME_OSD_WIDTH - x);
+	height = min(height, X1830_VOLUME_OSD_HEIGHT - y);
+	for (row = 0; row < height; ++row)
+		for (column = 0; column < width; ++column)
+			pixels[(y + row) * X1830_VOLUME_OSD_WIDTH + x + column] =
+				color;
+}
+
+static void x1830_volume_osd_fill_rounded(u32 *pixels, unsigned int x,
+					  unsigned int y, unsigned int width,
+					  unsigned int height, u32 color)
+{
+	if (width < 5 || height < 5) {
+		x1830_volume_osd_fill(pixels, x, y, width, height, color);
+		return;
+	}
+	x1830_volume_osd_fill(pixels, x + 2, y, width - 4, height, color);
+	x1830_volume_osd_fill(pixels, x, y + 2, width, height - 4, color);
+	x1830_volume_osd_fill(pixels, x + 1, y + 1, width - 2, height - 2,
+			      color);
+}
