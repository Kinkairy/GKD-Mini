+	fill = (fb->power_osd_percent * 7U + 99U) / 100U;
+	if (fill)
+		x1830_menu_rect(fb, 227, 214, fill, 4, accent);
+	x1830_battery_label_render(fb, 244, 212, text);
+	percent_x = 244 + fb->battery_label.width +
+		(fb->battery_label.width ? 3 : 0);
+	scnprintf(percent, sizeof(percent), "%u%%", fb->power_osd_percent);
+	x1830_menu_text(fb, percent_x, 214, percent, text);
+}
