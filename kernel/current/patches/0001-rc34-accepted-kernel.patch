+static int x1830_fb_get_resources(struct platform_device *pdev, struct x1830_fb *fb)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	int ret;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+	if (resource_size(res) < X1830_DPU_TFT_STATUS + sizeof(u32))
+		return dev_err_probe(dev, -EINVAL, "DPU MMIO resource is too small\n");
+
+	fb->regs = devm_ioremap_resource(dev, res);
+	if (IS_ERR(fb->regs))
+		return PTR_ERR(fb->regs);
+
+	fb->clk = devm_clk_get(dev, "lcd");
+	if (IS_ERR(fb->clk)) {
+		ret = PTR_ERR(fb->clk);
+		if (ret == -EPROBE_DEFER)
+			return ret;
+		if (ret != -ENOENT && ret != -EINVAL)
+			return dev_err_probe(dev, ret, "failed to get LCD clock\n");
+		fb->clk = devm_clk_get(dev, NULL);
+		if (IS_ERR(fb->clk))
+			return dev_err_probe(dev, PTR_ERR(fb->clk),
+					     "failed to get LCD clock\n");
+	}
+
+	fb->ahb_clk = devm_clk_get(dev, "ahb");
+	if (IS_ERR(fb->ahb_clk))
+		return dev_err_probe(dev, PTR_ERR(fb->ahb_clk),
+				     "failed to get AHB clock\n");
+
+	fb->power_gpio = devm_gpiod_get(dev, "power", GPIOD_OUT_LOW);
+	if (IS_ERR(fb->power_gpio))
+		return dev_err_probe(dev, PTR_ERR(fb->power_gpio),
+				     "failed to get panel power GPIO\n");
+	fb->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(fb->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(fb->reset_gpio),
+				     "failed to get panel reset GPIO\n");
+	fb->panel_data_gpio = devm_gpiod_get(dev, "panel-data", GPIOD_OUT_LOW);
+	if (IS_ERR(fb->panel_data_gpio))
+		return dev_err_probe(dev, PTR_ERR(fb->panel_data_gpio),
+				     "failed to get panel data GPIO\n");
+	fb->panel_clock_gpio = devm_gpiod_get(dev, "panel-clock", GPIOD_OUT_HIGH);
+	if (IS_ERR(fb->panel_clock_gpio))
+		return dev_err_probe(dev, PTR_ERR(fb->panel_clock_gpio),
+				     "failed to get panel clock GPIO\n");
+	fb->panel_enable_gpio = devm_gpiod_get(dev, "panel-enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(fb->panel_enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(fb->panel_enable_gpio),
+				     "failed to get panel enable GPIO\n");
+
+	fb->pwm = devm_pwm_get(dev, NULL);
+	if (IS_ERR(fb->pwm))
+		return dev_err_probe(dev, PTR_ERR(fb->pwm),
+				     "failed to get panel PWM\n");
+
+	fb->irq = platform_get_irq(pdev, 0);
+	if (fb->irq < 0)
+		return fb->irq;
+
+	ret = devm_request_irq(dev, fb->irq, x1830_fb_irq, 0,
+			       dev_name(dev), fb);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request DPU IRQ\n");
+
+	return 0;
+}
+
+static int x1830_fb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct fb_info *info;
+	struct x1830_fb *fb;
+	struct backlight_properties backlight_properties;
+	unsigned long actual_rate;
+	int ret;
+
+	info = framebuffer_alloc(sizeof(*fb), dev);
+	if (!info)
+		return -ENOMEM;
+
+	fb = info->par;
+	fb->dev = dev;
+	fb->info = info;
+	mutex_init(&fb->backlight_lock);
+	mutex_init(&fb->volume_osd_lock);
+	INIT_DELAYED_WORK(&fb->composite_work, x1830_composite_refresh_work);
+	INIT_DELAYED_WORK(&fb->volume_osd_clear_work,
+			  x1830_volume_osd_clear_work);
+	platform_set_drvdata(pdev, info);
+
+	ret = x1830_fb_get_resources(pdev, fb);
+	if (ret)
+		goto err_release_info;
+
+	ret = dma_coerce_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		goto err_release_info;
+
+	memset(&backlight_properties, 0, sizeof(backlight_properties));
+	backlight_properties.type = BACKLIGHT_RAW;
+	backlight_properties.max_brightness = X1830_PANEL_MAX_BRIGHTNESS;
+	backlight_properties.brightness = X1830_PANEL_DEFAULT_BRIGHTNESS;
+	fb->backlight = devm_backlight_device_register(dev, "gkd350-backlight",
+						       dev, fb,
+						       &x1830_backlight_ops,
+						       &backlight_properties);
+	if (IS_ERR(fb->backlight)) {
+		ret = dev_err_probe(dev, PTR_ERR(fb->backlight),
+				    "failed to register panel backlight\n");
+		goto err_release_info;
+	}
+
+	fb->fb_virt = dma_alloc_coherent(dev, X1830_FB_SIZE, &fb->fb_dma,
+					 GFP_KERNEL);
+	if (!fb->fb_virt) {
+		ret = -ENOMEM;
+		goto err_release_info;
+	}
+
+	fb->volume_osd_virt = dma_alloc_coherent(dev,
+		X1830_VOLUME_OSD_SIZE, &fb->volume_osd_dma, GFP_KERNEL);
+	if (!fb->volume_osd_virt) {
+		ret = -ENOMEM;
+		goto err_free_fb;
+	}
+
+	fb->menu_osd_virt = dma_alloc_coherent(dev, X1830_MENU_SIZE, &fb->menu_osd_dma, GFP_KERNEL);
+	if (!fb->menu_osd_virt) {
+		ret = -ENOMEM;
+		goto err_free_osd;
+	}
+	/* Descriptor setup enables layer1 before userspace has written it. */
+	memset(fb->menu_osd_virt, 0, X1830_MENU_SIZE);
+	fb->status_text_x = X1830_STATUS_TEXT_X_DEFAULT;
+	fb->status_text_y = X1830_STATUS_TEXT_Y_DEFAULT;
+	fb->status_icon_x = X1830_STATUS_ICON_X_DEFAULT;
+	fb->status_icon_y = X1830_STATUS_ICON_Y_DEFAULT;
+	fb->status_icon_width = X1830_STATUS_ICON_WIDTH_DEFAULT;
+	fb->status_icon_height = X1830_STATUS_ICON_HEIGHT_DEFAULT;
+	fb->latest_scanout_addr = lower_32_bits(fb->fb_dma);
+	dma_wmb();
+
+	fb->composite_virt = dma_alloc_coherent(dev, X1830_COMPOSITE_SIZE,
+		&fb->composite_dma, GFP_KERNEL);
+	if (!fb->composite_virt) {
+		ret = -ENOMEM;
+		goto err_free_menu;
+	}
+	memset(fb->composite_virt, 0, X1830_COMPOSITE_SIZE);
+	fb->composite_source_addr = lower_32_bits(fb->fb_dma);
+
+	fb->snapshot_virt = vzalloc(X1830_FB_FRAME_SIZE);
+	if (!fb->snapshot_virt) {
+		ret = -ENOMEM;
+		goto err_free_composite;
+	}
+
+	fb->usb_debug_frozen_virt = vzalloc(X1830_FB_FRAME_SIZE);
+	if (!fb->usb_debug_frozen_virt) {
+		ret = -ENOMEM;
+		goto err_free_snapshot;
+	}
+
+	fb->descs = dma_alloc_coherent(dev, sizeof(*fb->descs), &fb->descs_dma,
+				       GFP_KERNEL);
+	if (!fb->descs) {
+		ret = -ENOMEM;
+		goto err_free_debug_frozen;
+	}
+
+	x1830_fb_clear_scanout(fb);
+	memset(fb->volume_osd_virt, 0, X1830_VOLUME_OSD_SIZE);
+	ret = x1830_fb_setup_descriptors(fb);
+	if (ret)
+		goto err_free_descs;
+
+	info->fbops = &x1830_fb_ops;
+	info->var = x1830_fb_var;
+	info->fix = x1830_fb_fix;
+	info->fix.smem_start = (unsigned long)fb->fb_dma;
+	info->fix.smem_len = X1830_FB_SIZE;
+	info->screen_base = (char __iomem *)fb->fb_virt;
+	info->screen_size = X1830_FB_SIZE;
+	info->pseudo_palette = fb->pseudo_palette;
+	info->flags = FBINFO_DEFAULT;
+
+	ret = clk_set_rate(fb->clk, X1830_FB_PIXEL_CLOCK_HZ);
+	if (ret) {
+		dev_err(dev, "failed to set LCD clock: %d\n", ret);
+		goto err_free_descs;
+	}
+	ret = clk_prepare_enable(fb->ahb_clk);
+	if (ret) {
+		dev_err(dev, "failed to enable AHB clock: %d\n", ret);
+		goto err_free_descs;
+	}
+	ret = clk_prepare_enable(fb->clk);
+	if (ret) {
+		dev_err(dev, "failed to enable LCD clock: %d\n", ret);
+		goto err_disable_ahb_clk;
+	}
+	actual_rate = clk_get_rate(fb->clk);
+	if (actual_rate != X1830_FB_PIXEL_CLOCK_HZ)
+		dev_warn(dev, "LCD clock is %lu Hz, requested %lu Hz\n",
+			 actual_rate, X1830_FB_PIXEL_CLOCK_HZ);
+	dev_info(dev, "Round31 enabled AHB1 and corrected LCD gate\n");
+
+	ret = x1830_fb_apply_backlight(fb,
+		fb->backlight->props.brightness, false);
+	if (ret) {
+		dev_err(dev, "failed to disable panel PWM: %d\n", ret);
+		goto err_disable_clk;
+	}
+
+	ret = x1830_fb_start_dpu(fb);
+	if (ret)
+		goto err_disable_clk;
+
+	ret = x1830_fb_panel_power_on(fb);
+	if (ret)
+		goto err_stop_dpu;
+
+	ret = register_framebuffer(info);
+	if (ret) {
+		dev_err(dev, "failed to register framebuffer: %d\n", ret);
+		goto err_power_off;
+	}
+	ret = device_create_file(info->dev, &dev_attr_gkd_runtime_id);
+	if (ret) {
+		dev_err(dev, "failed to create gkd_runtime_id: %d\n", ret);
+		goto err_unregister_framebuffer;
+	}
+	ret = device_create_file(info->dev, &dev_attr_gkd_resume_state);
+	if (ret) {
+		dev_err(dev, "failed to create gkd_resume_state: %d\n", ret);
+		goto err_remove_runtime_id;
+	}
+	ret = device_create_file(info->dev, &dev_attr_gkd_volume_osd);
+	if (ret) {
+		dev_err(dev, "failed to create gkd_volume_osd: %d\n", ret);
+		goto err_remove_resume_state;
+	}
+	ret = device_create_file(info->dev, &dev_attr_gkd_brightness_osd);
+	if (ret) {
+		dev_err(dev, "failed to create gkd_brightness_osd: %d\n", ret);
+		goto err_remove_volume_osd;
+	}
+	ret = device_create_file(info->dev, &dev_attr_gkd_notification);
+	if (ret) {
+		dev_err(dev, "failed to create gkd_notification: %d\n", ret);
+		goto err_remove_brightness_osd;
+	}
+	ret = device_create_file(info->dev, &dev_attr_gkd_usb_menu);
+	if (ret) {
+		dev_err(dev, "failed to create gkd_usb_menu: %d\n", ret);
+		goto err_remove_notification;
+	}
+	ret = device_create_file(info->dev, &dev_attr_gkd_network_status);
+	if (ret) {
+		dev_err(dev, "failed to create gkd_network_status: %d\n", ret);
+		goto err_remove_usb_menu;
+	}
+	ret = device_create_file(info->dev, &dev_attr_gkd_power_osd);
+	if (ret) {
+		dev_err(dev, "failed to create gkd_power_osd: %d\n", ret);
+		goto err_remove_network_status;
+	}
+	ret = sysfs_create_bin_file(&info->dev->kobj, &bin_attr_gkd_battery_label);
+	if (ret) {
+		dev_err(dev, "failed to create gkd_battery_label: %d\n", ret);
+		goto err_remove_power_osd;
+	}
+	ret = sysfs_create_bin_file(&info->dev->kobj,
+				    &bin_attr_gkd_snapshot_rgb565);
+	if (ret) {
+		dev_err(dev, "failed to create gkd_snapshot_rgb565: %d\n", ret);
+		goto err_remove_battery_label;
+	}
+
+	if (WARN_ON(READ_ONCE(x1830_fb_syscore))) {
+		ret = -EBUSY;
+		goto err_remove_snapshot;
+	}
+	WRITE_ONCE(x1830_fb_syscore, fb);
+	register_syscore_ops(&x1830_fb_syscore_ops);
+
+	dev_info(dev, "registered gkd350-backlight at %u percent\n",
+		 fb->backlight->props.brightness);
+
+	dev_info(dev,
+		 "registered fb%d, 320x240 RGB565 double buffer at %pad, clock %lu Hz\n",
+		 info->node, &fb->fb_dma, actual_rate);
+	dev_info(dev,
+		 "userspace mmap cache mode: XBurst write-combine (_CACHE_CACHABLE_WA)\n");
+	dev_info(dev,
+		 "Round81 bilingual USB mode UI with compact CJK subset\n");
+	return 0;
+
+err_remove_snapshot:
+	sysfs_remove_bin_file(&info->dev->kobj,
+			      &bin_attr_gkd_snapshot_rgb565);
+err_remove_battery_label:
+	sysfs_remove_bin_file(&info->dev->kobj, &bin_attr_gkd_battery_label);
+err_remove_power_osd:
+	device_remove_file(info->dev, &dev_attr_gkd_power_osd);
+err_remove_network_status:
+	device_remove_file(info->dev, &dev_attr_gkd_network_status);
+err_remove_usb_menu:
+	device_remove_file(info->dev, &dev_attr_gkd_usb_menu);
+err_remove_notification:
+	device_remove_file(info->dev, &dev_attr_gkd_notification);
+err_remove_brightness_osd:
+	device_remove_file(info->dev, &dev_attr_gkd_brightness_osd);
+err_remove_volume_osd:
+	device_remove_file(info->dev, &dev_attr_gkd_volume_osd);
+err_remove_resume_state:
+	device_remove_file(info->dev, &dev_attr_gkd_resume_state);
+err_remove_runtime_id:
+	device_remove_file(info->dev, &dev_attr_gkd_runtime_id);
+err_unregister_framebuffer:
+	unregister_framebuffer(info);
+err_power_off:
+	x1830_fb_panel_power_off(fb);
+err_stop_dpu:
+	if (x1830_fb_stop_dpu(fb))
+		dev_warn(dev, "timed out stopping DPU during probe cleanup\n");
+	cancel_delayed_work_sync(&fb->composite_work);
+err_disable_clk:
+	clk_disable_unprepare(fb->clk);
+err_disable_ahb_clk:
+	clk_disable_unprepare(fb->ahb_clk);
+err_free_descs:
+	dma_free_coherent(dev, sizeof(*fb->descs), fb->descs, fb->descs_dma);
+err_free_debug_frozen:
+	vfree(fb->usb_debug_frozen_virt);
+err_free_snapshot:
+	vfree(fb->snapshot_virt);
+err_free_composite:
+	dma_free_coherent(dev, X1830_COMPOSITE_SIZE, fb->composite_virt,
+			  fb->composite_dma);
+err_free_menu:
+	dma_free_coherent(dev, X1830_MENU_SIZE, fb->menu_osd_virt, fb->menu_osd_dma);
+err_free_osd:
+	dma_free_coherent(dev, X1830_VOLUME_OSD_SIZE,
+			  fb->volume_osd_virt, fb->volume_osd_dma);
+err_free_fb:
+	dma_free_coherent(dev, X1830_FB_SIZE, fb->fb_virt, fb->fb_dma);
+err_release_info:
+	platform_set_drvdata(pdev, NULL);
+	framebuffer_release(info);
+	return ret;
+}
+
+static int x1830_fb_remove(struct platform_device *pdev)
+{
+	struct fb_info *info = platform_get_drvdata(pdev);
+	struct x1830_fb *fb = info->par;
+
+	unregister_syscore_ops(&x1830_fb_syscore_ops);
+	WRITE_ONCE(x1830_fb_syscore, NULL);
+	mutex_lock(&fb->volume_osd_lock);
+	fb->volume_osd_removing = true;
+	mutex_unlock(&fb->volume_osd_lock);
+	sysfs_remove_bin_file(&info->dev->kobj,
+			      &bin_attr_gkd_snapshot_rgb565);
+	sysfs_remove_bin_file(&info->dev->kobj, &bin_attr_gkd_battery_label);
+	device_remove_file(info->dev, &dev_attr_gkd_resume_state);
+	device_remove_file(info->dev, &dev_attr_gkd_runtime_id);
+	device_remove_file(info->dev, &dev_attr_gkd_power_osd);
+	device_remove_file(info->dev, &dev_attr_gkd_network_status);
+	device_remove_file(info->dev, &dev_attr_gkd_usb_menu);
+	device_remove_file(info->dev, &dev_attr_gkd_notification);
+	device_remove_file(info->dev, &dev_attr_gkd_brightness_osd);
+	device_remove_file(info->dev, &dev_attr_gkd_volume_osd);
+	cancel_delayed_work_sync(&fb->volume_osd_clear_work);
+	mutex_lock(&fb->volume_osd_lock);
+	x1830_volume_osd_clear_locked(fb);
+	mutex_unlock(&fb->volume_osd_lock);
+	unregister_framebuffer(info);
+	disable_irq(fb->irq);
+	cancel_delayed_work_sync(&fb->composite_work);
+	x1830_fb_panel_power_off(fb);
+	if (x1830_fb_stop_dpu(fb))
+		dev_warn(fb->dev, "timed out stopping DPU\n");
+	clk_disable_unprepare(fb->clk);
+	clk_disable_unprepare(fb->ahb_clk);
+	dma_free_coherent(fb->dev, sizeof(*fb->descs), fb->descs,
+			  fb->descs_dma);
+	vfree(fb->usb_debug_frozen_virt);
+	vfree(fb->snapshot_virt);
+	dma_free_coherent(fb->dev, X1830_COMPOSITE_SIZE, fb->composite_virt,
+			  fb->composite_dma);
+	dma_free_coherent(fb->dev, X1830_MENU_SIZE, fb->menu_osd_virt, fb->menu_osd_dma);
+	dma_free_coherent(fb->dev, X1830_VOLUME_OSD_SIZE,
+			  fb->volume_osd_virt, fb->volume_osd_dma);
+	dma_free_coherent(fb->dev, X1830_FB_SIZE, fb->fb_virt, fb->fb_dma);
+	platform_set_drvdata(pdev, NULL);
+	framebuffer_release(info);
+	return 0;
+}
+
+/* The DPU stays active at the ordinary device PM boundary, as in jz_fb_v14. */
+
+static const struct of_device_id x1830_fb_of_match[] = {
+	{ .compatible = "gamekiddy,gkd350-x1830-dpu-fb" },
+	{ .compatible = "ingenic,x1830-dpu-fb" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, x1830_fb_of_match);
+
+static struct platform_driver x1830_fb_driver = {
+	.probe = x1830_fb_probe,
+	.remove = x1830_fb_remove,
+	.driver = {
+		.name = "x1830-dpu-fb",
+		.of_match_table = x1830_fb_of_match,
+	},
+};
+module_platform_driver(x1830_fb_driver);
