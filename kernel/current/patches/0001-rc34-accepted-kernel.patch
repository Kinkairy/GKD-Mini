+	{ 12288000, 32000,  384, 0x03, 0 },
+	{ 18432000, 32000,  576, 0x05, 0 },
+	{ 12000000, 32000,  375, 0x04, 1 },
+	{ 11289600, 44100,  256, 0x02, 0 },
+	{ 16934400, 44100,  384, 0x03, 0 },
+	{ 12000000, 44100,  272, 0x03, 1 },
+	{ 12288000, 48000,  256, 0x02, 0 },
+	{ 18432000, 48000,  384, 0x03, 0 },
+	{ 12000000, 48000,  250, 0x02, 1 },
+	{ 11289600, 88200,  128, 0x00, 0 },
+	{ 16934400, 88200,  192, 0x01, 0 },
+	{ 12000000, 88200,  136, 0x01, 1 },
+	{ 12288000, 96000,  128, 0x00, 0 },
+	{ 18432000, 96000,  192, 0x01, 0 },
+	{ 12000000, 96000,  125, 0x00, 1 },
+};
+
+static const struct reg_default es8323_reg_defaults[] = {
+	{ 0x00, 0x06 }, { 0x01, 0x1c }, { 0x02, 0xc3 }, { 0x03, 0xfc },
+	{ 0x04, 0xc0 }, { 0x05, 0x00 }, { 0x06, 0x00 }, { 0x07, 0x7c },
+	{ 0x08, 0x80 }, { 0x09, 0x00 }, { 0x0a, 0x00 }, { 0x0b, 0x06 },
+	{ 0x0c, 0x00 }, { 0x0d, 0x06 }, { 0x0e, 0x30 }, { 0x0f, 0x30 },
+	{ 0x10, 0xc0 }, { 0x11, 0xc0 }, { 0x12, 0x38 }, { 0x13, 0xb0 },
+	{ 0x14, 0x32 }, { 0x15, 0x06 }, { 0x16, 0x00 }, { 0x17, 0x00 },
+	{ 0x18, 0x06 }, { 0x19, 0x30 }, { 0x1a, 0xc0 }, { 0x1b, 0xc0 },
+	{ 0x1c, 0x08 }, { 0x1d, 0x06 }, { 0x1e, 0x1f }, { 0x1f, 0xf7 },
+	{ 0x20, 0xfd }, { 0x21, 0xff }, { 0x22, 0x1f }, { 0x23, 0xf7 },
+	{ 0x24, 0xfd }, { 0x25, 0xff }, { 0x26, 0x00 }, { 0x27, 0x38 },
+	{ 0x28, 0x38 }, { 0x29, 0x38 }, { 0x2a, 0x38 }, { 0x2b, 0x38 },
+	{ 0x2c, 0x38 }, { 0x2d, 0x00 }, { 0x2e, 0x00 }, { 0x2f, 0x00 },
+	{ 0x30, 0x00 }, { 0x31, 0x00 }, { 0x32, 0x00 }, { 0x33, 0x00 },
+	{ 0x34, 0x00 }, { 0x35, 0x00 }, { 0x36, 0x00 }, { 0x37, 0x00 },
+};
+
+struct es8323_priv {
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *speaker_enable;
+	struct gpio_desc *headphone_detect;
+	struct mutex lock;
+	unsigned int sysclk;
+	bool muted;
+	bool round46_hw_params_logged;
+};
+
+struct es8323_reg_sequence {
+	u8 reg;
+	u8 value;
+	unsigned int delay_us;
+};
+
+static const struct es8323_reg_sequence es8323_init_sequence[] = {
+	{ 0x00, 0x80 }, { 0x00, 0x00, 19000 },
+	{ 0x02, 0xf3 }, { 0x2b, 0x80 }, { 0x08, 0x00 },
+	{ 0x00, 0x35 }, { 0x01, 0x50 }, { 0x03, 0x59 },
+	{ 0x05, 0x00 }, { 0x06, 0x00 }, { 0x07, 0x7c },
+	{ 0x09, 0x88 }, { 0x0a, 0xf0 }, { 0x0b, 0x82 },
+	{ 0x0c, 0x4c }, { 0x0d, 0x02 }, { 0x10, 0x00 },
+	{ 0x11, 0x00 }, { 0x12, 0xea }, { 0x13, 0xc0 },
+	{ 0x14, 0x05 }, { 0x15, 0x06 }, { 0x16, 0x53 },
+	{ 0x17, 0x18 }, { 0x18, 0x02 }, { 0x1a, 0x0a },
+	{ 0x1b, 0x0a }, { 0x26, 0x12 }, { 0x27, 0xb8 },
+	{ 0x28, 0x38 }, { 0x29, 0x38 }, { 0x2a, 0xb8 },
+	{ 0x02, 0x00 }, { 0x19, 0x02 }, { 0x04, 0x0c, 19000 },
+	{ 0x2e, 0x00 }, { 0x2f, 0x00 }, { 0x30, 0x08 },
+	{ 0x31, 0x08, 19000 }, { 0x30, 0x0f }, { 0x31, 0x0f, 19000 },
+	{ 0x30, 0x18 }, { 0x31, 0x18, 19000 }, { 0x04, 0x2c },
+	{ 0x07, 0x7c }, { 0x05, 0x00 }, { 0x06, 0x00 },
+	{ 0x02, 0x00 }, { 0x03, 0x59 },
+};
+
+static int es8323_write_sequence(struct es8323_priv *es8323)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(es8323_init_sequence); i++) {
+		ret = regmap_write(es8323->regmap, es8323_init_sequence[i].reg,
+				   es8323_init_sequence[i].value);
+		if (ret)
+			return ret;
+
+		if (es8323_init_sequence[i].delay_us)
+			usleep_range(es8323_init_sequence[i].delay_us,
+				     es8323_init_sequence[i].delay_us + 2000);
+	}
+
+	return 0;
+}
+
+static void es8323_update_speaker(struct es8323_priv *es8323)
+{
+	bool headphones = false;
+
+	if (es8323->headphone_detect)
+		headphones = gpiod_get_value_cansleep(es8323->headphone_detect);
+
+	if (es8323->speaker_enable)
+		gpiod_set_value_cansleep(es8323->speaker_enable,
+					 !headphones);
+}
+
+static irqreturn_t es8323_headphone_irq(int irq, void *data)
+{
+	struct es8323_priv *es8323 = data;
+
+	mutex_lock(&es8323->lock);
+	es8323_update_speaker(es8323);
+	mutex_unlock(&es8323->lock);
+
+	return IRQ_HANDLED;
+}
+
+static int es8323_find_coeff(unsigned int mclk, unsigned int rate)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(es8323_coeffs); i++)
+		if (es8323_coeffs[i].mclk == mclk &&
+		    es8323_coeffs[i].rate == rate)
+			return i;
+
+	return -EINVAL;
+}
+
+static int es8323_set_sysclk(struct snd_soc_dai *dai, int clk_id,
+			     unsigned int freq, int dir)
+{
+	struct es8323_priv *es8323 = snd_soc_component_get_drvdata(dai->component);
+	unsigned long actual = clk_get_rate(es8323->mclk);
+
+	if (freq && actual && freq != actual)
+		return -EINVAL;
+
+	es8323->sysclk = freq ? freq : actual;
+	return 0;
+}
+
+static int es8323_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct snd_soc_component *component = dai->component;
+	unsigned int iface = 0;
+	unsigned int adciface = 0;
+	unsigned int daciface = 0;
+
+	switch (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_CBC_CFC:
+		break;
+	case SND_SOC_DAIFMT_CBP_CFP:
+		iface |= ES8323_IFACE_MASTER;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if ((fmt & SND_SOC_DAIFMT_FORMAT_MASK) != SND_SOC_DAIFMT_I2S)
+		return -EINVAL;
+
+	if ((fmt & SND_SOC_DAIFMT_INV_MASK) != SND_SOC_DAIFMT_NB_NF)
+		return -EINVAL;
+
+	snd_soc_component_update_bits(component, ES8323_IFACE,
+				      ES8323_IFACE_MASTER |
+				      ES8323_IFACE_BCLK_INV, iface);
+	snd_soc_component_update_bits(component, ES8323_ADC_IFACE,
+				      ES8323_ADC_FMT_MASK | BIT(5), adciface);
+	snd_soc_component_update_bits(component, ES8323_DAC_IFACE,
+				      ES8323_DAC_FMT_MASK |
+				      ES8323_DAC_LRCLK_INV, daciface);
+
+	return 0;
+}
+
+static void es8323_round46_hw_readback(struct snd_soc_component *component)
+{
+	struct es8323_priv *es8323 = snd_soc_component_get_drvdata(component);
+	unsigned int reg08 = 0, reg0c = 0, reg0d = 0;
+	unsigned int reg17 = 0, reg18 = 0, reg19 = 0;
+	int ret;
+
+	if (es8323->round46_hw_params_logged)
+		return;
+	es8323->round46_hw_params_logged = true;
+
+	regcache_cache_bypass(es8323->regmap, true);
+	ret = regmap_read(es8323->regmap, ES8323_IFACE, &reg08);
+	if (!ret)
+		ret = regmap_read(es8323->regmap, ES8323_ADC_IFACE, &reg0c);
+	if (!ret)
+		ret = regmap_read(es8323->regmap, ES8323_ADCCONTROL5, &reg0d);
+	if (!ret)
+		ret = regmap_read(es8323->regmap, ES8323_DAC_IFACE, &reg17);
+	if (!ret)
+		ret = regmap_read(es8323->regmap, ES8323_DACCONTROL2, &reg18);
+	if (!ret)
+		ret = regmap_read(es8323->regmap, ES8323_DACCONTROL3, &reg19);
+	regcache_cache_bypass(es8323->regmap, false);
+
+	if (ret)
+		dev_warn(component->dev,
+			 "GKD Round46 ES8323 hardware readback failed: %d\n", ret);
+	else
+		dev_info(component->dev,
+			 "GKD Round46 ES8323 hardware readback: "
+			 "08=%02x 0c=%02x 0d=%02x 17=%02x 18=%02x 19=%02x\n",
+			 reg08, reg0c, reg0d, reg17, reg18, reg19);
+}
+
+static int es8323_hw_params(struct snd_pcm_substream *substream,
+			    struct snd_pcm_hw_params *params,
+			    struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *component = dai->component;
+	struct es8323_priv *es8323 = snd_soc_component_get_drvdata(component);
+	unsigned int sysclk = es8323->sysclk ?: clk_get_rate(es8323->mclk);
+	unsigned int iface = 0;
+	unsigned int rate_coeff;
+	int coeff;
+
+	if (params_format(params) != SNDRV_PCM_FORMAT_S16_LE)
+		return -EINVAL;
+
+	coeff = es8323_find_coeff(sysclk, params_rate(params));
+	if (coeff < 0) {
+		coeff = es8323_find_coeff(sysclk / 2, params_rate(params));
+		if (coeff >= 0)
+			iface = ES8323_IFACE_MCLKDIV2;
+	}
+	if (coeff < 0) {
+		dev_err(component->dev,
+			"unsupported rate %u with %u Hz MCLK\n",
+			params_rate(params), sysclk);
+		return coeff;
+	}
+
+	rate_coeff = es8323_coeffs[coeff].sr |
+		     (es8323_coeffs[coeff].usb << 4);
+	snd_soc_component_update_bits(component, ES8323_IFACE,
+				      ES8323_IFACE_MCLKDIV2, iface);
+	snd_soc_component_update_bits(component, ES8323_ADC_IFACE,
+				      ES8323_ADC_WORDLEN_MASK, 3 << 2);
+	snd_soc_component_update_bits(component, ES8323_DAC_IFACE,
+				      ES8323_DAC_WORDLEN_MASK, 3 << 3);
+	snd_soc_component_write(component, ES8323_ADCCONTROL5, rate_coeff);
+	snd_soc_component_write(component, ES8323_DACCONTROL2, rate_coeff);
+	es8323_round46_hw_readback(component);
+
+	return 0;
+}
+
+static int es8323_mute_stream(struct snd_soc_dai *dai, int mute, int stream)
+{
+	struct es8323_priv *es8323 = snd_soc_component_get_drvdata(dai->component);
+	int ret;
+
+	mutex_lock(&es8323->lock);
+	es8323->muted = mute;
+
+	if (mute) {
+		usleep_range(18000, 20000);
+		ret = regmap_write(es8323->regmap, ES8323_DACCONTROL3, 0x06);
+	} else {
+		ret = regmap_write(es8323->regmap, ES8323_DACCONTROL3, 0x02);
+		if (!ret)
+			ret = regmap_write(es8323->regmap, ES8323_LOUT2VOL, 0x1e);
+		if (!ret)
+			ret = regmap_write(es8323->regmap, ES8323_ROUT2VOL, 0x1e);
+		if (!ret) {
+			msleep(50);
+			usleep_range(18000, 20000);
+		}
+	}
+
+	mutex_unlock(&es8323->lock);
+	return ret;
+}
+
