+				#endif
+			#endif
 			#ifdef CONFIG_MACH_X1000
+				{
 				ingenic_pm_init_x1000();
 				pm_power_off = ingenic_pm_poweroff_x1000;
+				}
 			#endif
 		#endif
 
diff --git a/arch/mips/ingenic/pm_x1830.c b/arch/mips/ingenic/pm_x1830.c
new file mode 100644
index 0000000000000000000000000000000000000000..88d68e609f2963e5bf9d3b3895981e7805130a1b
--- /dev/null
+++ b/arch/mips/ingenic/pm_x1830.c
@@ -0,0 +1,260 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* X1830 suspend-to-RAM sequence recovered from the GKD vendor kernel. */
+
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/printk.h>
+#include <linux/smp.h>
+
+#include <asm/barrier.h>
+#include <asm/cpu-info.h>
+#include <asm/io.h>
+#include <asm/mipsregs.h>
+
+#include "regs.h"
+
+extern void ingenic_x1830_ddr_sleep(unsigned long waysize,
+				      unsigned int ways,
+				      unsigned int waybit,
+				      u32 scache_geometry);
+
+struct x1830_pm_registers {
+	u32 lcr;
+	u32 opcr;
+};
+
+#define X1830_I2C1_BASE		((void __iomem *)0xb0051000UL)
+#define X1830_I2C_TAR		0x04
+#define X1830_I2C_DC		0x10
+#define X1830_I2C_INTST		0x2c
+#define X1830_I2C_INTM		0x30
+#define X1830_I2C_RXTL		0x38
+#define X1830_I2C_TXTL		0x3c
+#define X1830_I2C_CINTR		0x40
+#define X1830_I2C_CTXABRT	0x54
+#define X1830_I2C_ENB		0x6c
+#define X1830_I2C_STA		0x70
+#define X1830_I2C_TXABRT	0x80
+#define X1830_I2C_ENSTA		0x9c
+
+#define X1830_I2C_STA_MSTACT	BIT(5)
+#define X1830_I2C_STA_RFNE	BIT(3)
+#define X1830_I2C_STA_TFE	BIT(2)
+#define X1830_I2C_STA_TFNF	BIT(1)
+#define X1830_I2C_DC_READ	BIT(8)
+#define X1830_I2C_DC_STOP	BIT(9)
+#define X1830_I2C_ENABLED	BIT(0)
+
+#define X1830_AXP173_ADDRESS	0x34
+#define X1830_AXP173_IRQ3_STATUS	0x46
+#define X1830_AXP173_PEK_SHORT	BIT(1)
+#define X1830_I2C_POLL_LIMIT	100000U
+
+static struct x1830_pm_registers x1830_pm_saved;
+
+static bool x1830_pm_i2c_idle(u16 status)
+{
+	return (status & (X1830_I2C_STA_TFE | X1830_I2C_STA_TFNF)) ==
+		(X1830_I2C_STA_TFE | X1830_I2C_STA_TFNF) &&
+		!(status & (X1830_I2C_STA_MSTACT | X1830_I2C_STA_RFNE));
+}
+
+static u32 x1830_pm_read_wake_source(void)
+{
+	u32 gpc_flag = readl((void __iomem *)0xb0012050UL);
+	u32 gpc_pin = readl((void __iomem *)0xb0012000UL);
+	u32 source = 0;
+
+	source |= !!(gpc_flag & BIT(26)) << 2;
+	source |= !!(gpc_pin & BIT(26)) << 3;
+
+	return source;
+}
+
+static bool x1830_pm_gpc26_asserted(u32 source)
+{
+	return (source & BIT(2)) && !(source & BIT(3));
+}
+
+static noinline int x1830_pm_read_axp173_irq3(u8 *value)
+{
+	void __iomem *base = X1830_I2C1_BASE;
+	u16 saved_rxtl;
+	u16 saved_tar;
+	u16 saved_txtl;
+	u16 status;
+	u32 loops;
+	int ret = -ETIMEDOUT;
+	bool enabled = false;
+
+	*value = 0;
+	if (!IS_ENABLED(CONFIG_KEYBOARD_GKD_AXP173))
+		return -ENODEV;
+
+	/* The regular driver leaves this controller disabled and interrupt-free. */
+	if ((readw(base + X1830_I2C_ENB) & X1830_I2C_ENABLED) ||
+	    (readw(base + X1830_I2C_ENSTA) & X1830_I2C_ENABLED) ||
+	    readw(base + X1830_I2C_INTM) ||
+	    readw(base + X1830_I2C_INTST) ||
+	    readw(base + X1830_I2C_TXABRT) ||
+	    !x1830_pm_i2c_idle(readw(base + X1830_I2C_STA)))
+		return -EBUSY;
+
+	saved_tar = readw(base + X1830_I2C_TAR);
+	saved_rxtl = readw(base + X1830_I2C_RXTL);
+	saved_txtl = readw(base + X1830_I2C_TXTL);
+
+	writew(X1830_AXP173_ADDRESS, base + X1830_I2C_TAR);
+	writew(X1830_I2C_ENABLED, base + X1830_I2C_ENB);
+	for (loops = X1830_I2C_POLL_LIMIT; loops; loops--) {
+		if (readw(base + X1830_I2C_ENSTA) & X1830_I2C_ENABLED) {
+			enabled = true;
+			break;
+		}
+		cpu_relax();
+	}
+	if (!enabled)
+		goto disable;
+
+	/* Combined pointer write and repeated-start one-byte read with STOP. */
+	writew(X1830_AXP173_IRQ3_STATUS, base + X1830_I2C_DC);
+	writew(X1830_I2C_DC_READ | X1830_I2C_DC_STOP,
+	       base + X1830_I2C_DC);
+	for (loops = X1830_I2C_POLL_LIMIT; loops; loops--) {
+		if (readw(base + X1830_I2C_TXABRT)) {
+			ret = -EIO;
+			goto disable;
+		}
+		status = readw(base + X1830_I2C_STA);
+		if (status & X1830_I2C_STA_RFNE) {
+			*value = readw(base + X1830_I2C_DC) & 0xff;
+			ret = 0;
+			break;
+		}
+		cpu_relax();
+	}
+
+	if (!ret) {
+		ret = -ETIMEDOUT;
+		for (loops = X1830_I2C_POLL_LIMIT; loops; loops--) {
+			status = readw(base + X1830_I2C_STA);
+			if ((status & X1830_I2C_STA_TFE) &&
+			    !(status & X1830_I2C_STA_MSTACT)) {
+				ret = 0;
+				break;
+			}
+			cpu_relax();
+		}
+	}
+	if (!ret && readw(base + X1830_I2C_TXABRT))
+		ret = -EIO;
+
+disable:
+	/* All pending controller state below belongs to this polling transfer. */
+	writew(0, base + X1830_I2C_INTM);
+	if (readw(base + X1830_I2C_TXABRT))
+		(void)readw(base + X1830_I2C_CTXABRT);
+	(void)readw(base + X1830_I2C_CINTR);
+	writew(0, base + X1830_I2C_ENB);
+	for (loops = X1830_I2C_POLL_LIMIT; loops; loops--) {
+		if (!(readw(base + X1830_I2C_ENSTA) & X1830_I2C_ENABLED))
+			break;
+		cpu_relax();
+	}
+	if (!loops)
+		return -EIO;
+
+	writew(saved_tar, base + X1830_I2C_TAR);
+	writew(saved_rxtl, base + X1830_I2C_RXTL);
+	writew(saved_txtl, base + X1830_I2C_TXTL);
+	mb();
+	return ret;
+}
+
+static void x1830_pm_rearm_gpc26(void)
+{
+	/* GPIOC FLAG clear alias, then GPIOC MASK clear alias. */
+	writel(BIT(26), (void __iomem *)0xb0012058UL);
+	writel(BIT(26), (void __iomem *)0xb0012028UL);
+	mb();
+}
+
+void ingenic_pm_init_x1830(void)
+{
+	u32 lcr = readl((void __iomem *)CPM_IOBASE + CPM_LCR);
+	u32 opcr = readl((void __iomem *)CPM_IOBASE + CPM_OPCR);
+
+	/* Exact idle defaults used by the shipping X1830 3.10 kernel. */
+	lcr = (lcr & ~0x3U) | 0x1500U;
+	opcr = (opcr | 0xff00U) & ~BIT(4);
+	writel(lcr, (void __iomem *)CPM_IOBASE + CPM_LCR);
+	writel(opcr, (void __iomem *)CPM_IOBASE + CPM_OPCR);
+}
+
+void ingenic_pm_sleep_x1830(void)
+{
+	u32 lcr = readl((void __iomem *)CPM_IOBASE + CPM_LCR);
+	u32 rejected = 0;
+	u8 axp173_irq3 = 0;
+	int axp173_read_result = -ENODATA;
+	u32 source_accepted;
+	u32 source_post_cpm;
+	u32 source_pack;
+	u32 scache_geometry;
+	u32 opcr = readl((void __iomem *)CPM_IOBASE + CPM_OPCR);
+
+	x1830_pm_saved.lcr = lcr;
+	x1830_pm_saved.opcr = opcr;
+
+	if (current_cpu_data.dcache.linesz != 32 ||
+	    current_cpu_data.scache.linesz != 32 ||
+	    current_cpu_data.scache.waysize != 0x4000 ||
+	    current_cpu_data.scache.ways != 8 ||
+	    current_cpu_data.scache.waybit != 14) {
+		pr_err("x1830-pm: refusing deep suspend for unsupported cache geometry\n");
+		return;
+	}
+
+	scache_geometry = (current_cpu_data.scache.waysize & 0xffffU) |
+		((u32)current_cpu_data.scache.ways << 16) |
+		((u32)current_cpu_data.scache.waybit << 24);
+
+	/* PM_SUSPEND_MEM path from the shipping X1830 kernel. */
+	opcr = (opcr & 0xfeb000e9U) | 0xc18015d4U;
+	lcr = (lcr & ~0x3U) | 0x1U;
+	for (;;) {
+		writel(opcr, (void __iomem *)CPM_IOBASE + CPM_OPCR);
+		writel(lcr, (void __iomem *)CPM_IOBASE + CPM_LCR);
+
+		/* WAIT through the final CPM write is the exact vendor sequence. */
+		ingenic_x1830_ddr_sleep(current_cpu_data.dcache.waysize,
+			current_cpu_data.dcache.ways,
+			current_cpu_data.dcache.waybit, scache_geometry);
+		mb();
+
+		/* DDR/PHY is restored; preserve a real GPC26 latch across CPM. */
+		source_pack = x1830_pm_read_wake_source();
+		mb();
+
+		writel(x1830_pm_saved.lcr,
+		       (void __iomem *)CPM_IOBASE + CPM_LCR);
+		writel(x1830_pm_saved.opcr,
+		       (void __iomem *)CPM_IOBASE + CPM_OPCR);
+		mb();
+
+		source_post_cpm = x1830_pm_read_wake_source();
+		source_accepted = source_pack | source_post_cpm;
+		if (x1830_pm_gpc26_asserted(source_accepted)) {
+			axp173_read_result =
+				x1830_pm_read_axp173_irq3(&axp173_irq3);
+			if (!axp173_read_result &&
+			    (axp173_irq3 & X1830_AXP173_PEK_SHORT))
+				break;
+		}
+		x1830_pm_rearm_gpc26();
+		rejected++;
+	}
+
+	pr_info("x1830-pm-release-0132: short PEK accepted irq3=%02x rejected=%u\n",
+		axp173_irq3, rejected);
+}
diff --git a/arch/mips/ingenic/pm_x1830_core.S b/arch/mips/ingenic/pm_x1830_core.S
new file mode 100644
index 0000000000000000000000000000000000000000..73b62aba64828da16904c47abf00a0caa67a059d
--- /dev/null
+++ b/arch/mips/ingenic/pm_x1830_core.S
@@ -0,0 +1,260 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* DRAM self-refresh core recovered instruction-for-instruction from GKD 3.10. */
+
+#include <asm/asm.h>
+#include <asm/regdef.h>
+
+	.set	noreorder
+	.set	mips32r2
+	.text
+	.align	5
+	.macro	gkd_rtc_stage value
+	li	a0, 0xb0003000
+	li	a3, 3
+.Lrtc_attempt\@:
+	li	a1, 10000
+.Lrtc_wrdy1\@:
+	lw	a2, 0x00(a0)
+	andi	a2, a2, 0x80
+	bnez	a2, .Lrtc_unlock\@
+	 addiu	a1, a1, -1
+	bnez	a1, .Lrtc_wrdy1\@
+	 nop
+	b	.Lrtc_retry\@
+	 nop
+.Lrtc_unlock\@:
+	li	a2, 0x0000a55a
+	sw	a2, 0x3c(a0)
+	sync
+	li	a1, 10000
+.Lrtc_wen\@:
+	lw	a2, 0x3c(a0)
+	srl	a2, a2, 31
+	bnez	a2, .Lrtc_wrdy2_start\@
+	 addiu	a1, a1, -1
+	bnez	a1, .Lrtc_wen\@
+	 nop
+	b	.Lrtc_retry\@
+	 nop
+.Lrtc_wrdy2_start\@:
+	li	a1, 10000
+.Lrtc_wrdy2\@:
+	lw	a2, 0x00(a0)
+	andi	a2, a2, 0x80
+	bnez	a2, .Lrtc_store\@
+	 addiu	a1, a1, -1
+	bnez	a1, .Lrtc_wrdy2\@
+	 nop
+	b	.Lrtc_retry\@
+	 nop
+.Lrtc_store\@:
+	li	a2, (0x52323900 | \value)
+	sw	a2, 0x34(a0)
+	sync
+	li	a1, 10000
+.Lrtc_wrdy3\@:
+	lw	a2, 0x00(a0)
+	andi	a2, a2, 0x80
+	bnez	a2, .Lrtc_verify\@
+	 addiu	a1, a1, -1
+	bnez	a1, .Lrtc_wrdy3\@
+	 nop
+	b	.Lrtc_retry\@
+	 nop
+.Lrtc_verify\@:
+	lw	a2, 0x34(a0)
+	li	a1, (0x52323900 | \value)
+	beq	a2, a1, .Lrtc_done\@
+	 nop
+.Lrtc_retry\@:
+	addiu	a3, a3, -1
+	bnez	a3, .Lrtc_attempt\@
+	 nop
+.Lrtc_done\@:
+	.endm
+
+LEAF(ingenic_x1830_ddr_sleep)
+	move	k0, a3
+	/*
+	 * Match the shipping leaf's final D-cache index writeback/invalidate
+	 * geometry sweep.  No stack, BSS, or external call is touched afterward.
+	 */
+	lui	v1, 0x8000
+	addu	a0, v1, a0
+	li	t0, 1
+	sllv	t0, t0, a2
+	move	v1, zero
+	sllv	a2, a1, a2
+0:
+	lui	v0, 0x8000
+1:
+	or	a3, v1, v0
+	cache	0x1, 0x000(a3)
+	cache	0x1, 0x020(a3)
+	cache	0x1, 0x040(a3)
+	cache	0x1, 0x060(a3)
+	cache	0x1, 0x080(a3)
+	cache	0x1, 0x0a0(a3)
+	cache	0x1, 0x0c0(a3)
+	cache	0x1, 0x0e0(a3)
+	cache	0x1, 0x100(a3)
+	cache	0x1, 0x120(a3)
+	cache	0x1, 0x140(a3)
+	cache	0x1, 0x160(a3)
+	cache	0x1, 0x180(a3)
+	cache	0x1, 0x1a0(a3)
+	cache	0x1, 0x1c0(a3)
+	cache	0x1, 0x1e0(a3)
+	cache	0x1, 0x200(a3)
+	cache	0x1, 0x220(a3)
+	cache	0x1, 0x240(a3)
+	cache	0x1, 0x260(a3)
+	cache	0x1, 0x280(a3)
+	cache	0x1, 0x2a0(a3)
+	cache	0x1, 0x2c0(a3)
+	cache	0x1, 0x2e0(a3)
+	cache	0x1, 0x300(a3)
+	cache	0x1, 0x320(a3)
+	cache	0x1, 0x340(a3)
+	cache	0x1, 0x360(a3)
+	cache	0x1, 0x380(a3)
+	cache	0x1, 0x3a0(a3)
+	cache	0x1, 0x3c0(a3)
+	cache	0x1, 0x3e0(a3)
+	addiu	v0, v0, 0x400
+	sltu	a3, v0, a0
+	bnez	a3, 1b
+	 nop
+	addu	v1, v1, t0
+	sltu	a3, v1, a2
+	bnez	a3, 0b
+	 nop
+	sync
+	/*
+	 * L1 writeback above can make L2 lines dirty.  Flush the detected X1830
+	 * secondary-cache geometry now; no data-memory access is allowed after it.
+	 */
+	andi	a0, k0, 0xffff
+	srl	a1, k0, 16
+	andi	a1, a1, 0xff
+	srl	a2, k0, 24
+	lui	v1, 0x8000
+	addu	a0, v1, a0
+	li	t0, 1
+	sllv	t0, t0, a2
+	move	v1, zero
+	sllv	a2, a1, a2
+.Lx1830_scache_way:
+	lui	v0, 0x8000
+.Lx1830_scache_set:
+	or	a3, v1, v0
+	cache	0x3, 0x000(a3)
+	cache	0x3, 0x020(a3)
+	cache	0x3, 0x040(a3)
+	cache	0x3, 0x060(a3)
+	cache	0x3, 0x080(a3)
+	cache	0x3, 0x0a0(a3)
+	cache	0x3, 0x0c0(a3)
+	cache	0x3, 0x0e0(a3)
+	cache	0x3, 0x100(a3)
+	cache	0x3, 0x120(a3)
+	cache	0x3, 0x140(a3)
+	cache	0x3, 0x160(a3)
+	cache	0x3, 0x180(a3)
+	cache	0x3, 0x1a0(a3)
+	cache	0x3, 0x1c0(a3)
+	cache	0x3, 0x1e0(a3)
+	cache	0x3, 0x200(a3)
+	cache	0x3, 0x220(a3)
+	cache	0x3, 0x240(a3)
+	cache	0x3, 0x260(a3)
+	cache	0x3, 0x280(a3)
+	cache	0x3, 0x2a0(a3)
+	cache	0x3, 0x2c0(a3)
+	cache	0x3, 0x2e0(a3)
+	cache	0x3, 0x300(a3)
+	cache	0x3, 0x320(a3)
+	cache	0x3, 0x340(a3)
+	cache	0x3, 0x360(a3)
+	cache	0x3, 0x380(a3)
+	cache	0x3, 0x3a0(a3)
+	cache	0x3, 0x3c0(a3)
+	cache	0x3, 0x3e0(a3)
+	addiu	v0, v0, 0x400
+	sltu	a3, v0, a0
+	bnez	a3, .Lx1830_scache_set
+	 nop
+	addu	v1, v1, t0
+	sltu	a3, v1, a2
+	bnez	a3, .Lx1830_scache_way
+	 nop
+	sync
+	/*
+	 * Lock the caller, leaf, return point, CPM restore, and first stack
+	 * accesses as one span.  The previous leaf-local anchor excluded resume.
+	 */
+	la	t0, .Lx1830_resume_critical
+	li	t1, -32
+	and	t0, t0, t1
+	addiu	t2, t0, 0x3000
+0:
+	cache	0x1c, 0(t0)
+	bne	t0, t2, 0b
+	 addiu	t0, t0, 32
+1:
+	sync
+.Lx1830_resume_critical:
+	lui	t0, 0xb34f
+	ori	t0, t0, 0x0008
+	lw	t1, 0(t0)
+	li	t7, -2049
+	and	t6, t1, t7
+	sw	t6, 0(t0)
+	ori	t6, t6, 0x0020
+	sw	t6, 0(t0)
+	lui	t2, 0xb34f
+2:
+	lw	t6, 0(t2)
+	andi	t6, t6, 0x0004
+	beqz	t6, 2b
+	 nop
+	lui	t3, 0xb301
+	ori	t3, t3, 0x208c
+	li	t6, 1
+	sw	t6, 0(t3)
+	lui	t4, 0xb301
+	ori	t4, t4, 0x1084
+	li	t6, 0x1a
+	sw	t6, 0(t4)
+	sw	t6, 0(t4)
+	nop
+	wait
+	nop
+	li	t6, 0x18
+	sw	t6, 0(t4)
+	lui	t5, 0xb301
+	ori	t5, t5, 0x10c8
+3:
+	lw	t6, 0(t5)
+	andi	t6, t6, 0x0008
+	beqz	t6, 3b
+	 nop
+	sw	zero, 0(t3)
+4:
+	lw	t6, 0(t3)
+	andi	t6, t6, 0x0002
+	beqz	t6, 4b
+	 li	t7, -2081
+	and	t6, t1, t7
+	sw	t6, 0(t0)
+5:
+	lw	t5, -8(t0)
+	andi	t5, t5, 0x0004
+	bnez	t5, 5b
+	 nop
+	ori	t6, t6, 0x0800
+9:
+	jr	ra
+	 sw	t6, 0(t0)
+END(ingenic_x1830_ddr_sleep)
+	.set	reorder
