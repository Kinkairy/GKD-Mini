+	.val_bits = 8,
+	.max_register = ES8323_MAX_REGISTER,
+	.reg_defaults = es8323_reg_defaults,
+	.num_reg_defaults = ARRAY_SIZE(es8323_reg_defaults),
+	.cache_type = REGCACHE_RBTREE,
+};
+
+static void es8323_disable_mclk(void *data)
+{
+	clk_disable_unprepare(data);
+}
+
+static int es8323_i2c_probe(struct i2c_client *client,
+			    const struct i2c_device_id *id)
+{
+	struct device *dev = &client->dev;
+	struct es8323_priv *es8323;
+	int irq;
+	int ret;
+
+	es8323 = devm_kzalloc(dev, sizeof(*es8323), GFP_KERNEL);
+	if (!es8323)
+		return -ENOMEM;
+
+	mutex_init(&es8323->lock);
+	es8323->regmap = devm_regmap_init_i2c(client, &es8323_regmap_config);
+	if (IS_ERR(es8323->regmap))
+		return PTR_ERR(es8323->regmap);
+
+	es8323->mclk = devm_clk_get(dev, "mclk");
+	if (IS_ERR(es8323->mclk))
+		return dev_err_probe(dev, PTR_ERR(es8323->mclk),
+				     "failed to get MCLK\n");
+
+	ret = clk_prepare_enable(es8323->mclk);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable MCLK\n");
+
+	ret = devm_add_action_or_reset(dev, es8323_disable_mclk, es8323->mclk);
+	if (ret)
+		return ret;
+
+	es8323->sysclk = clk_get_rate(es8323->mclk);
+	es8323->speaker_enable =
+		devm_gpiod_get_optional(dev, "speaker-enable", GPIOD_OUT_LOW);
+	if (IS_ERR(es8323->speaker_enable))
+		return dev_err_probe(dev, PTR_ERR(es8323->speaker_enable),
+				     "failed to get speaker-enable GPIO\n");
+
+	es8323->headphone_detect =
+		devm_gpiod_get_optional(dev, "headphone-detect", GPIOD_IN);
+	if (IS_ERR(es8323->headphone_detect))
+		return dev_err_probe(dev, PTR_ERR(es8323->headphone_detect),
+				     "failed to get headphone-detect GPIO\n");
+
+	if (es8323->headphone_detect) {
+		irq = gpiod_to_irq(es8323->headphone_detect);
+		if (irq < 0)
+			return dev_err_probe(dev, irq,
+					     "failed to map headphone IRQ\n");
+
+		ret = devm_request_threaded_irq(dev, irq, NULL,
+					       es8323_headphone_irq,
+					       IRQF_ONESHOT |
+					       IRQF_TRIGGER_RISING |
+					       IRQF_TRIGGER_FALLING,
+					       "es8323-headphone", es8323);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to request headphone IRQ\n");
+	}
+
+	i2c_set_clientdata(client, es8323);
+
+	return devm_snd_soc_register_component(dev, &es8323_component_driver,
+					       &es8323_dai, 1);
+}
+
+static void es8323_i2c_shutdown(struct i2c_client *client)
+{
+	struct es8323_priv *es8323 = i2c_get_clientdata(client);
+
+	if (es8323->speaker_enable)
+		gpiod_set_value_cansleep(es8323->speaker_enable, 0);
+
+	regmap_write(es8323->regmap, ES8323_DACCONTROL3, 0x06);
+	regmap_write(es8323->regmap, ES8323_LOUT2VOL, 0x00);
+	regmap_write(es8323->regmap, ES8323_ROUT2VOL, 0x00);
+	regmap_write(es8323->regmap, ES8323_CHIPPOWER, 0xf3);
+}
+
+static const struct of_device_id es8323_of_match[] = {
+	{ .compatible = "everest,es8323" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, es8323_of_match);
+
+static const struct i2c_device_id es8323_i2c_id[] = {
+	{ "es8323", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, es8323_i2c_id);
+
+static struct i2c_driver es8323_i2c_driver = {
+	.driver = {
+		.name = "es8323",
+		.of_match_table = es8323_of_match,
+	},
+	.probe = es8323_i2c_probe,
+	.shutdown = es8323_i2c_shutdown,
+	.id_table = es8323_i2c_id,
+};
+module_i2c_driver(es8323_i2c_driver);
+
+MODULE_DESCRIPTION("ASoC Everest Semi ES8323 codec driver");
+MODULE_AUTHOR("OpenAI");
+MODULE_LICENSE("GPL");
