+/* ROUND64_RC3_USB_MENU_END */static int x1830_fb_panel_power_on(struct x1830_fb *fb)
+{
+	int ret;
+
+	gpiod_set_value_cansleep(fb->panel_data_gpio, 0);
+	gpiod_set_value_cansleep(fb->panel_clock_gpio, 1);
+	gpiod_set_value_cansleep(fb->panel_enable_gpio, 1);
+	gpiod_set_value_cansleep(fb->power_gpio, 1);
+	msleep(50);
+
+	/* reset-gpios is active low: logical one asserts reset. */
+	gpiod_set_value_cansleep(fb->reset_gpio, 1);
+	msleep(25);
+	gpiod_set_value_cansleep(fb->reset_gpio, 0);
+	usleep_range(10000, 12000);
+	fb->panel_powered = true;
+
+	/* Let at least one black frame reach the panel before lighting it. */
+	msleep(20);
+	ret = backlight_update_status(fb->backlight);
+	if (ret)
+		dev_err(fb->dev, "failed to enable panel PWM: %d\n", ret);
+
+	return ret;
+}
+
+static void x1830_fb_panel_power_off(struct x1830_fb *fb)
+{
+	int ret;
+
+	ret = x1830_fb_apply_backlight(fb,
+		fb->backlight->props.brightness, false);
+	if (ret)
+		dev_warn(fb->dev, "failed to disable panel PWM: %d\n", ret);
+
+	gpiod_set_value_cansleep(fb->reset_gpio, 1);
+	gpiod_set_value_cansleep(fb->power_gpio, 0);
+	gpiod_set_value_cansleep(fb->panel_enable_gpio, 0);
+	gpiod_set_value_cansleep(fb->panel_clock_gpio, 0);
+	gpiod_set_value_cansleep(fb->panel_data_gpio, 0);
+	fb->panel_powered = false;
+}
+
+static int x1830_fb_stop_dpu(struct x1830_fb *fb)
+{
+	u32 status;
+	int ret;
+
+	writel(X1830_DPU_CTRL_GENERAL_STOP, fb->regs + X1830_DPU_CTRL);
+	ret = readl_poll_timeout_atomic(fb->regs + X1830_DPU_STATUS,
+				 status,
+				 (status & X1830_DPU_STATUS_STOP_ACK) &&
+				 !(status & X1830_DPU_STATUS_WORKING),
+				 10, 100000);
+	writel(X1830_DPU_INT_CLEAR_ALL, fb->regs + X1830_DPU_INT_CLEAR);
+
+	return ret;
+}
+
+static int x1830_fb_setup_descriptors(struct x1830_fb *fb)
+{
+	struct x1830_frame_desc *frame = &fb->descs->frame;
+	struct x1830_layer_desc *layer = &fb->descs->layer[0];
+	struct x1830_layer_desc *osd = &fb->descs->layer[1];
+	dma_addr_t frame_dma;
+	dma_addr_t layer0_dma;
+	dma_addr_t layer1_dma;
+
+	BUILD_BUG_ON(sizeof(struct x1830_frame_desc) != 48);
+	BUILD_BUG_ON(sizeof(struct x1830_layer_desc) != 48);
+
+	frame_dma = fb->descs_dma + offsetof(struct x1830_desc_block, frame);
+	layer0_dma = fb->descs_dma + offsetof(struct x1830_desc_block, layer[0]);
+	layer1_dma = fb->descs_dma + offsetof(struct x1830_desc_block, layer[1]);
+
+	if (upper_32_bits(frame_dma) || upper_32_bits(layer0_dma) ||
+	    upper_32_bits(layer1_dma) || upper_32_bits(fb->fb_dma) ||
+	    upper_32_bits(fb->composite_dma + X1830_COMPOSITE_SIZE - 1))
+		return -EOVERFLOW;
+
+	memset(fb->descs, 0, sizeof(*fb->descs));
+	frame->next = lower_32_bits(frame_dma);
+	frame->size = X1830_FRAME_SIZE;
+	frame->control = X1830_FRAME_CONTROL;
+	frame->layer_cfg_addr[0] = lower_32_bits(layer0_dma);
+	frame->layer_cfg_addr[1] = 0;
+	frame->layer_cfg_enable = X1830_FRAME_LAYER_ENABLE;
+	frame->interrupt_control = X1830_FRAME_IRQ_CONTROL;
+
+	layer->size = X1830_FRAME_SIZE;
+	layer->config = X1830_LAYER_CFG_RGB565;
+	layer->buffer_addr = lower_32_bits(fb->fb_dma);
+	layer->stride = X1830_FB_XRES;
+
+	memset(osd, 0, sizeof(*osd));
+
+	dma_wmb();
+	return 0;
+}
+
+static void x1830_fb_clear_scanout(struct x1830_fb *fb)
+{
+	/* Round34 removes the visible Round30 diagnostic prefill. */
+	memset(fb->fb_virt, 0, X1830_FB_SIZE);
+	dma_wmb();
+}
+
+extern unsigned int gkd_round14_rtc_stage(unsigned int stage);
+
+static bool x1830_fb_resume_trace_enabled;
+
+static noinline void x1830_fb_resume_trace(unsigned int stage)
+{
+	if (READ_ONCE(x1830_fb_resume_trace_enabled))
+		gkd_round14_rtc_stage(0xd0000000U | stage);
+}
+
+static int x1830_fb_start_dpu(struct x1830_fb *fb)
+{
+	u32 value;
+	u32 tft_status;
+	int ret;
+
+	x1830_fb_resume_trace(1);
+	tft_status = readl(fb->regs + X1830_DPU_TFT_STATUS);
+	x1830_fb_resume_trace(2);
+	if (tft_status & X1830_DPU_TFT_ACTIVE) {
+		x1830_fb_resume_trace(3);
+		ret = x1830_fb_stop_dpu(fb);
+		x1830_fb_resume_trace(4);
+		if (ret) {
+			dev_err(fb->dev, "timed out stopping active DPU: %d\n", ret);
+			return ret;
+		}
+	}
+
+	value = readl(fb->regs + X1830_DPU_TFT_COMMON_CFG);
+	value = (value & ~0x3) | 0x1;
+	writel(value, fb->regs + X1830_DPU_TFT_COMMON_CFG);
+
+	writel(0x00040177, fb->regs + X1830_DPU_TFT_HSYNC);
+	writel(0x00040108, fb->regs + X1830_DPU_TFT_VSYNC);
+	writel(0x002f016f, fb->regs + X1830_DPU_TFT_HDE);
+	writel(0x00100100, fb->regs + X1830_DPU_TFT_VDE);
+	writel(0x00000000, fb->regs + X1830_DPU_TFT_CFG);
+
+	x1830_fb_resume_trace(5);
+	value = readl(fb->regs + X1830_DPU_COMPOSER_CFG);
+	value = (value & ~0xe) | 0xc;
+	writel(value, fb->regs + X1830_DPU_COMPOSER_CFG);
+	writel(X1830_DPU_INT_CLEAR_ALL, fb->regs + X1830_DPU_INT_CLEAR);
+	writel(READ_ONCE(x1830_fb_resume_trace_enabled) ? 0 :
+	       X1830_DPU_INT_CONTROL_VALUE,
+	       fb->regs + X1830_DPU_INT_CONTROL);
+	writel(lower_32_bits(fb->descs_dma),
+	       fb->regs + X1830_DPU_FRM_CFG_ADDR);
+
+	dma_wmb();
+	x1830_fb_resume_trace(6);
+	writel(X1830_DPU_COMPOSER_START,
+	       fb->regs + X1830_DPU_FRM_CFG_CTRL);
+	x1830_fb_resume_trace(7);
+	writel(X1830_DPU_CTRL_START_TFT, fb->regs + X1830_DPU_CTRL);
+	x1830_fb_resume_trace(8);
+	readl(fb->regs + X1830_DPU_CTRL);
+	x1830_fb_resume_trace(9);
+
+	return 0;
+}
+
+static int x1830_fb_syscore_suspend(void)
+{
+	struct x1830_fb *fb = READ_ONCE(x1830_fb_syscore);
+	int ret;
+
+	if (!fb)
+		return 0;
+
+	gkd_round14_rtc_stage(0xd3000000U);
+	disable_irq_nosync(fb->irq);
+	gkd_round14_rtc_stage(0xd3000001U);
+	ret = x1830_fb_stop_dpu(fb);
+	gkd_round14_rtc_stage(0xd3000002U);
+	if (ret) {
+		enable_irq(fb->irq);
+		gkd_round14_rtc_stage(0xd30000ffU);
+	}
+
+	return ret;
+}
+
+static void x1830_fb_hide_power_loading_on_resume(struct x1830_fb *fb)
+{
+	/* Syscore resume runs before userspace and workqueues thaw.  Do not call
+	 * the normal renderer here: it may touch the stopped DPU or queue work.
+	 * A non-DEBUG Loading surface at this boundary belongs to power suspend. */
+	if (READ_ONCE(fb->menu_view) != X1830_MENU_LOADING ||
+	    READ_ONCE(fb->usb_debug_loading_active))
+		return;
+
+	WRITE_ONCE(fb->menu_expires, 0);
+	WRITE_ONCE(fb->menu_view, X1830_MENU_HIDDEN);
+	WRITE_ONCE(fb->composite_active, false);
+	WRITE_ONCE(fb->power_resume_loading_suppressed, true);
+	WRITE_ONCE(fb->power_resume_loading_hide_count,
+		   READ_ONCE(fb->power_resume_loading_hide_count) + 1U);
+	WRITE_ONCE(fb->descs->layer[0].buffer_addr,
+		   READ_ONCE(fb->latest_scanout_addr));
+	dma_wmb();
+}
+
+static void x1830_fb_syscore_resume(void)
+{
+	struct x1830_fb *fb = READ_ONCE(x1830_fb_syscore);
+	int ret;
+
+	if (!fb)
+		return;
+
+	x1830_fb_hide_power_loading_on_resume(fb);
+	WRITE_ONCE(x1830_fb_resume_trace_enabled, true);
+	gkd_round14_rtc_stage(0xd4000000U);
+	ret = x1830_fb_start_dpu(fb);
+	x1830_fb_resume_trace(10);
+	if (ret) {
+		gkd_round14_rtc_stage(0xd40000feU);
+		goto out_irq;
+	}
+
+	gkd_round14_rtc_stage(0xd4000001U);
+	writel(0, fb->regs + X1830_DPU_INT_CONTROL);
+	gkd_round14_rtc_stage(0xd4000002U);
+	writel(X1830_DPU_INT_CLEAR_ALL, fb->regs + X1830_DPU_INT_CLEAR);
+	gkd_round14_rtc_stage(0xd4000003U);
+	readl(fb->regs + X1830_DPU_INT_STATUS);
+	gkd_round14_rtc_stage(0xd4000004U);
+out_irq:
+	enable_irq(fb->irq);
+	gkd_round14_rtc_stage(0xd4000005U);
+	WRITE_ONCE(x1830_fb_resume_trace_enabled, false);
+	if (ret)
+		dev_err(fb->dev, "failed to restart DPU at syscore resume: %d\n",
+			ret);
+}
+
+static struct syscore_ops x1830_fb_syscore_ops = {
+	.suspend = x1830_fb_syscore_suspend,
+	.resume = x1830_fb_syscore_resume,
+};
+
+static irqreturn_t x1830_fb_irq(int irq, void *data)
+{
+	struct x1830_fb *fb = data;
+	u32 status;
+
+	status = readl(fb->regs + X1830_DPU_INT_STATUS);
+	if (!status)
+		return IRQ_NONE;
+
+	writel(status, fb->regs + X1830_DPU_INT_CLEAR);
+	return IRQ_HANDLED;
+}
