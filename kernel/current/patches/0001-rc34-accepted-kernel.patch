+static const char x1830_menu_chars[] = "ABCDEGHJMORSTUV()04- 12356789%";
+static const u16 x1830_menu_bits[] = { 0x2d6f,0x6bae,0x7247,0x6b6e,0x79e7,0x72ef,0x5bed,0x126a,0x5bfa,0x7b6f,0x6bad,0x79cf,0x7492,0x5b6f,0x5b6a,0x2492,0x4924,0x7b6f,0x5bc9,0x00e0,0,0x2c97,0x73e7,0x73cf,0x79cf,0x79ef,0x7292,0x7bef,0x7bcf,0x52a5 };
+static void x1830_menu_rect(struct x1830_fb *fb, unsigned int x, unsigned int y, unsigned int width, unsigned int height, u32 color)
+{ u32 *pixel = fb->menu_osd_virt + y * X1830_MENU_WIDTH + x; while (height--) { unsigned int column; for (column = 0; column < width; ++column) pixel[column] = color; pixel += X1830_MENU_WIDTH; } }
+static void x1830_menu_scaled_text(struct x1830_fb *fb, unsigned int x,
+		unsigned int y, const char *text, u32 color,
+		unsigned int glyph_width, unsigned int glyph_height,
+		unsigned int advance, unsigned int dot_advance)
+{
+	const char *match;
+	unsigned int row, col, bits;
+
+	for (; *text; ++text) {
+		if (*text == '.') {
+			unsigned int dot_height = glyph_height > 5U ? 2U : 1U;
+			x1830_menu_rect(fb, x + (glyph_width - 1U) / 2U,
+				y + glyph_height - dot_height, 1U, dot_height, color);
+			x += dot_advance;
+			continue;
+		}
+		match = strchr(x1830_menu_chars, *text);
+		bits = match ? x1830_menu_bits[match - x1830_menu_chars] : 0;
+		for (row = 0; row < glyph_height; ++row)
+			for (col = 0; col < glyph_width; ++col)
+				if (bits & (1U << (14U - row * 5U / glyph_height * 3U -
+					col * 3U / glyph_width)))
+					fb->menu_osd_virt[(y + row) *
+						X1830_MENU_WIDTH + x + col] = color;
+		x += advance;
+	}
+}
+
+static void x1830_menu_text(struct x1830_fb *fb, unsigned int x,
+		unsigned int y, const char *text, u32 color)
+{
+	x1830_menu_scaled_text(fb, x, y, text, color, 3U, 5U, 5U, 5U);
+}
