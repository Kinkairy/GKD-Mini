+	(void)snprintf(label, sizeof(label), "VOL %u%%", percent);
+	x1830_volume_osd_fill_rounded(pixels, rail_x, rail_y, rail_width, 10,
+		X1830_ARGB8888(255, 6, 9, 12));
+	x1830_volume_osd_fill_rounded(pixels, rail_x + 1, rail_y + 1,
+		rail_width - 2, 8, X1830_ARGB8888(255, 42, 49, 58));
+	if (filled_width > 0) {
+		x1830_volume_osd_fill_rounded(pixels, rail_x, rail_y,
+			filled_width, 10, X1830_ARGB8888(255, 47, 190, 91));
+		if (filled_width > 6)
+			x1830_volume_osd_fill(pixels, rail_x + 3,
+				rail_y + 1, filled_width - 6, 1,
+				X1830_ARGB8888(255, 105, 231, 137));
+	}
+	label_width = strlen(label) * 5 - 2;
+	label_x = rail_x + (rail_width - label_width) / 2;
+	x1830_volume_osd_draw_text(pixels, label_x + 1, label,
+		X1830_ARGB8888(255, 7, 10, 9));
+	x1830_volume_osd_draw_text(pixels, label_x, label,
+		X1830_ARGB8888(255, 232, 237, 241));
