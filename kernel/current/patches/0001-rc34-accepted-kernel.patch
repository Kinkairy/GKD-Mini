+static int x1830_i2s_trigger(struct snd_pcm_substream *substream, int cmd,
+	struct snd_soc_dai *dai)
+{
+	struct jz4740_i2s *i2s = snd_soc_dai_get_drvdata(dai);
+	uint32_t ctrl;
+	uint32_t format;
+	unsigned int timeout;
+	uint32_t fifo_status;
+	int index;
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return -EINVAL;
+
+	ctrl = jz4740_i2s_read(i2s, JZ_REG_AIC_CTRL);
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		if (!i2s->round46_build_marker_logged) {
+			i2s->round46_build_marker_logged = true;
+			x1830_i2s_round46_log_state(i2s, "trigger-start");
+		}
+		ctrl &= ~(JZ_AIC_CTRL_ENABLE_PLAYBACK |
+			  JZ_AIC_CTRL_ENABLE_TX_DMA);
+		jz4740_i2s_write(i2s, JZ_REG_AIC_CTRL, ctrl);
+		format = jz4740_i2s_read(i2s, JZ_REG_AIC_I2S_FMT);
+		format |= JZ_AIC_I2S_FMT_SEND_RIGHT_FIRST;
+		jz4740_i2s_write(i2s, JZ_REG_AIC_I2S_FMT, format);
+		for (index = 0; index < 32; ++index)
+			jz4740_i2s_write(i2s, JZ_REG_AIC_FIFO, 0);
+		x1830_i2s_clear_tx_underrun(i2s);
+		ctrl |= JZ_AIC_CTRL_ENABLE_PLAYBACK;
+		jz4740_i2s_write(i2s, JZ_REG_AIC_CTRL, ctrl);
+		for (timeout = 150000; timeout > 0; --timeout) {
+			if (jz4740_i2s_read(i2s, JZ_REG_AIC_FIFO_STATUS) &
+			    JZ_AIC_FIFO_STATUS_TX_UNDERRUN)
+				break;
+			cpu_relax();
+		}
+		if (!timeout) {
+			ctrl &= ~(JZ_AIC_CTRL_ENABLE_PLAYBACK |
+				  JZ_AIC_CTRL_ENABLE_TX_DMA);
+			jz4740_i2s_write(i2s, JZ_REG_AIC_CTRL, ctrl);
+			x1830_i2s_clear_tx_underrun(i2s);
+			if (!i2s->round46_prime_timeout_logged) {
+				i2s->round46_prime_timeout_logged = true;
+				x1830_i2s_round46_log_state(i2s,
+						       "prime-timeout-cleaned");
+			}
+			return -ETIMEDOUT;
+		}
+		ctrl |= JZ_AIC_CTRL_ENABLE_TX_DMA;
+		jz4740_i2s_write(i2s, JZ_REG_AIC_CTRL, ctrl);
+		x1830_i2s_clear_tx_underrun(i2s);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		/* Sample before disabling TX DMA; drain-loop underrun is intentional. */
+		fifo_status = jz4740_i2s_read(i2s, JZ_REG_AIC_FIFO_STATUS);
+		if (!i2s->round48_stop_marker_logged) {
+			i2s->round48_stop_marker_logged = true;
+			dev_info(i2s->dev,
+				 "GKD Round48 X1830 stop-pre tx_underrun=%u "
+				 "AICFR=%#08x AICCR=%#08x I2SCR=%#08x "
+				 "I2SSR=%#08x I2SDIV=%#08x\n",
+				 !!(fifo_status & JZ_AIC_FIFO_STATUS_TX_UNDERRUN),
+				 jz4740_i2s_read(i2s, JZ_REG_AIC_CONF), ctrl,
