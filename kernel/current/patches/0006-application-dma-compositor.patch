+++ b/drivers/video/fbdev/gkd-x1830-dma.h
@@ -0,0 +1,306 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Serialized A-profile composition transport; callers hold the UI mutex. */
+#ifndef GKD_X1830_DMA_H
+#define GKD_X1830_DMA_H
+#include <linux/completion.h>
+#include <linux/dmaengine.h>
+#include <linux/dma-map-ops.h>
+#include <linux/scatterlist.h>
+#include <linux/of.h>
+
+#define X1830_DMA_TIMEOUT_MS 20U
+#define X1830_DMA_FAULT_RECHECK_MS 100U
+
+struct x1830_dma_mapping {
+	struct sg_table sgt;
+	dma_addr_t address, native;
+	size_t bytes;
+	enum dma_data_direction direction;
+	bool table, mapped;
+};
+struct x1830_dma_compositor {
+	struct device *dev, *copy_dev;
+	struct dma_chan *channel;
+	struct device_link *link;
+	struct x1830_dma_mapping source, output;
+	struct completion done;
+	void *stage;
+	dma_addr_t stage_dma;
+	size_t frame_bytes, stage_bytes;
+	bool stage_cpu, paused;
+	int fault;
+};
+static bool x1830_dma_provider(struct dma_chan *channel, void *node)
+{
+	return channel->device->dev->of_node == node;
+}
+static void x1830_dma_completed(void *data)
+{
+	struct x1830_dma_compositor *copy = data;
+
+	complete(&copy->done);
+}
+static bool x1830_dma_range32(dma_addr_t address, size_t bytes)
+{
+	return bytes && !upper_32_bits((u64)address + bytes - 1U);
+}
+static void x1830_dma_stage_cpu(struct x1830_dma_compositor *copy)
+{
+	if (!copy->stage_cpu) {
+		dma_sync_single_for_cpu(copy->copy_dev, copy->stage_dma,
+					copy->stage_bytes, DMA_BIDIRECTIONAL);
+		copy->stage_cpu = true;
+	}
+}
+static void x1830_dma_stage_device(struct x1830_dma_compositor *copy)
+{
+	if (copy->stage_cpu) {
+		dma_sync_single_for_device(copy->copy_dev, copy->stage_dma,
+					   copy->stage_bytes, DMA_BIDIRECTIONAL);
+		copy->stage_cpu = false;
+	}
+}
+static int x1830_dma_map(struct x1830_dma_compositor *copy,
+			struct x1830_dma_mapping *map, void *cpu,
+			dma_addr_t native, size_t bytes,
+			enum dma_data_direction direction)
+{
+	int ret;
+
+	map->native = native;
+	map->bytes = bytes;
+	map->direction = direction;
+	ret = dma_get_sgtable(copy->dev, &map->sgt, cpu, native, bytes);
+	if (ret)
+		return ret;
+	map->table = true;
+	/* The DPU allocation is uncached coherent memory on this board.
+	 * As in DRM PRIME/VB2, never flush a different cached alias. */
+	ret = dma_map_sgtable(copy->copy_dev, &map->sgt, direction,
+			     DMA_ATTR_SKIP_CPU_SYNC);
+	if (ret)
+		return ret;
+	map->mapped = true;
+	if (map->sgt.nents != 1 || sg_dma_len(map->sgt.sgl) < bytes)
+		return -ERANGE;
+	map->address = sg_dma_address(map->sgt.sgl);
+	if (!x1830_dma_range32(map->address, bytes) ||
+	    !x1830_dma_range32(native, bytes))
+		return -EOVERFLOW;
+	return 0;
+}
+static void x1830_dma_unmap(struct x1830_dma_compositor *copy,
+			  struct x1830_dma_mapping *map)
+{
+	if (map->mapped)
+		dma_unmap_sgtable(copy->copy_dev, &map->sgt, map->direction,
+				 DMA_ATTR_SKIP_CPU_SYNC);
+	if (map->table)
+		sg_free_table(&map->sgt);
+	map->mapped = false;
+	map->table = false;
+}
+static void x1830_dma_release(struct x1830_dma_compositor *copy)
+{
+	copy->paused = true;
+	if (copy->channel)
+		dmaengine_terminate_sync(copy->channel);
+	if (copy->stage) {
+		x1830_dma_stage_cpu(copy);
+		dma_free_noncoherent(copy->copy_dev, copy->stage_bytes,
+				     copy->stage, copy->stage_dma,
+				     DMA_BIDIRECTIONAL);
+		copy->stage = NULL;
+	}
+	x1830_dma_unmap(copy, &copy->output);
+	x1830_dma_unmap(copy, &copy->source);
+	if (copy->link) {
+		device_link_del(copy->link);
+		copy->link = NULL;
+	}
+	if (copy->channel) {
+		dma_release_channel(copy->channel);
+		copy->channel = NULL;
+	}
+}
+static int x1830_dma_init(struct x1830_dma_compositor *copy,
+			 struct device *dev, void *source, dma_addr_t source_dma,
+			 size_t source_bytes, void *output, dma_addr_t output_dma,
+			 size_t output_bytes, size_t frame_bytes)
+{
+	struct device_node *node;
+	dma_cap_mask_t mask;
+	int ret;
+
+	copy->dev = dev;
+	copy->frame_bytes = frame_bytes;
+	copy->stage_bytes = PAGE_ALIGN(frame_bytes);
+	init_completion(&copy->done);
+	if (!IS_ENABLED(CONFIG_MIPS) || !IS_ENABLED(CONFIG_DMA_NONCOHERENT) ||
+	    IS_ENABLED(CONFIG_IOMMU_SUPPORT) || IS_ENABLED(CONFIG_SWIOTLB))
+		return -EOPNOTSUPP;
+	node = of_find_compatible_node(NULL, NULL, "ingenic,x1830-dma");
+	if (!node)
+		return -ENODEV;
+	dma_cap_zero(mask);
+	dma_cap_set(DMA_MEMCPY, mask);
+	copy->channel = __dma_request_channel(&mask, x1830_dma_provider, node, node);
+	of_node_put(node);
+	if (!copy->channel)
+		return -EPROBE_DEFER;
+	copy->copy_dev = dmaengine_get_dma_device(copy->channel);
+	if (get_dma_ops(dev) || get_dma_ops(copy->copy_dev) ||
+	    dev->dma_mem || copy->copy_dev->dma_mem) {
+		ret = -EOPNOTSUPP;
+		goto fail;
+	}
+	copy->link = device_link_add(dev, copy->copy_dev, DL_FLAG_STATELESS);
+	if (!copy->link) {
+		ret = -EINVAL;
+		goto fail;
+	}
+	ret = x1830_dma_map(copy, &copy->source, source, source_dma,
+			   source_bytes, DMA_TO_DEVICE);
+	if (ret)
+		goto fail;
+	ret = x1830_dma_map(copy, &copy->output, output, output_dma,
+			   output_bytes, DMA_FROM_DEVICE);
+	if (ret)
+		goto fail;
+	copy->stage = dma_alloc_noncoherent(copy->copy_dev, copy->stage_bytes,
+					    &copy->stage_dma, DMA_BIDIRECTIONAL,
+					    GFP_KERNEL);
+	if (!copy->stage) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	/* dma_direct_alloc_pages zeroes through the cached CPU mapping. */
+	copy->stage_cpu = true;
+	if (!x1830_dma_range32(copy->stage_dma, copy->stage_bytes)) {
+		ret = -EOVERFLOW;
+		goto fail;
+	}
+	return 0;
+fail:
+	x1830_dma_release(copy);
+	return ret;
+}
+static int x1830_dma_ready(struct x1830_dma_compositor *copy)
+{
+	if (copy->paused)
+		return -EAGAIN;
+	return copy->fault;
+}
+static int x1830_dma_transfer(struct x1830_dma_compositor *copy,
+			      dma_addr_t target, dma_addr_t source)
+{
+	struct dma_async_tx_descriptor *tx;
+	dma_cookie_t cookie;
+	enum dma_status status;
+	unsigned long done;
+	int ret = x1830_dma_ready(copy);
+
+	if (ret)
+		return ret;
+	reinit_completion(&copy->done);
+	dma_wmb();
+	tx = dmaengine_prep_dma_memcpy(copy->channel, target, source,
+				      copy->frame_bytes,
+				      DMA_PREP_INTERRUPT | DMA_CTRL_ACK);
+	if (!tx) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	tx->callback = x1830_dma_completed;
+	tx->callback_param = copy;
+	cookie = dmaengine_submit(tx);
+	ret = dma_submit_error(cookie);
+	if (ret)
+		goto fail;
+	dma_async_issue_pending(copy->channel);
+	done = wait_for_completion_timeout(&copy->done,
+					   msecs_to_jiffies(X1830_DMA_TIMEOUT_MS));
+	status = done ? dmaengine_tx_status(copy->channel, cookie, NULL) : DMA_ERROR;
+	if (!done) {
+		ret = -ETIMEDOUT;
+		goto fail;
+	}
+	if (status != DMA_COMPLETE) {
+		ret = -EIO;
+		goto fail;
+	}
+	/* Drain callback before returning, reusing completion, or freeing storage. */
+	dmaengine_terminate_sync(copy->channel);
+	dma_rmb();
+	return 0;
+fail:
+	dmaengine_terminate_sync(copy->channel);
+	copy->fault = ret;
+	dev_err(copy->dev, "OSD DMA stopped: %d\n", ret);
+	return ret;
+}
+static int x1830_dma_copy_output(struct x1830_dma_compositor *copy,
+				 size_t source_offset, size_t output_offset)
+{
+	int ret = x1830_dma_ready(copy);
+
+	if (ret)
+		return ret;
+	if (copy->source.bytes < copy->frame_bytes ||
+	    source_offset > copy->source.bytes - copy->frame_bytes ||
+	    copy->output.bytes < copy->frame_bytes ||
+	    output_offset > copy->output.bytes - copy->frame_bytes)
+		return -EINVAL;
+	/* Copy to the inactive coherent output; completion drains and read
+	 * barrier precede the caller's CPU tile access. No address published. */
+	return x1830_dma_transfer(copy, copy->output.address + output_offset,
+				  copy->source.address + source_offset);
+}
+static int x1830_dma_prepare(struct x1830_dma_compositor *copy, size_t offset)
+{
+	int ret = x1830_dma_ready(copy);
+
+	if (ret)
+		return ret;
+	if (copy->source.bytes < copy->frame_bytes ||
+	    offset > copy->source.bytes - copy->frame_bytes)
+		return -EINVAL;
+	x1830_dma_stage_device(copy);
+	ret = x1830_dma_transfer(copy, copy->stage_dma, copy->source.address + offset);
+	if (ret)
+		return ret;
+	x1830_dma_stage_cpu(copy);
+	return 0;
+}
+static int x1830_dma_prepare_cached(struct x1830_dma_compositor *copy,
+				    const void *source)
+{
+	int ret = x1830_dma_ready(copy);
+
+	if (ret)
+		return ret;
+	x1830_dma_stage_cpu(copy);
+	/* Menu/frozen sources already live in CPU cacheable memory. */
+	memcpy(copy->stage, source, copy->frame_bytes);
+	return 0;
+}
+static int x1830_dma_finish(struct x1830_dma_compositor *copy, size_t offset,
+			   u32 *output)
+{
+	int ret = x1830_dma_ready(copy);
+
+	if (ret)
+		return ret;
+	if (copy->output.bytes < copy->frame_bytes ||
+	    offset > copy->output.bytes - copy->frame_bytes)
+		return -EINVAL;
+	x1830_dma_stage_device(copy);
+	ret = x1830_dma_transfer(copy, copy->output.address + offset, copy->stage_dma);
+	if (ret)
+		return ret;
+	x1830_dma_stage_cpu(copy);
+	dma_wmb();
+	*output = lower_32_bits(copy->output.native + offset);
+	return 0;
+}
+#endif
