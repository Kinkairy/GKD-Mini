-/* The DPU stays active at the ordinary device PM boundary, as in jz_fb_v14. */
+/* Drain PDMA in process context; the established DPU syscore sequence stays. */
+static int x1830_fb_dma_suspend(struct device *dev)
+{
+	struct fb_info *info = dev_get_drvdata(dev);
+	struct x1830_fb *fb = info->par;
+
+	mutex_lock(&fb->volume_osd_lock);
+	fb->dma.paused = true;
+	mutex_unlock(&fb->volume_osd_lock);
+	cancel_delayed_work_sync(&fb->composite_work);
+	mutex_lock(&fb->volume_osd_lock);
+	dmaengine_terminate_sync(fb->dma.channel);
+	mutex_unlock(&fb->volume_osd_lock);
+	return 0;
+}
+static int x1830_fb_dma_resume(struct device *dev)
+{
+	struct fb_info *info = dev_get_drvdata(dev);
+	struct x1830_fb *fb = info->par;
+	int ret;
+
+	mutex_lock(&fb->volume_osd_lock);
+	fb->dma.fault = 0;
+	fb->dma.paused = false;
+	ret = x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+	mutex_unlock(&fb->volume_osd_lock);
+	return ret;
+}
