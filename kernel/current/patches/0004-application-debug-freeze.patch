+static int gkd_ui_freeze_submit_ioctl(struct x1830_fb *fb, unsigned long arg)
+{
+	struct gkd_ui_freeze_submit submit;
+	struct pid *owner = task_tgid(current);
+	bool renewing;
+	int ret = 0;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (copy_from_user(&submit, (void __user *)arg, sizeof(submit)))
+		return -EFAULT;
+	if (submit.ttl_ms < GKD_UI_FREEZE_MIN_TTL_MS ||
+	    submit.ttl_ms > GKD_UI_FREEZE_MAX_TTL_MS ||
+	    !submit.sequence || submit.reserved[0] || submit.reserved[1])
+		return -EINVAL;
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+	renewing = x1830_user_debug_freeze_live_locked(fb);
+	if (renewing && fb->user_debug_freeze_owner != owner) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	if (renewing && submit.sequence <= fb->user_debug_freeze_sequence) {
+		ret = -ESTALE;
+		goto out_unlock;
+	}
+	if (!renewing) {
+		ret = x1830_debug_frozen_capture_locked(fb);
+		if (ret)
+			goto out_unlock;
+		fb->user_debug_freeze_owner = get_pid(owner);
+	}
+	fb->user_debug_freeze_sequence = submit.sequence;
+	fb->user_debug_freeze_expires = jiffies +
+		msecs_to_jiffies(submit.ttl_ms);
+	x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+out_unlock:
+	mutex_unlock(&fb->volume_osd_lock);
+	return ret;
+}
+
+static int gkd_ui_freeze_clear_ioctl(struct x1830_fb *fb)
+{
+	int ret = 0;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) {
+		ret = -ENODEV;
+	} else if (x1830_user_debug_freeze_live_locked(fb) &&
+		   fb->user_debug_freeze_owner != task_tgid(current)) {
+		ret = -EBUSY;
+	} else {
+		x1830_user_debug_freeze_release_locked(fb);
+		x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+	}
+	mutex_unlock(&fb->volume_osd_lock);
+	return ret;
+}
