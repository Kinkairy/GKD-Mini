+#ifdef GKD_AXP173_APP_POWER
+static int gkd_axp173_read_byte(struct gkd_axp173 *axp, u8 reg, u8 *value)
+{
+	int ret = i2c_smbus_read_byte_data(axp->client, reg);
+
+	if (ret < 0)
+		return ret;
+	*value = ret;
+	return 0;
+}
+
+static int gkd_axp173_battery_get_property(struct power_supply *psy,
+		enum power_supply_property property,
+		union power_supply_propval *value)
+{
+	struct gkd_axp173 *axp = power_supply_get_drvdata(psy);
+	u8 high, low;
+	int ret = 0;
+	int microvolts;
+
+	mutex_lock(&axp->lock);
+	if (axp->telemetry_suspended) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	switch (property) {
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = gkd_axp173_read_byte(axp, AXP173_BATTERY_VOLTAGE_H, &high);
+		if (!ret)
+			ret = gkd_axp173_read_byte(axp, AXP173_BATTERY_VOLTAGE_L, &low);
+		if (ret)
+			break;
+		microvolts = (((int)high << 4) | (low & 0x0f)) * 1100;
+		if (microvolts < 2500000 || microvolts > 5000000)
+			ret = -ENODATA;
+		else
+			value->intval = microvolts;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+out:
+	mutex_unlock(&axp->lock);
+	return ret;
+}
+
+static int gkd_axp173_usb_get_property(struct power_supply *psy,
+		enum power_supply_property property,
+		union power_supply_propval *value)
+{
+	struct gkd_axp173 *axp = power_supply_get_drvdata(psy);
+	u8 status;
+	int ret;
+
+	if (property != POWER_SUPPLY_PROP_ONLINE)
+		return -EINVAL;
+	mutex_lock(&axp->lock);
+	if (axp->telemetry_suspended)
+		ret = -EAGAIN;
+	else {
+		ret = gkd_axp173_read_byte(axp, AXP173_CHARGE_STATUS, &status);
+		if (!ret)
+			value->intval = !!(status & AXP173_STATUS_USB_VALID);
+	}
+	mutex_unlock(&axp->lock);
+	return ret;
+}
+
+static enum power_supply_property gkd_axp173_battery_properties[] = {
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+};
+static enum power_supply_property gkd_axp173_usb_properties[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+};
+static const struct power_supply_desc gkd_axp173_battery_desc = {
+	.name = "battery", .type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = gkd_axp173_battery_properties,
+	.num_properties = ARRAY_SIZE(gkd_axp173_battery_properties),
+	.get_property = gkd_axp173_battery_get_property,
+};
+static const struct power_supply_desc gkd_axp173_usb_desc = {
+	.name = "usb", .type = POWER_SUPPLY_TYPE_USB,
+	.properties = gkd_axp173_usb_properties,
+	.num_properties = ARRAY_SIZE(gkd_axp173_usb_properties),
+	.get_property = gkd_axp173_usb_get_property,
+};
+
+static int gkd_axp173_register_supplies(struct gkd_axp173 *axp)
+{
+	struct power_supply_config config = {
+		.drv_data = axp,
+		.of_node = axp->client->dev.of_node,
+	};
+
+	axp->battery = devm_power_supply_register(&axp->client->dev,
+			&gkd_axp173_battery_desc, &config);
+	if (IS_ERR(axp->battery))
+		return PTR_ERR(axp->battery);
+	axp->usb = devm_power_supply_register(&axp->client->dev,
+			&gkd_axp173_usb_desc, &config);
+	return IS_ERR(axp->usb) ? PTR_ERR(axp->usb) : 0;
+}
