+static int gkd_ui_plane_get_caps(unsigned long arg)
+{
+	const struct gkd_ui_plane_caps caps = {
+		.abi = GKD_UI_PLANE_ABI, .x = GKD_UI_PLANE_X,
+		.y = GKD_UI_PLANE_Y, .width = GKD_UI_PLANE_WIDTH,
+		.height = GKD_UI_PLANE_HEIGHT, .format = GKD_UI_PLANE_ARGB8888,
+		.max_ttl_ms = GKD_UI_PLANE_MAX_TTL_MS,
+		.max_fade_ms = GKD_UI_PLANE_MAX_FADE_MS,
+	};
+
+	return copy_to_user((void __user *)arg, &caps, sizeof(caps)) ? -EFAULT : 0;
+}
+
+static int gkd_ui_plane_submit_ioctl(struct x1830_fb *fb, unsigned long arg)
+{
+	struct gkd_ui_plane_submit submit;
+	struct pid *owner = task_tgid(current);
+	u32 *pixels;
+	bool renewing;
+	int ret = 0;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (copy_from_user(&submit, (void __user *)arg, sizeof(submit)))
+		return -EFAULT;
+	if (!submit.pixels || upper_32_bits(submit.pixels) ||
+	    submit.pixel_bytes != GKD_UI_PLANE_BYTES ||
+	    submit.ttl_ms < GKD_UI_PLANE_MIN_TTL_MS ||
+	    submit.ttl_ms > GKD_UI_PLANE_MAX_TTL_MS ||
+	    submit.fade_ms > GKD_UI_PLANE_MAX_FADE_MS ||
+	    !submit.sequence || submit.reserved[0] || submit.reserved[1])
+		return -EINVAL;
+	pixels = memdup_user(u64_to_user_ptr(submit.pixels), GKD_UI_PLANE_BYTES);
+	if (IS_ERR(pixels))
+		return PTR_ERR(pixels);
+
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+	renewing = x1830_user_plane_live_locked(fb);
+	if (renewing && fb->user_plane_owner != owner) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	if (renewing && submit.sequence <= fb->user_plane_sequence) {
+		ret = -ESTALE;
+		goto out_unlock;
+	}
+	if (!renewing) {
+		put_pid(fb->user_plane_owner);
+		fb->user_plane_owner = get_pid(owner);
+		fb->user_plane_started = jiffies;
+		fb->user_plane_fade_done = false;
+	}
+	memcpy(fb->user_plane_virt, pixels, GKD_UI_PLANE_BYTES);
+	fb->user_plane_sequence = submit.sequence;
+	fb->user_plane_ttl_ms = submit.ttl_ms;
+	fb->user_plane_fade_ms = submit.fade_ms;
+	fb->user_plane_expires = jiffies + msecs_to_jiffies(submit.ttl_ms);
+	fb->user_plane_active = true;
+	dma_wmb();
+	if (fb->composite_active)
+		mod_delayed_work(system_highpri_wq, &fb->composite_work, 0);
+	else
+		x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+out_unlock:
+	mutex_unlock(&fb->volume_osd_lock);
+	kfree(pixels);
+	return ret;
+}
+
+static int gkd_ui_plane_clear_ioctl(struct x1830_fb *fb)
+{
+	int ret = 0;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing)
+		ret = -ENODEV;
+	else if (x1830_user_plane_live_locked(fb) &&
+		 fb->user_plane_owner != task_tgid(current))
+		ret = -EBUSY;
+	else {
+		x1830_user_plane_release_locked(fb);
+		x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+	}
+	mutex_unlock(&fb->volume_osd_lock);
+	return ret;
+}
