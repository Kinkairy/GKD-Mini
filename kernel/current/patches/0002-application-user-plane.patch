+static void x1830_user_plane_blend_locked(struct x1830_fb *fb, u16 *target)
+{
+	unsigned long now = jiffies;
+	unsigned elapsed_ms, remaining_ms, opacity = 0;
+	unsigned int row, column;
+
+	if (!x1830_user_plane_live_locked(fb))
+		return;
+	if (!fb->user_plane_fade_done &&
+	    time_after_eq(now, fb->user_plane_started +
+			  msecs_to_jiffies(fb->user_plane_fade_ms)))
+		fb->user_plane_fade_done = true;
+	elapsed_ms = !fb->user_plane_fade_done ?
+		jiffies_to_msecs(now - fb->user_plane_started) :
+		fb->user_plane_fade_ms;
+	remaining_ms = jiffies_to_msecs(fb->user_plane_expires - now);
+	if (gkd_ui_fade_value(elapsed_ms, remaining_ms,
+			      fb->user_plane_fade_ms, &opacity))
+		return;
+	for (row = 0; row < GKD_UI_PLANE_HEIGHT; ++row)
+		for (column = 0; column < GKD_UI_PLANE_WIDTH; ++column) {
+			u32 top = fb->user_plane_virt[row * GKD_UI_PLANE_WIDTH + column];
+			u16 *base = &target[(GKD_UI_PLANE_Y + row) * X1830_FB_XRES +
+					   GKD_UI_PLANE_X + column];
+			u16 color = (u16)((((top >> 16) & 0xffU) >> 3) << 11 |
+					  (((top >> 8) & 0xffU) >> 2) << 5 |
+					  ((top & 0xffU) >> 3));
+			u16 composed = gkd_ui_blend565_value(*base, color, top >> 24);
+
+			*base = gkd_ui_blend565_value(*base, composed, opacity);
+		}
+}
