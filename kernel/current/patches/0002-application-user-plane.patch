+	pixels = NULL;
+	fb->user_menu_sequence = submit.sequence;
+	fb->user_menu_transition_ms = submit.transition_ms;
+	fb->user_menu_from_rows = rows;
+	fb->user_menu_animation_ms = (submit.transition_ms *
+		(GKD_UI_MENU_HEIGHT - rows) + GKD_UI_MENU_HEIGHT - 1U) /
+		GKD_UI_MENU_HEIGHT;
+	fb->user_menu_started = jiffies;
+	fb->user_menu_closing = false;
+	fb->user_menu_expires = jiffies + msecs_to_jiffies(submit.ttl_ms);
+	if (fb->composite_active)
+		mod_delayed_work(system_highpri_wq, &fb->composite_work, 0);
+	else
+		x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+out_unlock:
+	mutex_unlock(&fb->volume_osd_lock);
+	kvfree(pixels);
+	return ret;
+}
+
+static int gkd_ui_menu_clear_ioctl(struct x1830_fb *fb)
+{
+	int ret = 0;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing)
+		ret = -ENODEV;
+	else if (x1830_user_menu_live_locked(fb) &&
+		 fb->user_menu_owner != task_tgid(current))
+		ret = -EBUSY;
+	else {
+		x1830_user_menu_release_locked(fb);
+		x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+	}
+	mutex_unlock(&fb->volume_osd_lock);
+	return ret;
+}
+
+static int gkd_ui_menu_hide_ioctl(struct x1830_fb *fb)
+{
+	unsigned rows, remaining;
+	unsigned long expires, now;
+	int ret = 0;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	mutex_lock(&fb->volume_osd_lock);
+	if (fb->volume_osd_removing) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (x1830_user_menu_live_locked(fb)) {
+		if (fb->user_menu_owner != task_tgid(current)) {
+			ret = -EBUSY;
+			goto out;
+		}
+		if (!fb->user_menu_closing) {
+			rows = x1830_user_menu_rows_locked(fb);
+			now = jiffies;
+			if (!rows || !fb->user_menu_transition_ms ||
+			    !time_before(now, fb->user_menu_expires))
+				x1830_user_menu_release_locked(fb);
+			else {
+				fb->user_menu_from_rows = rows;
+				fb->user_menu_animation_ms =
+					(fb->user_menu_transition_ms * rows +
+					 GKD_UI_MENU_HEIGHT - 1U) / GKD_UI_MENU_HEIGHT;
+				/* The tick can advance after rows() sampled it. Fit the
+				 * whole close into the lease remaining at this one start. */
+				remaining = jiffies_to_msecs(fb->user_menu_expires - now);
+				if (fb->user_menu_animation_ms > remaining)
+					fb->user_menu_animation_ms = remaining;
+				fb->user_menu_started = now;
+				fb->user_menu_closing = true;
+				expires = now + msecs_to_jiffies(fb->user_menu_animation_ms);
+				if (time_before(expires, fb->user_menu_expires))
+					fb->user_menu_expires = expires;
+			}
+		}
+	}
+	x1830_hardware_osd_reassert_locked(fb, fb->latest_scanout_addr);
+out:
+	mutex_unlock(&fb->volume_osd_lock);
+	return ret;
+}
+
+static int x1830_fb_ioctl(struct fb_info *info, unsigned int cmd,
+			   unsigned long arg)
+{
+	struct x1830_fb *fb = info->par;
+
+	switch (cmd) {
+	case GKD_UI_MENU_GET_CAPS: return gkd_ui_menu_get_caps(arg);
+	case GKD_UI_MENU_SUBMIT: return gkd_ui_menu_submit_ioctl(fb, arg);
+	case GKD_UI_MENU_CLEAR: return gkd_ui_menu_clear_ioctl(fb);
+	case GKD_UI_MENU_HIDE: return gkd_ui_menu_hide_ioctl(fb);
+	case GKD_UI_PLANE_GET_CAPS: return gkd_ui_plane_get_caps(arg);
+	case GKD_UI_PLANE_SUBMIT: return gkd_ui_plane_submit_ioctl(fb, arg);
+	case GKD_UI_PLANE_CLEAR: return gkd_ui_plane_clear_ioctl(fb);
+	default: return -ENOTTY;
+	}
+}
