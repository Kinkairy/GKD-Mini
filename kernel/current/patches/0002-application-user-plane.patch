+static void x1830_user_menu_release_locked(struct x1830_fb *fb)
+{
+	kvfree(fb->user_menu_virt);
+	fb->user_menu_virt = NULL;
+	put_pid(fb->user_menu_owner);
+	fb->user_menu_owner = NULL;
+	fb->user_menu_sequence = 0;
+	fb->user_menu_expires = 0;
+	fb->user_menu_started = 0;
+	fb->user_menu_transition_ms = 0;
+	fb->user_menu_animation_ms = 0;
+	fb->user_menu_from_rows = 0;
+	fb->user_menu_closing = false;
+}
+
+static bool x1830_user_menu_live_locked(struct x1830_fb *fb)
+{
+	if (!fb->user_menu_owner)
+		return false;
+	if (time_before(jiffies, fb->user_menu_expires))
+		return true;
+	x1830_user_menu_release_locked(fb);
+	return false;
+}
+
+static unsigned x1830_user_menu_rows_locked(struct x1830_fb *fb)
+{
+	unsigned elapsed, remaining, span, rows, exit_rows;
+	unsigned long now = jiffies;
+
+	if (!fb->user_menu_owner)
+		return 0;
+	if (!time_before(now, fb->user_menu_expires)) {
+		x1830_user_menu_release_locked(fb);
+		return 0;
+	}
+	elapsed = jiffies_to_msecs(now - fb->user_menu_started);
+	remaining = jiffies_to_msecs(fb->user_menu_expires - now);
+	span = fb->user_menu_animation_ms;
+	if (!span || elapsed >= span)
+		rows = fb->user_menu_closing ? 0 : GKD_UI_MENU_HEIGHT;
+	else if (fb->user_menu_closing)
+		rows = fb->user_menu_from_rows * (span - elapsed) / span;
+	else
+		rows = fb->user_menu_from_rows +
+			(GKD_UI_MENU_HEIGHT - fb->user_menu_from_rows) * elapsed / span;
+	/* An expired publisher still exits within its original bounded lease. */
+	if (!fb->user_menu_closing && fb->user_menu_transition_ms &&
+	    remaining < fb->user_menu_transition_ms) {
+		exit_rows = GKD_UI_MENU_HEIGHT * remaining / fb->user_menu_transition_ms;
+		if (exit_rows < rows)
+			rows = exit_rows;
+	}
+	return rows;
+}
+
+static void x1830_user_plane_release_locked(struct x1830_fb *fb)
+{
+	put_pid(fb->user_plane_owner);
+	fb->user_plane_owner = NULL;
+	fb->user_plane_sequence = 0;
+	fb->user_plane_started = 0;
+	fb->user_plane_expires = 0;
+	fb->user_plane_ttl_ms = 0;
+	fb->user_plane_fade_ms = 0;
+	fb->user_plane_active = false;
+	fb->user_plane_fade_done = false;
+	memset(fb->user_plane_virt, 0, GKD_UI_PLANE_BYTES);
+}
+
+static bool x1830_user_plane_live_locked(struct x1830_fb *fb)
+{
+	if (!fb->user_plane_active)
+		return false;
+	if (time_before(jiffies, fb->user_plane_expires))
+		return true;
+	x1830_user_plane_release_locked(fb);
+	return false;
+}
